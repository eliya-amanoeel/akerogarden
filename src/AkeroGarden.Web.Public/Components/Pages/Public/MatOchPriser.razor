@page "/mat-och-priser"
@layout MainLayout
@using System.Globalization
@using AkeroGarden.Web.Core.Data.Entities
@inject MealOptionService MealOptionService
@inject PriceRuleService PriceRuleService
@inject CleaningZoneService CleaningZoneService

<PageTitle>Mat &amp; priser — Åkerögården</PageTitle>
<SeoMeta Title="Mat och priser"
         Description="Måltider, helpension och självhushåll, samt vad en vistelse på Åkerögården kostar."
         Path="/mat-och-priser" />

<section class="page-head">
    <div class="container">
        <span class="eyebrow">Mat &amp; priser</span>
        <h1>Vad ni får — och vad det kostar</h1>
        <div class="page-head__rule"></div>
        <p class="page-head__intro">Helpension med hemlagad mat, eller självhushåll. Priserna anges inklusive moms.</p>
    </div>
</section>

<!-- Meny -->
<section class="section">
    <div class="container">
        <div class="teaser">
            @* The dining hall, not a dish: the client's photo set has no food photography. A plated-meal
               photo would say "hemlagat" better — swap it in here if one arrives. `sizes` is the drawn
               width, as on the home page's teaser: 24rem tall from 64em, covered at 576px. *@
            <div class="teaser__photo">
                <img src="@Assets["images/mat-och-priser-menyn-1400.webp"]"
                     srcset="@Assets["images/mat-och-priser-menyn-800.webp"] 800w, @Assets["images/mat-och-priser-menyn-1400.webp"] 1400w, @Assets["images/mat-och-priser-menyn-2000.webp"] 2000w"
                     sizes="(min-width: 64em) 576px, 100vw"
                     width="1400" height="935"
                     loading="lazy"
                     alt="Matsalen med dukade bord och en brasa i den öppna spisen" />
            </div>
            <div>
                <span class="eyebrow">Menyn</span>
                <h2>Hemlagat, med plats för önskemål</h2>
                <p>Hemlagade luncher och middagar, serverade i vår matsal — med plats för specialkost och allergier.</p>
            </div>
        </div>

        <div class="menu-body">
            @if (meals.Count == 0)
            {
                <p>Ingen meny finns för närvarande.</p>
            }
            else
            {
                <div class="menu-cols">
                    <div class="menu-col">
                        <h2>Lunch</h2>
                        @RenderMeals(MealType.Lunch)
                    </div>
                    <div class="menu-col">
                        <h2>Middag</h2>
                        @RenderMeals(MealType.Dinner)
                    </div>
                </div>
                <p class="menu-note">
                    Menyn varierar efter säsong och sällskapets önskemål. Specialkost och allergier
                    ordnas alltid — berätta i förfrågan.
                </p>
            }
        </div>
    </div>
</section>

<!-- Priser -->
<section class="section section--warm">
    <div class="container">
        <span class="eyebrow">Priser</span>

        <div class="price-block">
            <h2 class="subhead">Prislista</h2>
            <p class="price-note">Priserna anges inklusive moms. Beloppet utan moms står under varje pris.</p>
            <p class="price-note">Sänglinne och handdukar ingår inte — ta med eget.</p>
            @if (priceRules.Count == 0)
            {
                <p>Inga priser finns för närvarande.</p>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Post</th>
                                <th class="num">Pris inkl. moms</th>
                                <th class="num">Moms</th>
                                <th>Enhet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in priceRules)
                            {
                                <tr>
                                    <td>
                                        <span class="data-table__label">@rule.Label</span>
                                        @if (rule.SeasonStart is not null && rule.SeasonEnd is not null)
                                        {
                                            <span class="data-table__season"> (@rule.SeasonStart.Value.ToString("d MMM", Sv)–@rule.SeasonEnd.Value.ToString("d MMM", Sv))</span>
                                        }
                                        @if (!string.IsNullOrEmpty(rule.Notes))
                                        {
                                            <span class="data-table__sub">@rule.Notes</span>
                                        }
                                    </td>
                                    <td class="num">
                                        @Amount(InclVat(rule.AmountExVat, rule.VatRate))
                                        <span class="data-table__sub">@Amount(rule.AmountExVat) exkl. moms</span>
                                    </td>
                                    <td class="num">@Vat(rule.VatRate)</td>
                                    <td>@rule.Unit</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="price-block">
            <h2 class="subhead">Städning</h2>
            @if (cleaningZones.Count == 0)
            {
                <p>Inga städalternativ finns för närvarande.</p>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Städzon</th>
                                <th class="num">Pris inkl. moms</th>
                                <th class="num">Moms</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var zone in cleaningZones)
                            {
                                <tr>
                                    <td>
                                        <span class="data-table__label">@zone.Name</span>
                                        @if (!string.IsNullOrEmpty(zone.Description))
                                        {
                                            <span class="data-table__sub">@zone.Description</span>
                                        }
                                    </td>
                                    <td class="num">
                                        @Amount(InclVat(zone.AmountExVat, zone.VatRate))
                                        <span class="data-table__sub">@Amount(zone.AmountExVat) exkl. moms</span>
                                    </td>
                                    <td class="num">@Vat(zone.VatRate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="utility__actions utility__actions--start">
            <a href="/boka" class="btn">Skicka förfrågan</a>
            <span class="cta-note">En förfrågan är inte bindande.</span>
        </div>
    </div>
</section>

@code {
    private static readonly CultureInfo Sv = CultureInfo.GetCultureInfo("sv-SE");

    private List<MealOption> meals = [];
    private List<PriceRule> priceRules = [];
    private List<CleaningZone> cleaningZones = [];

    protected override async Task OnInitializedAsync()
    {
        meals = await MealOptionService.GetActiveAsync();
        priceRules = await PriceRuleService.GetActiveAsync();
        cleaningZones = await CleaningZoneService.GetActiveAsync();
    }

    private RenderFragment RenderMeals(MealType mealType) => __builder =>
    {
        var options = meals.Where(o => o.MealType == mealType).ToList();
        if (options.Count == 0)
        {
            <p class="dish"><span class="dish__top">Inga alternativ för närvarande.</span></p>
        }
        else
        {
            foreach (var meal in options)
            {
                <div class="dish">
                    <div class="dish__top">
                        <h3>@meal.Name</h3>
                        @if (meal.IsVegetarian)
                        {
                            <span class="meal-veg">Vegetariskt</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(meal.Description))
                    {
                        <p>@meal.Description</p>
                    }
                </div>
            }
        }
    };

    // Private individuals book as consumers (the client's terms §1/§31), and a price aimed at a
    // consumer must be the price they pay, VAT included (prisinformationslagen 2004:347) — so the
    // VAT-inclusive figure leads and the entered ex-VAT amount stays beside it for organisations.
    // Computed per item for display only and never stored. C8 forbids computing a booking's price
    // from these lists, not this: there is no booking and no sum here, only one reference price at
    // a time. (A booking's price is entered by the admin — §5.6.)
    private static decimal InclVat(decimal amountExVat, decimal vatRate) =>
        Math.Round(amountExVat * (1 + vatRate), 2, MidpointRounding.AwayFromZero);

    private static string Amount(decimal amount) => $"{amount.ToString("0.##", Sv)} kr";

    private static string Vat(decimal vatRate) => $"{(vatRate * 100).ToString("0.##", Sv)} %";
}
