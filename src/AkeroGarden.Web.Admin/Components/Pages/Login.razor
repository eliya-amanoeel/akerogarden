@page "/login"
@layout AdminLoginLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav
@inject LoginAttemptLimiter Limiter

<PageTitle>Logga in — Åkerögården Admin</PageTitle>

<div class="login-card">
    <div class="login-card__logo">
        <Logo Variant="LogoVariant.Stacked" />
    </div>

    <h1>Logga in</h1>
    <p class="login-sub">Åkerögården Admin</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="form-error">@_error</p>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLogin" FormName="login" method="post">
        <DataAnnotationsValidator />

        @* The form posts to /login with no query string, so the destination has to survive the POST
           as a field. It is re-validated with LocalUrl.IsSafe after sign-in — a value arriving here
           is attacker-controllable and is never trusted just because it round-tripped. *@
        <input type="hidden" name="PostedReturnUrl" value="@(ReturnUrl ?? PostedReturnUrl)" />

        <div class="form-group">
            <label for="email">E-postadress</label>
            <InputText id="email" @bind-Value="_model!.Email" type="email" autocomplete="username" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        <div class="form-group">
            <label for="password">Lösenord</label>
            <InputText id="password" @bind-Value="_model.Password" type="password" autocomplete="current-password" />
            <ValidationMessage For="() => _model.Password" />
        </div>

        <div class="form-group form-group--checkbox">
            <label>
                <InputCheckbox @bind-Value="_model.RememberMe" />
                Kom ihåg mig i 30 dagar
            </label>
        </div>

        <button type="submit" class="btn">Logga in</button>
    </EditForm>

    <p class="login-alt"><a href="/glomt-losenord">Glömt lösenordet?</a></p>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel? _model { get; set; }

    // Where the auth cookie bounced this request from (post-launch security review, finding #21).
    // Preserved across the POST by the hidden field in the form below, because the form action carries
    // no query string. Validated against LocalUrl.IsSafe before it is ever navigated to.
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private string? PostedReturnUrl { get; set; }

    private string? _error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _model ??= new();
        await HttpContext.SignOutAsync(IdentityConstants.ApplicationScheme);

        // SignOutAsync only queues the cookie deletion on the response — it leaves HttpContext.User
        // as the signed-in principal for the rest of this render. The antiforgery token in the form
        // below is bound to whoever HttpContext.User is, so without this line an already-signed-in
        // admin visiting /login gets a token stamped with their identity, then posts it as an
        // anonymous request (their cookie is gone by then) and the submit is rejected with "A valid
        // antiforgery token was not provided". Drop the identity here so the token matches the
        // request that will carry it. Found by the Samordnare E2E, which is the first test to reach
        // /login while logged in — the switch-accounts path a real admin takes.
        HttpContext.User = new ClaimsPrincipal(new ClaimsIdentity());
    }

    private async Task HandleLogin()
    {
        // Per-IP throttle (post-launch security review, finding #8). Identity's lockout is per ACCOUNT,
        // which does nothing against password spraying across many accounts and lets an attacker lock a
        // named admin out at will. This bounds attempts from one source regardless of which account is
        // targeted. Deliberately looser than the lockout so a shared office IP is not a problem.
        if (!Limiter.TryLogin(ClientId()))
        {
            _error = "För många inloggningsförsök. Försök igen om en stund.";
            return;
        }

        var user = await SignInManager.UserManager.FindByEmailAsync(_model!.Email);

        // The deactivated-account message is withheld until the PASSWORD has been verified (finding
        // #8). It used to be returned on the email alone, which let an unauthenticated caller discover
        // which addresses exist and are deactivated — and did so before any lockout counting, so it was
        // not even rate-limited by Identity. Revealing it to someone who already proved they know the
        // password gives away nothing, and keeps the message useful for the admin it is meant for.
        // CheckPasswordSignInAsync verifies and counts the failure without issuing the cookie.
        var check = user is null
            ? Microsoft.AspNetCore.Identity.SignInResult.Failed
            : await SignInManager.CheckPasswordSignInAsync(user, _model.Password, lockoutOnFailure: true);

        if (check.Succeeded && user is { IsActive: false })
        {
            _error = "Det här kontot är inaktiverat.";
            return;
        }

        // Credentials are good and the account is active — now establish the auth cookie.
        var result = check.Succeeded
            ? await SignInUserAsync(user!, _model.RememberMe)
            : check;

        if (result.Succeeded)
        {
            // Role-aware landing (FR-104): "/" is the dashboard, which Samordnare must not see.
            // The cookie has just been issued but this request's principal is still anonymous, so
            // ask the user store for the roles and apply the shared rule to them.
            var users = SignInManager.UserManager;
            var landing = AdminRoles.LandingPath(
                isAdministrator: user is not null && await users.IsInRoleAsync(user, AdminRoles.Administrator),
                isCoordinator: user is not null && await users.IsInRoleAsync(user, AdminRoles.Coordinator));

            // Return to where the admin was actually headed, when that is a path on this site (FR-104
            // landing stays the fallback). A Samordnare sent to an Administratör-only deep link lands on
            // /ingen-behorighet, which is the correct answer — the permission boundary, not a silent
            // detour to a page they did not ask for.
            var requested = ReturnUrl ?? PostedReturnUrl;
            Nav.NavigateTo(LocalUrl.IsSafe(requested) ? requested! : landing);
            return;
        }

        _error = result.IsLockedOut
            ? "Kontot är tillfälligt låst på grund av för många felaktiga försök."
            : "Felaktig e-postadress eller lösenord.";
    }

    /// <summary>Issues the auth cookie for an already password-verified, active user. Split out so the
    /// verify step (which must not sign anyone in) stays separate from the sign-in step.</summary>
    private async Task<Microsoft.AspNetCore.Identity.SignInResult> SignInUserAsync(
        ApplicationUser user, bool isPersistent)
    {
        await SignInManager.SignInAsync(user, isPersistent);
        return Microsoft.AspNetCore.Identity.SignInResult.Success;
    }

    /// <summary>The throttle key. Real client IP, via ForwardedHeaders (NFR-04) — App Service
    /// terminates TLS, so without that middleware every request would look like the load balancer and
    /// the whole site would share one bucket.</summary>
    private string ClientId() =>
        HttpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-postadress krävs.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Ange en giltig e-postadress.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Lösenord krävs.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
