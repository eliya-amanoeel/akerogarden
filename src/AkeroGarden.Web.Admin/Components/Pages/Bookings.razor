@page "/bokningar"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Core.Data.Entities
@using AkeroGarden.Web.Core.Services
@inject BookingService BookingService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TimeProvider Clock
@attribute [Authorize(Roles = AdminRoles.Administrator)]

<PageTitle>Bokningar — Åkerögården Admin</PageTitle>

<AdminHeader Title="Bokningar">
    <a class="btn" href="/bokningar/ny">+ Skapa bokning</a>
</AdminHeader>

<p class="form-hint">Alla förfrågningar och bokningar. Filtrera på status, typ och datum, eller sök på referensnummer.</p>

@* Inert until the list has taken its state from the address (OnInitializedAsync). On the live
   circuit that waits on the browser, and a filter changed in the meantime was overwritten when
   the address was applied — one state, two writers (E2E, 2026-11-19). Prerendering finishes
   before any HTML is sent, so the served page never shows them disabled. *@
<div class="admin-filters">
    <div class="form-group">
        <label for="f-status">Status</label>
        <select id="f-status" disabled="@(!_ready)" @bind="_status" @bind:after="Load">
            <option value="">Alla</option>
            @foreach (var s in Enum.GetValues<BookingStatus>())
            {
                <option value="@s">@BookingDisplay.StatusLabel(s)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="f-type">Typ</label>
        <select id="f-type" disabled="@(!_ready)" @bind="_type" @bind:after="Load">
            <option value="">Alla</option>
            @foreach (var t in Enum.GetValues<BookingType>())
            {
                <option value="@t">@BookingDisplay.TypeLabel(t)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="f-from">Incheckning fr.o.m.</label>
        <input id="f-from" type="date" disabled="@(!_ready)" @bind="_from" @bind:after="Load" />
    </div>
    <div class="form-group">
        <label for="f-to">Incheckning t.o.m.</label>
        <input id="f-to" type="date" disabled="@(!_ready)" @bind="_to" @bind:after="Load" />
    </div>
    <div class="form-group">
        <label for="f-ref">Referensnummer</label>
        <input id="f-ref" type="search" placeholder="t.ex. AG-2026-0042" disabled="@(!_ready)" @bind="_reference" @bind:after="Load" />
    </div>
    @* The browser's date field has no clear button, so a chosen date could only be removed by
       deleting it part by part. Shown only while a filter is active (same on /jobbhistorik). *@
    @if (HasFilters)
    {
        <button type="button" class="btn-ghost btn-sm" disabled="@(!_ready)" @onclick="ClearFilters">Återställ filter</button>
    }
</div>

@if (_bookings is null)
{
    <p class="admin-empty">Laddar…</p>
}
else if (_bookings.Count == 0)
{
    <p class="admin-empty">Inga bokningar matchar filtret.</p>
}
else
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Referens</th>
                    <th>Inkommen</th>
                    <th>Sällskap</th>
                    <th>Typ</th>
                    <th>Datum</th>
                    <th class="num">Gäster</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in _bookings)
                {
                    <tr>
                        <td class="mono">@b.BookingReference</td>
                        <td class="mono">@StockholmTime.DateOf(b.CreatedAt).ToString("yyyy-MM-dd")</td>
                        <td>
                            <a class="rowlink" href="/bokningar/@b.Id">@b.ContactName</a>
                            @* FR-112: on an on-behalf-of booking this is the ADMIN's address, not
                               the guest's. Unmarked in a list it reads as data entered wrongly. *@
                            <span class="sub">@b.ContactEmail@(b.OnBehalfOfAdminId is null ? "" : " · via admin")</span>
                        </td>
                        <td>@BookingDisplay.TypeLabel(b.BookingType)</td>
                        <td class="mono">
                            @if (b.CheckIn is not null && b.CheckOut is not null)
                            {
                                @($"{b.CheckIn:yyyy-MM-dd} – {b.CheckOut:yyyy-MM-dd}")
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="num mono">@(b.OvernightGuestCount?.ToString() ?? "—")</td>
                        <td><span class="@BookingDisplay.StatusBadgeClass(b, _today)">@BookingDisplay.StatusLabel(b, _today)</span></td>
                        <td class="rowactions"><a class="btn-ghost" href="/bokningar/@b.Id">Öppna →</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-cards">
        @foreach (var b in _bookings)
        {
            <AdminDataCard Title="@b.ContactName" OnClick="() => GoToBooking(b.Id)">
                <Badge><span class="@BookingDisplay.StatusBadgeClass(b, _today)">@BookingDisplay.StatusLabel(b, _today)</span></Badge>
                <Sub>@b.ContactEmail@(b.OnBehalfOfAdminId is null ? "" : " · via admin")</Sub>
                <Fields>
                    <div><dt>Referens</dt><dd>@b.BookingReference</dd></div>
                    <div><dt>Typ</dt><dd>@BookingDisplay.TypeLabel(b.BookingType)</dd></div>
                    <div>
                        <dt>Datum</dt>
                        <dd>
                            @if (b.CheckIn is not null && b.CheckOut is not null)
                            {
                                @($"{b.CheckIn:yyyy-MM-dd} – {b.CheckOut:yyyy-MM-dd}")
                            }
                            else
                            {
                                @:—
                            }
                        </dd>
                    </div>
                    <div><dt>Gäster</dt><dd>@(b.OvernightGuestCount?.ToString() ?? "—")</dd></div>
                    <div><dt>Inkommen</dt><dd>@StockholmTime.DateOf(b.CreatedAt).ToString("yyyy-MM-dd")</dd></div>
                </Fields>
            </AdminDataCard>
        }
    </div>
    <AdminPager Page="_page" TotalPages="_totalPages" OnPageChanged="GoToPage" />
}

@code {
    private List<Booking>? _bookings;
    private readonly OneAtATime _loads = new();
    private bool _ready;
    private int _page = 1;
    private int _totalPages = 1;
    private string _status = "";
    private string _type = "";
    private DateOnly? _from;
    private DateOnly? _to;
    private string _reference = "";
    private DateOnly _today;

    // Arriving — from the menu, a reload, or Back from a booking — the list is what the address
    // says (ListAddress). The page and filters only, never the reference search (NFR-05).
    protected override Task OnInitializedAsync() => _loads.RunAsync(async () =>
    {
        var address = await ListAddress.ReadAsync(JS, Nav, RendererInfo.IsInteractive);
        _status = address.EnumName<BookingStatus>("status");
        _type = address.EnumName<BookingType>("typ");
        _from = address.Date("fran");
        _to = address.Date("till");
        await FetchAsync(address.Page);
        _ready = true;
    });

    private void GoToBooking(Guid id) => Nav.NavigateTo($"/bokningar/{id}");

    private bool HasFilters =>
        _status != "" || _type != "" || _from is not null || _to is not null || !string.IsNullOrWhiteSpace(_reference);

    private Task ClearFilters()
    {
        _status = "";
        _type = "";
        _from = null;
        _to = null;
        _reference = "";
        return Load();
    }

    // A changed filter starts again from the first page; the service keeps any page inside the
    // pages that exist (same as /jobbhistorik).
    private Task Load() => GoToPage(1);

    private async Task GoToPage(int page)
    {
        await _loads.RunAsync(() => FetchAsync(page));
        await ListAddress.ReplaceAsync(JS, Nav, _page,
            ("status", _status), ("typ", _type), ("fran", ListAddress.Date(_from)), ("till", ListAddress.Date(_to)));
    }

    private async Task FetchAsync(int page)
    {
        BookingStatus? status = Enum.TryParse<BookingStatus>(_status, out var s) ? s : null;
        BookingType? type = Enum.TryParse<BookingType>(_type, out var t) ? t : null;
        _today = StockholmTime.Today(Clock);
        var bookings = await BookingService.GetBookingsPageAsync(status, type, _from, _to, _reference, page);
        _bookings = [.. bookings.Items];
        _page = bookings.Page;
        _totalPages = bookings.TotalPages;
    }
}
