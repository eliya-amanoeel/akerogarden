@page "/bokningar/{Id:guid}"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Core.Data.Entities
@using AkeroGarden.Web.Core.Models
@using AkeroGarden.Web.Core.Services
@inject BookingService BookingService
@inject MealOptionService MealOptionService
@attribute [Authorize(Roles = AdminRoles.Administrator)]

<PageTitle>Bokning — Åkerögården Admin</PageTitle>

@if (_booking is null)
{
    <AdminHeader>
        <TitleContent><span class="crumb"><a href="/bokningar">Bokningar</a></span></TitleContent>
    </AdminHeader>
    <p class="admin-empty">@(_loaded ? "Bokningen kunde inte hittas." : "Laddar…")</p>
}
else
{
    <AdminHeader>
        <TitleContent><span class="crumb"><a href="/bokningar">Bokningar</a> / @_booking.BookingReference</span></TitleContent>
    </AdminHeader>

    <div class="admin-detail-head">
        <h1>@_booking.ContactName</h1>
        <span class="chip mono">@_booking.BookingReference</span>
        <span class="@BookingDisplay.StatusBadgeClass(_booking.Status)">@BookingDisplay.StatusLabel(_booking.Status)</span>
        <span class="chip">@BookingDisplay.TypeLabel(_booking.BookingType)</span>
    </div>

    <Toast @bind-Message="_message" />

    <div class="detail-grid">
        <div>
            @* ── Contact ─────────────────────────────────────────────── *@
            <details class="detail-acc" open>
                <summary class="detail-acc__head">
                    <h2 class="detail-acc__title">Kontaktuppgifter</h2>
                    <span class="detail-acc__meta">@_booking.ContactEmail</span>
                    <span class="detail-acc__chev" aria-hidden="true">▾</span>
                </summary>
                <div class="detail-acc__body">
                    <dl class="kv">
                        <dt>Namn</dt><dd>@_booking.ContactName</dd>
                        <dt>E-post</dt><dd>@_booking.ContactEmail</dd>
                        <dt>Telefon</dt><dd>@(_booking.ContactPhone ?? "—")</dd>
                        @if (_booking.IsOrganisation)
                        {
                            <dt>Organisation</dt><dd>@_booking.OrgName (@_booking.OrgNumber)</dd>
                            <dt>Fakturaadress</dt><dd>@_booking.InvoiceAddress</dd>
                        }
                    </dl>
                </div>
            </details>

            @if (_booking.BookingType == BookingType.StayRequest)
            {
                @* ── Stay ────────────────────────────────────────────── *@
                <details class="detail-acc" open>
                    <summary class="detail-acc__head">
                        <h2 class="detail-acc__title">Vistelse</h2>
                        <span class="detail-acc__meta">@(_booking.CheckIn?.ToString("yyyy-MM-dd") ?? "—") – @(_booking.CheckOut?.ToString("yyyy-MM-dd") ?? "—")</span>
                        <span class="detail-acc__chev" aria-hidden="true">▾</span>
                    </summary>
                    <div class="detail-acc__body">
                        @* The stated times (§2.8, FR-100) belong with the rest of the stay, and are
                           edited here rather than in a second place further down — showing a value
                           in one place and editing it in another is how the two drift apart. *@
                        <dl class="kv">
                            <dt>Incheckning</dt>
                            <dd>
                                @(_booking.CheckIn?.ToString("yyyy-MM-dd") ?? "—")
                                <span class="sub">kl. @StatedTimePolicy.Display(_booking.CheckInTime, MealOccasionResolver.StandardCheckInTime)</span>
                            </dd>
                            <dt>Utcheckning</dt>
                            <dd>
                                @(_booking.CheckOut?.ToString("yyyy-MM-dd") ?? "—")
                                <span class="sub">kl. @StatedTimePolicy.Display(_booking.CheckOutTime, MealOccasionResolver.StandardCheckOutTime)</span>
                            </dd>
                            <dt>Övernattande</dt><dd>@(_booking.OvernightGuestCount?.ToString() ?? "—")</dd>
                            <dt>Dagsgäster</dt><dd>@(_booking.DayGuestCount?.ToString() ?? "—")</dd>
                            <dt>Måltidsplan</dt><dd>@BookingDisplay.MealPlanLabel(_booking.MealPlan)</dd>
                        </dl>

                        @* No save button: every control on this page applies immediately, as the
                           building assignment below already does. A form with a Spara button is for
                           composing a new record (the reference-data pages); this is an in-place
                           adjustment to a booking that already exists. *@
                        @if (_booking.BookingType == BookingType.StayRequest)
                        {
                            @if (!_editingTimes)
                            {
                                <button type="button" class="edit-pencil" @onclick="() => _editingTimes = true">✎ Ändra tider</button>
                            }
                            else
                            {
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="edit-checkin-time">Incheckningstid</label>
                                        <select id="edit-checkin-time" @bind="_checkInTime" @bind:after="SaveTimes">
                                            @foreach (var t in StatedTimePolicy.Options())
                                            {
                                                <option value="@StatedTimePolicy.Display(t)">@StatedTimePolicy.Display(t)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="edit-checkout-time">Utcheckningstid</label>
                                        <select id="edit-checkout-time" @bind="_checkOutTime" @bind:after="SaveTimes">
                                            @foreach (var t in StatedTimePolicy.Options())
                                            {
                                                <option value="@StatedTimePolicy.Display(t)">@StatedTimePolicy.Display(t)</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <p class="form-hint">Gästens önskemål, inte ett åtagande — eventuellt tillägg kommer ni överens om utanför systemet.</p>
                                <button type="button" class="btn-outline btn-sm" @onclick="() => _editingTimes = false">Klar</button>
                            }
                        }

                        @if (_booking.FacilitySelections.Count > 0)
                        {
                            <h3>Faciliteter</h3>
                            <dl class="kv">
                                @foreach (var f in _booking.FacilitySelections)
                                {
                                    <dt>@f.FacilityNameSnapshot</dt><dd>@f.AmountExVatSnapshot.ToString("0.##") kr <span class="sub">exkl. moms</span></dd>
                                }
                            </dl>
                        }

                        @if (_booking.CleaningSelections.Count > 0)
                        {
                            <h3>Städning</h3>
                            <dl class="kv">
                                @foreach (var c in _booking.CleaningSelections)
                                {
                                    <dt>@c.ZoneNameSnapshot</dt><dd>@c.AmountExVatSnapshot.ToString("0.##") kr <span class="sub">exkl. moms</span></dd>
                                }
                            </dl>
                        }
                    </div>
                </details>

                @* Building assignment (FR-103, §8.16) — required before approval, editable for the
                   booking's life. Replaced the room-choice toggle when per-participant room
                   assignment was removed (FR-56 tombstoned). *@
                <details class="detail-acc" open>
                    <summary class="detail-acc__head">
                        <h2 class="detail-acc__title">Byggnadstilldelning</h2>
                        <span class="detail-acc__meta">@AssignmentSummary</span>
                        <span class="detail-acc__chev" aria-hidden="true">▾</span>
                    </summary>
                    <div class="detail-acc__body">
                        <p class="action-note">
                            Gruppen fördelar sig själv mellan rummen i de tilldelade byggnaderna.
                        </p>
                        <div class="assign-list">
                            @foreach (var b in _assignable)
                            {
                                <label class="assign-item @(b.IsAvailable ? "" : "assign-item--blocked")">
                                    <input type="checkbox"
                                           checked="@_selectedBuildingIds.Contains(b.Building.Id)"
                                           disabled="@(!b.IsAvailable)"
                                           @onchange="e => ToggleBuilding(b.Building.Id, e.Value is true)" />
                                    <span class="assign-item__name">@b.Building.Name</span>
                                    <span class="assign-item__meta">
                                        @if (b.IsAvailable)
                                        {
                                            @($"{b.AvailableBedCount} bäddar")
                                        }
                                        else
                                        {
                                            @:Blockerad under vistelsen
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                        @if (_assignmentError is not null)
                        {
                            <p class="form-error" role="alert">@_assignmentError</p>
                        }
                    </div>
                </details>
            }

            @* ── The group's meals (after submission — FR-48/105) ─────────
               Its own section, not a block inside "Deltagare": meals are a booking-level fact now.
               Every control saves on change — see the Vistelse note above for the rule. *@
            @if (_participantEdits.Count > 0 && _booking.MealPlan == MealPlan.FullBoardAll)
            {
                <details class="detail-acc">
                    <summary class="detail-acc__head">
                        <h2 class="detail-acc__title">Måltider</h2>
                        <span class="detail-acc__meta">@MealSummary</span>
                        <span class="detail-acc__chev" aria-hidden="true">▾</span>
                    </summary>
                    <div class="detail-acc__body">
                        <fieldset class="participant">
                            <legend>Vilka måltider gruppen äter</legend>

                            @* Only the arrival and departure day are a choice — a full day in the
                               middle always has all three meals (§4.1), so it has no checkboxes. *@
                            <div class="form-group">
                                <span class="label">Ankomstdag (@_booking.CheckIn?.ToString("yyyy-MM-dd"))</span>
                                @foreach (var meal in ArrivalMeals)
                                {
                                    <label class="form-check">
                                        <input type="checkbox" checked="@IsEdgeMealOn(meal)"
                                               @onchange="e => ToggleEdgeMeal(meal, (bool)(e.Value ?? false))" />
                                        @EdgeMealLabel(meal)
                                    </label>
                                }
                            </div>

                            <div class="form-group">
                                <span class="label">Avresedag (@_booking.CheckOut?.ToString("yyyy-MM-dd"))</span>
                                @foreach (var meal in DepartureMeals)
                                {
                                    <label class="form-check">
                                        <input type="checkbox" checked="@IsEdgeMealOn(meal)"
                                               @onchange="e => ToggleEdgeMeal(meal, (bool)(e.Value ?? false))" />
                                        @EdgeMealLabel(meal)
                                    </label>
                                }
                            </div>

                            @if (_participants.Any(p => p.ParticipantType == ParticipantType.DayGuest))
                            {
                                @* These do not decide whether a meal happens — only whether the day
                                   guests are counted for one that already does. Nothing is deleted. *@
                                <div class="form-group">
                                    <span class="label">Dagsgästernas måltider (gäller alla dagsgäster)</span>
                                    <label class="form-check"><input type="checkbox" @bind="_mealEdit.DayGuestBreakfast" @bind:after="SaveGroupMeals" /> Frukost</label>
                                    <label class="form-check"><input type="checkbox" @bind="_mealEdit.DayGuestLunch" @bind:after="SaveGroupMeals" /> Lunch</label>
                                    <label class="form-check"><input type="checkbox" @bind="_mealEdit.DayGuestDinner" @bind:after="SaveGroupMeals" /> Middag</label>
                                </div>
                            }
                        </fieldset>

                        @* One dropdown per meal the group is having — including one just added above
                           that has no dish yet. Rendering only the meals with a stored dish left a
                           newly-added one with no way to choose at all. *@
                        @if (_mealEdit.Meals.Count > 0)
                        {
                            <fieldset class="participant">
                                <legend>Gruppens rätter</legend>
                                @foreach (var mealEdit in _mealEdit.Meals)
                                {
                                    var options = mealEdit.MealType == MealType.Lunch ? _lunchOptions : _dinnerOptions;
                                    <div class="form-row">
                                        <label>@mealEdit.Date.ToString("yyyy-MM-dd") @(mealEdit.MealType == MealType.Lunch ? "lunch" : "middag")</label>
                                        <select @bind="mealEdit.MealOptionId" @bind:after="SaveGroupMeals">
                                            <option value="">– ej vald –</option>
                                            @foreach (var o in options)
                                            {
                                                <option value="@o.Id">@o.Name</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </fieldset>
                        }

                        <fieldset class="participant">
                            <legend>Specialkost (antal portioner)</legend>
                            <div class="form-row">
                                <label for="veg-count">Vegetariskt</label>
                                <input id="veg-count" type="number" min="0" @bind="_mealEdit.VegetarianCount" @bind:after="SaveGroupMeals" />
                            </div>
                            <div class="form-row">
                                <label for="vegan-count">Veganskt</label>
                                <input id="vegan-count" type="number" min="0" @bind="_mealEdit.VeganCount" @bind:after="SaveGroupMeals" />
                            </div>
                            <p class="form-hint">Antalet ingår i tillagningsantalen — så många portioner tillagas vegetariskt respektive veganskt, inte utöver.</p>
                        </fieldset>
                    </div>
                </details>
            }

            @* ── Participants (after submission — FR-48) ───────────────── *@
            @if (_participantEdits.Count > 0)
            {
                <details class="detail-acc" open>
                    <summary class="detail-acc__head">
                        <h2 class="detail-acc__title">Deltagare</h2>
                        <span class="detail-acc__meta">@_participantEdits.Count st@(AllergyCount > 0 ? $" · {AllergyCount} allergier" : "")</span>
                        <span class="detail-acc__chev" aria-hidden="true">▾</span>
                    </summary>
                    <div class="detail-acc__body">
                        @foreach (var edit in _participantEdits)
                        {
                            var participant = _participants.First(p => p.Id == edit.Id);
                            var isOvernight = participant.ParticipantType == ParticipantType.Overnight;
                            var editing = _editingParticipants.Contains(edit.Id);
                            <fieldset class="participant" data-participant="@edit.Id">
                                <legend>@(isOvernight ? "Övernattande gäst" : $"Dagsgäst ({participant.AttendanceDate:yyyy-MM-dd})")</legend>

                                @if (!editing)
                                {
                                    @* Read view — opens on arrival instead of live inputs, so looking someone up on a
                                       large booking doesn't render every field for every guest as editable by default. *@
                                    <div class="participant-view">
                                        <div class="participant-view__row">
                                            <span class="participant-view__name">@edit.FullName</span>
                                            <button type="button" class="edit-pencil" @onclick="() => ToggleParticipantEdit(edit.Id)">✎ Redigera</button>
                                        </div>
                                        <div class="participant-view__meta">
                                            @AgeLabel(edit.AgeCategory)
                                        </div>
                                        @if (edit.Allergies.Count > 0 || !string.IsNullOrWhiteSpace(edit.AllergyNotes))
                                        {
                                            <div class="participant-view__diet">
                                                @foreach (var allergy in edit.Allergies)
                                                {
                                                    <span class="chip">@AllergyLabel(allergy)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(edit.AllergyNotes))
                                                {
                                                    <span class="chip">@edit.AllergyNotes</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @* Text fields save when you leave them, not on every keystroke. *@
                                    <div class="form-group">
                                        <label>Namn</label>
                                        <input @bind="edit.FullName" @bind:after="SaveParticipants" maxlength="200" />
                                    </div>

                                    <div class="form-group">
                                        <label>Ålderskategori</label>
                                        <select @bind="edit.AgeCategory" @bind:after="SaveParticipants">
                                            @foreach (var age in AgeCategories)
                                            {
                                                <option value="@age">@AgeLabel(age)</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <span class="label">Allergier</span>
                                        @foreach (var allergy in AllergyOptions)
                                        {
                                            <label class="form-check">
                                                <input type="checkbox" checked="@edit.Allergies.Contains(allergy)"
                                                       @onchange="e => ToggleAllergy(edit, allergy, (bool)(e.Value ?? false))" />
                                                @AllergyLabel(allergy)
                                            </label>
                                        }
                                    </div>

                                    <div class="form-group">
                                        <label>Allergianteckning</label>
                                        <input @bind="edit.AllergyNotes" @bind:after="SaveParticipants" maxlength="200" />
                                    </div>

                                    <button type="button" class="btn-outline btn-sm" @onclick="() => ToggleParticipantEdit(edit.Id)">Klar</button>
                                }
                            </fieldset>
                        }
                    </div>
                </details>
            }

            @* ── Guest message / denial / cancellation ────────────────── *@
            @if (!string.IsNullOrWhiteSpace(_booking.Message))
            {
                <details class="detail-acc" open>
                    <summary class="detail-acc__head">
                        <h2 class="detail-acc__title">Meddelande</h2>
                        <span class="detail-acc__chev" aria-hidden="true">▾</span>
                    </summary>
                    <div class="detail-acc__body">
                        <p style="white-space:pre-wrap">@_booking.Message</p>
                    </div>
                </details>
            }

            @if (_booking.Status == BookingStatus.Denied && !string.IsNullOrWhiteSpace(_booking.DenialReason))
            {
                <details class="detail-acc" open>
                    <summary class="detail-acc__head">
                        <h2 class="detail-acc__title">Avslagsmotivering</h2>
                        <span class="detail-acc__chev" aria-hidden="true">▾</span>
                    </summary>
                    <div class="detail-acc__body">
                        <p style="white-space:pre-wrap">@_booking.DenialReason</p>
                    </div>
                </details>
            }

            @if (_booking.Status == BookingStatus.Cancelled)
            {
                <details class="detail-acc" open>
                    <summary class="detail-acc__head">
                        <h2 class="detail-acc__title">Avbokning</h2>
                        <span class="detail-acc__chev" aria-hidden="true">▾</span>
                    </summary>
                    <div class="detail-acc__body">
                        <dl class="kv">
                            <dt>Initiativtagare</dt><dd>@(_booking.CancellationInitiator == CancellationInitiator.GuestInitiated ? "Gäst" : "Anläggning")</dd>
                            @if (!string.IsNullOrWhiteSpace(_booking.CancellationReason))
                            {
                                <dt>Orsak</dt><dd>@_booking.CancellationReason</dd>
                            }
                        </dl>
                    </div>
                </details>
            }
        </div>

        @* ── Action rail ─────────────────────────────────────────────── *@
        <aside class="detail-rail">
            <section class="card">
                <div class="card__head"><h2>Åtgärder</h2></div>

                @if (_booking.Status == BookingStatus.Pending && _booking.BookingType == BookingType.StayRequest)
                {
                    @* Both pre-approval notices share one advisory style (amber .alert--warn, "!" badge,
                       bold lead + body) so the action rail reads as one coherent voice, not a jumble of
                       colours/icons. ARIA roles still differ by urgency (status vs alert). *@
                    @if (IsCheckInWithin14Days)
                    {
                        <div class="alert alert--warn" role="status">
                            <span class="alert__ic" aria-hidden="true">!</span>
                            <div>
                                <b>Kort varsel — @DaysToCheckIn dagar till incheckning</b>
                                <div>Slutförandelänken förkortas till 48 timmar. Överväg att kontakta gästen direkt.</div>
                            </div>
                        </div>
                    }
                    @if (_approvalWarning.Any)
                    {
                        <div class="alert alert--warn" role="alert">
                            <span class="alert__ic" aria-hidden="true">!</span>
                            <div>
                                <b>Kontrollera innan du godkänner</b>
                                <ul class="alert__list">
                                    @if (_approvalWarning.OverlapsBlock)
                                    {
                                        <li>Datumen överlappar en eller flera blockeringar: @string.Join("; ", _approvalWarning.BlockDescriptions). Rumsväljaren kan bli tom för gästen.</li>
                                    }
                                    @if (_approvalWarning.NoLodgingAssigned)
                                    {
                                        <li>Ingen byggnad är tilldelad ännu. Tilldela boende innan du godkänner.</li>
                                    }
                                    @if (_approvalWarning.CapacityExceeded)
                                    {
                                        <li>Antal övernattande gäster (@_approvalWarning.RequestedGuests) överstiger tillgängliga bäddar (@_approvalWarning.AvailableBeds) för perioden.</li>
                                    }
                                    @* FR-101: a stated time the guest will assume was approved along
                                       with the booking, unless someone raises it. *@
                                    @foreach (var deviation in _approvalWarning.TimeDeviations)
                                    {
                                        <li>@deviation Kom överens om eventuellt tillägg med gästen innan du godkänner.</li>
                                    }
                                </ul>
                                <p class="form-hint">Du kan ändå godkänna — detta är endast en varning.</p>
                            </div>
                        </div>
                    }
                    <div class="rail-actions">
                        <button class="btn" @onclick="() => _pending = PendingBookingAction.Approve">Godkänn</button>
                    </div>
                    <div class="action-panel">
                        <label for="deny-reason">Avslagsmotivering (skickas till gästen)</label>
                        <InputTextArea id="deny-reason" @bind-Value="_denyReason" />
                        <button class="btn-outline btn-danger" @onclick="() => _pending = PendingBookingAction.Deny">Avslå</button>
                    </div>
                }
                else if (_booking.Status == BookingStatus.Pending && _booking.BookingType == BookingType.GeneralInquiry)
                {
                    <div class="rail-actions">
                        <button class="btn" @onclick="Close">Markera som besvarad</button>
                    </div>
                }

                @if (_booking.Status == BookingStatus.Approved)
                {
                    <p class="action-note"><strong>Slutförandelänk giltig till:</strong><br />@(_booking.CompletionTokenExpiry?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</p>
                    <div class="rail-actions" style="margin-top:0.6rem">
                        <button class="btn-outline" @onclick="() => _pending = PendingBookingAction.Regenerate">Återutfärda och skicka länk på nytt</button>
                    </div>
                }

                @if (_booking.Status == BookingStatus.DetailsComplete)
                {
                    <div class="rail-actions">
                        <button class="btn" @onclick="MarkArrived">Markera anländ</button>
                    </div>
                }

                @if (_booking.Status == BookingStatus.Active)
                {
                    <div class="rail-actions">
                        <button class="btn" @onclick="() => _pending = PendingBookingAction.MarkCompleted">Markera avslutad</button>
                    </div>
                }

                @if (CanCancel)
                {
                    <div class="action-panel">
                        <h3>Avboka</h3>
                        <label for="cancel-initiator">Vem avbokar?</label>
                        <select id="cancel-initiator" @bind="_cancelInitiator">
                            <option value="@CancellationInitiator.GuestInitiated">Gästen</option>
                            <option value="@CancellationInitiator.PropertyInitiated">Anläggningen</option>
                        </select>
                        <label for="cancel-reason">Orsak (intern, valfritt)</label>
                        <InputTextArea id="cancel-reason" @bind-Value="_cancelReason" />
                        <button class="btn-outline btn-danger" @onclick="() => _pending = PendingBookingAction.Cancel">Avboka</button>
                    </div>
                }
            </section>

            @* ── List downloads (FR-44/45) ─────────────────────────── *@
            @if (ListShaper.IsAvailableFor(_booking.Status))
            {
                <section class="card">
                    <div class="card__head"><h2>Listor</h2></div>
                    <dl class="kv">
                        <dt>Deltagarlista</dt>
                        <dd>
                            <a href="/bokningar/@_booking.Id/deltagarlista.pdf">PDF</a> ·
                            <a href="/bokningar/@_booking.Id/deltagarlista.xlsx">Excel</a>
                        </dd>
                        <dt>Matlista</dt>
                        <dd>
                            <a href="/bokningar/@_booking.Id/matlista.pdf">PDF</a> ·
                            <a href="/bokningar/@_booking.Id/matlista.xlsx">Excel</a>
                        </dd>
                    </dl>
                </section>
            }

            @* ── Internal notes (FR-39) ────────────────────────────── *@
            <section class="card">
                <div class="card__head"><h2>Interna anteckningar</h2></div>
                <InputTextArea @bind-Value="_notes" rows="4" aria-label="Interna anteckningar" />
                <button class="btn btn-sm" style="margin-top:0.6rem" @onclick="SaveNotes">Spara anteckningar</button>
            </section>
        </aside>
    </div>

    <ConfirmDialog Visible="_pending is not null"
                   Title="@PendingTitle"
                   Message="@PendingMessage"
                   ConfirmText="@PendingConfirmText"
                   Danger="PendingIsDanger"
                   OnConfirm="ConfirmPending"
                   OnCancel="() => _pending = null" />

    @* Removing a meal deletes the dish agreed for it — the one irreversible action among the
       otherwise freely reversible controls in the Måltider section. *@
    <ConfirmDialog Visible="_pendingRemoval is not null"
                   Title="Ta bort måltiden?"
                   Message="@(_pendingRemoval is { } m ? RemovalMessage(m) : null)"
                   ConfirmText="Ta bort måltiden"
                   OnConfirm="ConfirmRemoval"
                   OnCancel="() => _pendingRemoval = null" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    // Guest-facing actions gate behind a confirmation (Phase 11) — each one emails or otherwise
    // reaches the booker, so an accidental click has an external, hard-to-undo effect. Purely
    // internal transitions (Close, MarkArrived) and reversible saves are deliberately NOT gated.
    private enum PendingBookingAction { Approve, Deny, Cancel, MarkCompleted, Regenerate }

    private PendingBookingAction? _pending;

    private string PendingTitle => _pending switch
    {
        PendingBookingAction.Approve => "Godkänn bokning",
        PendingBookingAction.Deny => "Avslå bokning",
        PendingBookingAction.Cancel => "Avboka bokning",
        PendingBookingAction.MarkCompleted => "Markera som avslutad",
        PendingBookingAction.Regenerate => "Återutfärda slutförandelänk",
        _ => ""
    };

    private string PendingMessage => _pending switch
    {
        PendingBookingAction.Approve => "Bokningen godkänns och ett e-postmeddelande med slutförandelänk skickas till gästen. Vill du fortsätta?",
        PendingBookingAction.Deny => "Bokningen avslås och gästen underrättas via e-post. Vill du fortsätta?",
        PendingBookingAction.Cancel => "Bokningen avbokas och gästen underrättas via e-post. Vill du fortsätta?",
        PendingBookingAction.MarkCompleted => "Bokningen markeras som avslutad och ett tackmejl skickas till gästen. Vill du fortsätta?",
        PendingBookingAction.Regenerate => "En ny slutförandelänk skickas till gästen via e-post. Vill du fortsätta?",
        _ => ""
    };

    private string PendingConfirmText => _pending switch
    {
        PendingBookingAction.Approve => "Godkänn",
        PendingBookingAction.Deny => "Avslå",
        PendingBookingAction.Cancel => "Avboka",
        PendingBookingAction.MarkCompleted => "Markera avslutad",
        PendingBookingAction.Regenerate => "Skicka ny länk",
        _ => "Bekräfta"
    };

    // Red only for the negative/destructive transitions; positive actions stay primary-green.
    private bool PendingIsDanger => _pending is PendingBookingAction.Deny or PendingBookingAction.Cancel;

    private async Task ConfirmPending()
    {
        var action = _pending;
        _pending = null;

        switch (action)
        {
            case PendingBookingAction.Approve: await Approve(); break;
            case PendingBookingAction.Deny: await Deny(); break;
            case PendingBookingAction.Cancel: await Cancel(); break;
            case PendingBookingAction.MarkCompleted: await MarkCompleted(); break;
            case PendingBookingAction.Regenerate: await Regenerate(); break;
        }
    }

    private Booking? _booking;
    private bool _loaded;
    private string? _message;
    private ApprovalWarning _approvalWarning = ApprovalWarning.None;

    private string? _notes;
    private string? _denyReason;
    private string? _cancelReason;
    private CancellationInitiator _cancelInitiator = CancellationInitiator.GuestInitiated;

    // Guest-data editing (FR-48). Three models for three sections, each saving on change — see the
    // Vistelse note in the markup for why there are no save buttons on this page.
    private List<Participant> _participants = [];
    private List<BookingMealSelection> _mealSelections = [];
    private List<ParticipantEdit> _participantEdits = [];
    private GroupMealEdit _mealEdit = new();
    private string? _checkInTime;
    private string? _checkOutTime;
    private bool _editingTimes;

    // Removing a meal deletes the dish agreed for it, so it is confirmed first — the same gate the
    // rest of the admin puts on anything irreversible.
    private EdgeMeal? _pendingRemoval;

    // Building assignment (FR-103, §8.16).
    private IReadOnlyList<BuildingAvailability> _assignable = [];
    private readonly HashSet<Guid> _selectedBuildingIds = [];
    private string? _assignmentError;
    private List<MealOption> _lunchOptions = [];
    private List<MealOption> _dinnerOptions = [];
    private readonly HashSet<Guid> _editingParticipants = [];

    private int AllergyCount => _participantEdits.Count(e => e.Allergies.Count > 0);

    /// <summary>Summary for the collapsed Måltider header — how many meals the group takes and how
    /// many still need a dish, so an undecided meal is visible without opening the section.</summary>
    private string MealSummary
    {
        get
        {
            var taken = _mealEdit.Meals.Count;
            var undecided = _mealEdit.Meals.Count(m => m.MealOptionId is null);
            return undecided > 0 ? $"{taken} måltider · {undecided} utan vald rätt" : $"{taken} måltider";
        }
    }

    /// <summary>The six meals a group may or may not take (§4.1). Middle days are not among them:
    /// a full day always has all three, so there is nothing to choose.</summary>
    private enum EdgeMeal { ArrivalBreakfast, ArrivalLunch, ArrivalDinner, DepartureBreakfast, DepartureLunch, DepartureDinner }

    private static readonly EdgeMeal[] ArrivalMeals =
        [EdgeMeal.ArrivalBreakfast, EdgeMeal.ArrivalLunch, EdgeMeal.ArrivalDinner];
    private static readonly EdgeMeal[] DepartureMeals =
        [EdgeMeal.DepartureBreakfast, EdgeMeal.DepartureLunch, EdgeMeal.DepartureDinner];

    private static string EdgeMealLabel(EdgeMeal meal) => meal switch
    {
        EdgeMeal.ArrivalBreakfast or EdgeMeal.DepartureBreakfast => "Frukost",
        EdgeMeal.ArrivalLunch or EdgeMeal.DepartureLunch => "Lunch",
        _ => "Middag",
    };

    private bool IsEdgeMealOn(EdgeMeal meal) => meal switch
    {
        EdgeMeal.ArrivalBreakfast => _mealEdit.ArrivalBreakfast,
        EdgeMeal.ArrivalLunch => _mealEdit.ArrivalLunch,
        EdgeMeal.ArrivalDinner => _mealEdit.ArrivalDinner,
        EdgeMeal.DepartureBreakfast => _mealEdit.DepartureBreakfast,
        EdgeMeal.DepartureLunch => _mealEdit.DepartureLunch,
        _ => _mealEdit.DepartureDinner,
    };

    private void SetEdgeMeal(EdgeMeal meal, bool on)
    {
        switch (meal)
        {
            case EdgeMeal.ArrivalBreakfast: _mealEdit.ArrivalBreakfast = on; break;
            case EdgeMeal.ArrivalLunch: _mealEdit.ArrivalLunch = on; break;
            case EdgeMeal.ArrivalDinner: _mealEdit.ArrivalDinner = on; break;
            case EdgeMeal.DepartureBreakfast: _mealEdit.DepartureBreakfast = on; break;
            case EdgeMeal.DepartureLunch: _mealEdit.DepartureLunch = on; break;
            default: _mealEdit.DepartureDinner = on; break;
        }
    }

    /// <summary>The (day, meal) a checkbox governs, or null for breakfast — a buffet, never a dish,
    /// so unticking it can never lose a choice.</summary>
    private (DateOnly Date, MealType MealType)? EdgeMealSlot(EdgeMeal meal)
    {
        if (_booking?.CheckIn is not { } checkIn || _booking.CheckOut is not { } checkOut) return null;
        return meal switch
        {
            EdgeMeal.ArrivalLunch => (checkIn, MealType.Lunch),
            EdgeMeal.ArrivalDinner => (checkIn, MealType.Dinner),
            EdgeMeal.DepartureLunch => (checkOut, MealType.Lunch),
            EdgeMeal.DepartureDinner => (checkOut, MealType.Dinner),
            _ => null,
        };
    }

    private string RemovalMessage(EdgeMeal meal)
    {
        var slot = EdgeMealSlot(meal);
        var label = slot is { } s2 && s2.MealType == MealType.Lunch ? "lunchen" : "middagen";
        var day = ArrivalMeals.Contains(meal) ? "ankomstdagen" : "avresedagen";
        return $"Gruppen äter då inte {label} på {day}, och den valda rätten tas bort. "
             + "Sätter ni tillbaka måltiden får ni välja rätt på nytt.";
    }

    /// <summary>Applies a meal tick. Removing a meal that has a dish agreed asks first; everything
    /// else applies immediately, like the rest of this page.</summary>
    private async Task ToggleEdgeMeal(EdgeMeal meal, bool on)
    {
        if (!on && EdgeMealSlot(meal) is { } slot
            && _mealEdit.Meals.Any(m => m.Date == slot.Date && m.MealType == slot.MealType && m.MealOptionId is not null))
        {
            _pendingRemoval = meal;
            return;
        }

        SetEdgeMeal(meal, on);
        await SaveGroupMeals();
    }

    private async Task ConfirmRemoval()
    {
        if (_pendingRemoval is { } meal)
        {
            SetEdgeMeal(meal, false);
            _pendingRemoval = null;
            await SaveGroupMeals();
        }
    }

    private static readonly AgeCategory[] AgeCategories =
        [AgeCategory.Adult, AgeCategory.Child, AgeCategory.Infant];
    // Allergies only — vegetarian/vegan are booking-level portion counts now, not per-person (§4.6).
    private static readonly Allergy[] AllergyOptions =
        [Allergy.Gluten, Allergy.Lactose, Allergy.Nut, Allergy.Other];

    private int DaysToCheckIn =>
        _booking?.CheckIn is null ? int.MaxValue
        : _booking.CheckIn.Value.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;

    private bool IsCheckInWithin14Days => DaysToCheckIn <= 14;

    private bool CanCancel => _booking is not null &&
        BookingStateMachine.CanTransition(_booking.Status, BookingStatus.Cancelled);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _booking = await BookingService.GetWithSelectionsAsync(Id);
        _loaded = true;
        if (_booking is null) return;

        _notes = _booking.AdminNotes;

        if (_booking.BookingType == BookingType.StayRequest)
        {
            _assignable = await BookingService.GetAssignableBuildingsAsync(Id);
            _selectedBuildingIds.Clear();
            foreach (var a in _booking.BuildingAssignments)
                _selectedBuildingIds.Add(a.BuildingId);
        }

        // Non-blocking pre-approval warnings (block overlap / capacity) shown before "Godkänn".
        _approvalWarning = _booking is { Status: BookingStatus.Pending, BookingType: BookingType.StayRequest }
            ? await BookingService.GetApprovalWarningsAsync(Id)
            : ApprovalWarning.None;

        // Participants exist only after the guest submits (DetailsComplete+). Load them plus the
        // group's meal selections and the meal options the admin editor needs.
        var withParticipants = await BookingService.GetWithParticipantsAsync(Id);
        _participants = withParticipants?.Participants.OrderBy(p => p.ParticipantType).ToList() ?? [];
        _mealSelections = withParticipants?.MealSelections
            .OrderBy(m => m.Date).ThenBy(m => m.MealType).ToList() ?? [];

        if (_participants.Count > 0)
        {
            var options = await MealOptionService.GetActiveAsync();
            _lunchOptions = options.Where(o => o.MealType == MealType.Lunch).ToList();
            _dinnerOptions = options.Where(o => o.MealType == MealType.Dinner).ToList();
            _participantEdits = ToParticipantEdits(_participants);
            _mealEdit = ToMealEdit(_booking, _mealSelections);
        }
        else
        {
            _participantEdits = [];
            _mealEdit = new GroupMealEdit();
        }

        _checkInTime = StatedTimePolicy.Display(_booking.CheckInTime, MealOccasionResolver.StandardCheckInTime);
        _checkOutTime = StatedTimePolicy.Display(_booking.CheckOutTime, MealOccasionResolver.StandardCheckOutTime);
    }

    private static List<ParticipantEdit> ToParticipantEdits(IReadOnlyList<Participant> participants) =>
        participants.Select(p => new ParticipantEdit
        {
            Id = p.Id,
            FullName = p.FullName,
            AgeCategory = p.AgeCategory,
            Allergies = [.. p.Allergies],
            AllergyNotes = p.AllergyNotes,
        }).ToList();

    /// <summary>One entry per meal the group is having — built from the resolved meals, not from the
    /// stored dishes, so a meal with nothing chosen still gets a dropdown.</summary>
    private static GroupMealEdit ToMealEdit(Booking b, IReadOnlyList<BookingMealSelection> meals) => new()
    {
        Meals = MealOccasionResolver.Resolve(b).SelectionSlots
            .Select(slot => new MealChoiceEdit
            {
                Date = slot.Date,
                MealType = slot.MealType,
                MealOptionId = meals.FirstOrDefault(m => m.Date == slot.Date && m.MealType == slot.MealType)?.MealOptionId,
            })
            .ToList(),
        ArrivalBreakfast = b.ArrivalBreakfast,
        ArrivalLunch = b.ArrivalLunch,
        ArrivalDinner = b.ArrivalDinner,
        DepartureBreakfast = b.DepartureBreakfast,
        DepartureLunch = b.DepartureLunch,
        DepartureDinner = b.DepartureDinner,
        DayGuestBreakfast = b.DayGuestBreakfast,
        DayGuestLunch = b.DayGuestLunch,
        DayGuestDinner = b.DayGuestDinner,
        VegetarianCount = b.VegetarianCount,
        VeganCount = b.VeganCount,
    };

    private async Task ToggleAllergy(ParticipantEdit edit, Allergy allergy, bool on)
    {
        if (on) { if (!edit.Allergies.Contains(allergy)) edit.Allergies.Add(allergy); }
        else edit.Allergies.Remove(allergy);
        await SaveParticipants();
    }

    private void ToggleParticipantEdit(Guid participantId)
    {
        if (!_editingParticipants.Add(participantId)) _editingParticipants.Remove(participantId);
    }

    private string AssignmentSummary
    {
        get
        {
            var chosen = _assignable.Where(b => _selectedBuildingIds.Contains(b.Building.Id)).ToList();
            if (chosen.Count == 0) return "Ingen byggnad tilldelad";
            var beds = chosen.Sum(b => b.AvailableBedCount);
            return $"{chosen.Count} {(chosen.Count == 1 ? "byggnad" : "byggnader")} · {beds} bäddar";
        }
    }

    /// <summary>Persists on every tick — there is no separate save step (decision 2026-08-06). The
    /// approval precondition (FR-103/D1) reads the <b>persisted</b> assignment, so page state alone
    /// would never satisfy it. On failure the tick is reverted, so what is shown always matches what
    /// is stored rather than leaving the admin believing a rejected change took.</summary>
    private async Task ToggleBuilding(Guid buildingId, bool selected)
    {
        if (selected) _selectedBuildingIds.Add(buildingId);
        else _selectedBuildingIds.Remove(buildingId);

        var result = await BookingService.SetBuildingAssignmentsAsync(Id, [.. _selectedBuildingIds]);
        if (!result.Succeeded)
        {
            if (selected) _selectedBuildingIds.Remove(buildingId);
            else _selectedBuildingIds.Add(buildingId);
            _assignmentError = result.Error;
            return;
        }

        _assignmentError = null;
        _message = "Byggnadstilldelningen är sparad.";
        await Load();
    }

    private static string AgeLabel(AgeCategory age) => age switch
    {
        AgeCategory.Adult => "Vuxen (13+)",
        AgeCategory.Child => "Barn (4–12)",
        AgeCategory.Infant => "Barn (0–3)",
        _ => age.ToString(),
    };

    private static string AllergyLabel(Allergy allergy) => BookingDisplay.AllergyLabel(allergy);

    private async Task SaveParticipants()
    {
        await BookingService.SaveParticipantRosterAsync(Id, _participantEdits);
        _message = "Deltagaruppgifterna är sparade.";
        await Load();
    }

    private async Task SaveGroupMeals()
    {
        await BookingService.SaveGroupMealsAsync(Id, _mealEdit);
        _message = "Måltiderna är sparade.";
        await Load();
    }

    private async Task SaveTimes()
    {
        await BookingService.SaveStatedTimesAsync(Id, _checkInTime, _checkOutTime);
        _message = "Tiderna är sparade.";
        await Load();
    }

    private async Task Approve()
    {
        var result = await BookingService.ApproveAsync(Id);
        if (!result.Succeeded) { _message = result.Error; return; }
        _message = result.ShortExpiryWarning
            ? $"Bokningen är godkänd. Slutförandelänken är förkortad och går ut {result.TokenExpiry?.ToLocalTime():yyyy-MM-dd HH:mm} — kontakta gästen vid behov."
            : $"Bokningen är godkänd och e-post med slutförandelänk är skickad (giltig till {result.TokenExpiry?.ToLocalTime():yyyy-MM-dd HH:mm}).";
        await Load();
    }

    private async Task Deny()
    {
        var result = await BookingService.DenyAsync(Id, _denyReason ?? "");
        _message = result.Succeeded ? "Bokningen är avslagen och gästen har underrättats." : result.Error;
        if (result.Succeeded) _denyReason = null;
        await Load();
    }

    private async Task Close()
    {
        var result = await BookingService.CloseAsync(Id);
        _message = result.Succeeded ? "Förfrågan är markerad som besvarad." : result.Error;
        await Load();
    }

    private async Task Cancel()
    {
        var result = await BookingService.CancelAsync(Id, _cancelInitiator, _cancelReason);
        _message = result.Succeeded ? "Bokningen är avbokad och gästen har underrättats." : result.Error;
        if (result.Succeeded) _cancelReason = null;
        await Load();
    }

    private async Task Regenerate()
    {
        var result = await BookingService.RegenerateCompletionLinkAsync(Id);
        _message = result.Succeeded ? "En ny slutförandelänk är skickad till gästen." : result.Error;
        await Load();
    }

    private async Task MarkArrived()
    {
        var result = await BookingService.MarkArrivedAsync(Id);
        _message = result.Succeeded ? "Bokningen är markerad som anländ." : result.Error;
        await Load();
    }

    private async Task MarkCompleted()
    {
        var result = await BookingService.MarkCompletedAsync(Id);
        _message = result.Succeeded ? "Bokningen är markerad som avslutad och ett tackmejl har skickats till gästen." : result.Error;
        await Load();
    }

    private async Task SaveNotes()
    {
        await BookingService.SetAdminNotesAsync(Id, _notes);
        _message = "Anteckningarna är sparade.";
    }
}
