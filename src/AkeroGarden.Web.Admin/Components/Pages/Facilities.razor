@page "/faciliteter"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Core.Data.Entities
@inject FacilityService FacilityService
@inject IImageStorage ImageStorage
@inject PhysicalBuildingService PhysicalBuildingService
@attribute [Authorize(Roles = AdminRoles.Administrator)]

<PageTitle>Faciliteter — Åkerögården Admin</PageTitle>

<AdminHeader Title="Faciliteter" />

<p class="form-hint">Bokningsbara faciliteter som gäster kan välja till sin vistelse. Inaktivera i stället för att ta bort faciliteter som används av bokningar.</p>

<Toast @bind-Message="_message" />

@if (_facilities is null)
{
    <p class="admin-empty">Laddar…</p>
}
else
{
    <div class="admin-toolbar">
        <button type="button" class="btn" @onclick="OpenCreate">+ Lägg till facilitet</button>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="num">Ordning</th>
                    <th>Namn</th>
                    <th>Fysisk byggnad</th>
                    <th>Bild</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in _facilities)
                {
                    <tr @onclick="() => OpenEdit(f)">
                        <td class="num mono">@f.DisplayOrder</td>
                        <td><span class="rowlink">@f.Name</span></td>
                        <td>@(f.PhysicalBuildingId is null ? "—" : PhysicalBuildingName(f.PhysicalBuildingId.Value))</td>
                        <td>@(string.IsNullOrEmpty(f.ImageUrl) ? "—" : "Ja")</td>
                        <td>
                            @if (f.IsActive)
                            {
                                <span class="badge badge--approved">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge--neutral">Inaktiv</span>
                            }
                        </td>
                        <td class="rowactions">
                            <button class="btn-ghost" @onclick="() => OpenEdit(f)" @onclick:stopPropagation="true">Redigera</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-cards">
        @foreach (var f in _facilities)
        {
            <AdminDataCard Title="@f.Name" OnClick="() => OpenEdit(f)">
                <Badge>
                    @if (f.IsActive)
                    {
                        <span class="badge badge--approved">Aktiv</span>
                    }
                    else
                    {
                        <span class="badge badge--neutral">Inaktiv</span>
                    }
                </Badge>
                <Fields>
                    <div><dt>Ordning</dt><dd>@f.DisplayOrder</dd></div>
                    <div><dt>Fysisk byggnad</dt><dd>@(f.PhysicalBuildingId is null ? "—" : PhysicalBuildingName(f.PhysicalBuildingId.Value))</dd></div>
                    <div><dt>Bild</dt><dd>@(string.IsNullOrEmpty(f.ImageUrl) ? "—" : "Ja")</dd></div>
                </Fields>
            </AdminDataCard>
        }
    </div>
}

<EditForm Model="_form" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <AdminPanel Visible="_panelOpen" Title="@(_isCreating ? "Ny facilitet" : (string.IsNullOrEmpty(_form.Name) ? "Namnlös" : _form.Name))" OnClose="ClosePanel">
        <ChildContent>
            <Toast @bind-Message="_panelError" />
            <div class="form-group">
                <label for="f-name">Namn</label>
                <InputText id="f-name" @bind-Value="_form.Name" />
                <ValidationMessage For="() => _form.Name" />
            </div>

            <div class="form-group">
                <label for="f-description">Beskrivning</label>
                <InputTextArea id="f-description" @bind-Value="_form.Description" />
                <ValidationMessage For="() => _form.Description" />
            </div>

            <div class="form-group">
                <label for="f-amount">Pris (exkl. moms, kr)</label>
                <InputNumber id="f-amount" min="0" @bind-Value="_form.AmountExVat" />
                <ValidationMessage For="() => _form.AmountExVat" />
            </div>

            <div class="form-group">
                <label for="f-vat">Momssats (andel, t.ex. 0,25 för 25 %)</label>
                <InputNumber id="f-vat" min="0" @bind-Value="_form.VatRate" step="0.0001" />
                <ValidationMessage For="() => _form.VatRate" />
            </div>

            <div class="form-group">
                <label for="f-order">Visningsordning</label>
                <InputNumber id="f-order" min="0" @bind-Value="_form.DisplayOrder" />
                <ValidationMessage For="() => _form.DisplayOrder" />
            </div>

            <div class="form-group">
                <label for="f-physical">Fysisk byggnad (valfritt)</label>
                <InputSelect id="f-physical" @bind-Value="_form.PhysicalBuildingId">
                    <option value="">Ingen — påverkar ingen städzon</option>
                    @foreach (var pb in _physicalBuildings.Where(p => p.IsActive))
                    {
                        <option value="@pb.Id">@pb.Name</option>
                    }
                </InputSelect>
                <p class="form-hint">Sätts bara om att boka faciliteten gör en fysisk byggnads städning aktuell (t.ex. Konferensrum → Konferensbyggnad).</p>
            </div>

            <div class="form-group">
                <label for="f-image">Bild (JPEG, PNG eller WebP, max 5 MB)</label>
                <InputFile id="f-image" OnChange="OnImageSelected" accept="image/jpeg,image/png,image/webp" />
                @if (_imageError is not null)
                {
                    <p role="alert">@_imageError</p>
                }
                @if (_pendingImage is not null)
                {
                    @* Deliberately no thumbnail: rendering the bytes back down the Blazor circuit as a
                       data: URL would push megabytes over the WebSocket for no real gain. Naming the
                       file and stating that it is not saved yet is clearer anyway. *@
                    <p class="form-hint">
                        Vald bild: <strong>@_pendingImage.FileName</strong> (@_pendingImage.SizeLabel).
                        Den laddas upp när du klickar Spara.
                    </p>
                }
                @if (FacilityImagePath.ToDisplayPath(_form.ImageUrl) is { } previewImage)
                {
                    <p>@(_pendingImage is null ? "Uppladdad bild:" : "Nuvarande bild (ersätts vid Spara):")</p>
                    <img src="@previewImage" alt="Förhandsvisning av @_form.Name" width="200" />
                    @* Clearing the reference here; the blob itself is deleted when the form is saved,
                       by FacilityService, so cancelling the edit leaves the image untouched. *@
                    <p>
                        <button type="button" class="btn-ghost btn-sm" @onclick="RemoveImage">Ta bort bild</button>
                    </p>
                }
            </div>
        </ChildContent>
        <Footer>
            <button type="submit" class="btn">Spara</button>
            @if (!_isCreating)
            {
                <button type="button" class="btn-outline" @onclick="ToggleActive">@(CurrentIsActive ? "Inaktivera" : "Aktivera")</button>
                <button type="button" class="btn-outline btn-danger" @onclick="RequestDeleteCurrent">Ta bort</button>
            }
        </Footer>
    </AdminPanel>
</EditForm>

<ConfirmDialog Visible="_pendingDelete is not null"
               Title="Ta bort facilitet"
               Message="@($"Vill du ta bort faciliteten \"{_pendingDelete?.Name}\"? Detta går inte att ångra.")"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

@code {
    private List<Facility>? _facilities;
    private List<PhysicalBuilding> _physicalBuildings = [];
    private Facility _form = new();
    private Guid? _editingId;
    private bool _isCreating;
    private bool _panelOpen;
    private ToastMessage? _message;
    private ToastMessage? _panelError;
    private string? _imageError;
    private PendingImage? _pendingImage;

    private bool CurrentIsActive => _editingId is not null && (_facilities?.FirstOrDefault(f => f.Id == _editingId)?.IsActive ?? false);

    protected override async Task OnInitializedAsync()
    {
        _physicalBuildings = await PhysicalBuildingService.GetAllAsync();
        await Load();
    }

    private async Task Load() => _facilities = await FacilityService.GetAllAsync();

    private string PhysicalBuildingName(Guid physicalBuildingId) =>
        _physicalBuildings.FirstOrDefault(p => p.Id == physicalBuildingId)?.Name ?? "—";

    /// <summary>
    /// Clears the image from the form (raised by the maintainer 2026-09-09 — the panel could only ever
    /// REPLACE an image, never remove one, so a facility that got a photo by mistake kept it forever).
    ///
    /// <para>Only the form field is cleared. The blob is deleted by <c>FacilityService.UpdateAsync</c>
    /// when the form is actually saved, so closing the panel without saving changes nothing — which is
    /// what a user expects of a form, and what makes this safe to click by accident.</para>
    /// </summary>
    private void RemoveImage()
    {
        _form.ImageUrl = null;
        _pendingImage = null;
        _imageError = null;
    }

    /// <summary>
    /// Holds the chosen file in memory. It is NOT uploaded here.
    ///
    /// <para>Uploading on selection meant that picking a file and then closing the panel left the blob
    /// in storage with nothing referencing it — an orphan created by an action the admin explicitly
    /// cancelled. It was also plainly inconsistent: removal waits for Spara, so selection must too.
    /// Nothing about the image changes until the form is saved.</para>
    /// </summary>
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Validate format/size before reading the stream (FR-27).
        var error = FacilityService.ValidateImage(file.ContentType, file.Size);
        if (error is not null)
        {
            _imageError = error;
            _pendingImage = null;
            return;
        }

        _imageError = null;
        try
        {
            await using var source = file.OpenReadStream(FacilityService.MaxImageBytes);
            using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);
            _pendingImage = new PendingImage(buffer.ToArray(), file.Name, file.ContentType);
        }
        catch (Exception)
        {
            _imageError = "Bilden kunde inte läsas. Försök igen.";
            _pendingImage = null;
        }
    }

    /// <summary>A chosen-but-not-yet-saved image. Discarded if the panel closes without saving.</summary>
    private sealed record PendingImage(byte[] Content, string FileName, string ContentType)
    {
        public string SizeLabel => $"{Content.Length / 1024d / 1024d:0.0} MB";
    }

    private void OpenCreate()
    {
        _panelOpen = true;
        _isCreating = true;
        _editingId = null;
        _panelError = null;
        _imageError = null;
        _form = new();
    }

    private void OpenEdit(Facility f)
    {
        _panelOpen = true;
        _isCreating = false;
        _editingId = f.Id;
        _panelError = null;
        _imageError = null;
        _form = new Facility
        {
            Id = f.Id,
            Name = f.Name,
            PhysicalBuildingId = f.PhysicalBuildingId,
            Description = f.Description,
            ImageUrl = f.ImageUrl,
            AmountExVat = f.AmountExVat,
            VatRate = f.VatRate,
            DisplayOrder = f.DisplayOrder
        };
    }

    private void ClosePanel()
    {
        _panelOpen = false;
        _isCreating = false;
        _editingId = null;
        _panelError = null;
        _imageError = null;
        _pendingImage = null; // never uploaded, so nothing to clean up
    }

    private async Task Save()
    {
        // Upload only now, so a cancelled panel never leaves a blob behind. If this fails the form
        // stays open with the file still selected — nothing is saved and nothing is orphaned.
        if (_pendingImage is not null)
        {
            try
            {
                using var buffer = new MemoryStream(_pendingImage.Content);
                _form.ImageUrl = await ImageStorage.UploadFacilityImageAsync(
                    buffer, _pendingImage.FileName, _pendingImage.ContentType);
                _pendingImage = null;
            }
            catch (Exception)
            {
                _imageError = "Bilden kunde inte laddas upp. Försök igen.";
                return;
            }
        }

        if (_isCreating)
        {
            await FacilityService.CreateAsync(_form);
            _message = ToastMessage.Ok($"Faciliteten \"{_form.Name}\" har lagts till.");
        }
        else
        {
            await FacilityService.UpdateAsync(_form);
            _message = ToastMessage.Ok($"Faciliteten \"{_form.Name}\" har uppdaterats.");
        }

        ClosePanel();
        await Load();
    }

    private async Task ToggleActive()
    {
        if (_editingId is null) return;
        var f = _facilities!.First(x => x.Id == _editingId);
        var next = !f.IsActive;
        await FacilityService.SetActiveAsync(f.Id, next);
        _message = ToastMessage.Ok(next
            ? $"Faciliteten \"{f.Name}\" har aktiverats."
            : $"Faciliteten \"{f.Name}\" har inaktiverats.");
        ClosePanel();
        await Load();
    }

    private Facility? _pendingDelete;

    private void RequestDeleteCurrent()
    {
        if (_editingId is not null)
            _pendingDelete = _facilities!.First(x => x.Id == _editingId);
    }

    private void CancelDelete() => _pendingDelete = null;

    private async Task ConfirmDelete()
    {
        if (_pendingDelete is null)
            return;

        var f = _pendingDelete;
        _pendingDelete = null;

        var result = await FacilityService.TryHardDeleteAsync(f.Id);
        _message = result switch
        {
            HardDeleteResult.Deleted => ToastMessage.Ok($"Faciliteten \"{f.Name}\" har tagits bort."),
            HardDeleteResult.Blocked => ToastMessage.Error($"Faciliteten \"{f.Name}\" kan inte tas bort eftersom den används av en bokning. Inaktivera den i stället."),
            _ => ToastMessage.Error($"Faciliteten \"{f.Name}\" kunde inte hittas.")
        };
        ClosePanel();
        await Load();
    }
}
