@page "/"
@layout AdminLayout
@rendermode InteractiveServer
@using System.Globalization
@using AkeroGarden.Web.Core.Data.Entities
@using AkeroGarden.Web.Core.Services
@inject BookingService BookingService
@inject NavigationManager Nav
@inject TimeProvider Clock
@attribute [Authorize(Roles = AdminRoles.Administrator)]

<PageTitle>Översikt — Åkerögården Admin</PageTitle>

<AdminHeader Title="Översikt">
    <span class="crumb">@StockholmTime.Today(Clock).ToString("dddd d MMMM yyyy", Sv)</span>
</AdminHeader>

@if (_loading)
{
    <p class="admin-empty">Laddar…</p>
}
else
{
    <div class="dash-grid">
        @* ── Väntar på svar ─────────────────────────────────────── *@
        <section class="card">
            <div class="card__head">
                <h2>Väntar på svar</h2>
                @if (_pending.Count > 0)
                {
                    <span class="n">@_pending.Count</span>
                }
                <a class="link" href="/bokningar">Alla bokningar →</a>
            </div>
            @if (_pending.Count == 0)
            {
                <p class="admin-empty">Inga förfrågningar väntar.</p>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <tbody>
                            @foreach (var b in _pending.Take(6))
                            {
                                <tr>
                                    <td>
                                        <a class="rowlink" href="/bokningar/@b.Id">@b.ContactName</a>
                                        <span class="sub">@BookingDisplay.TypeLabel(b.BookingType)@GuestSuffix(b)</span>
                                    </td>
                                    <td class="num mono">@DateRange(b)</td>
                                    <td class="cell-end">@Badge(b.Status)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="data-cards">
                    @foreach (var b in _pending.Take(6))
                    {
                        <AdminDataCard Title="@b.ContactName" OnClick="() => GoToBooking(b.Id)">
                            <Badge>@Badge(b.Status)</Badge>
                            <Sub>@BookingDisplay.TypeLabel(b.BookingType)@GuestSuffix(b)</Sub>
                            <Fields>
                                <div><dt>Datum</dt><dd>@DateRange(b)</dd></div>
                            </Fields>
                        </AdminDataCard>
                    }
                </div>
            }
        </section>

        @* ── Väntar på slutförande ──────────────────────────────── *@
        <section class="card">
            <div class="card__head">
                <h2>Väntar på slutförande</h2>
                <a class="link" href="/bokningar">Alla →</a>
            </div>
            @if (_awaitingCompletion.Count == 0)
            {
                <p class="admin-empty">Inga godkända bokningar väntar på gästens uppgifter.</p>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <tbody>
                            @foreach (var b in _awaitingCompletion.Take(6))
                            {
                                <tr>
                                    <td>
                                        <a class="rowlink" href="/bokningar/@b.Id">@b.ContactName</a>
                                        <span class="sub">Godkänd@(GuestSuffix(b))</span>
                                    </td>
                                    <td class="cell-end">@ExpiryBadge(b)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="data-cards">
                    @foreach (var b in _awaitingCompletion.Take(6))
                    {
                        <AdminDataCard Title="@b.ContactName" OnClick="() => GoToBooking(b.Id)">
                            <Badge>@ExpiryBadge(b)</Badge>
                            <Sub>Godkänd@(GuestSuffix(b))</Sub>
                        </AdminDataCard>
                    }
                </div>
            }
        </section>
    </div>

    @* ── Kommande ankomster ─────────────────────────────────────── *@
    <section class="card">
        <div class="card__head">
            <h2>Kommande ankomster</h2>
            <a class="link" href="/kalender">Kalendervy →</a>
        </div>
        @if (_upcoming.Count == 0)
        {
            <p class="admin-empty">Inga kommande ankomster.</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Datum</th>
                            <th>Sällskap</th>
                            <th class="num">Gäster</th>
                            <th>Måltider</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in _upcoming.Take(12))
                        {
                            <tr>
                                <td class="mono">@b.CheckIn?.ToString("d MMM", Sv)</td>
                                <td><a class="rowlink" href="/bokningar/@b.Id">@b.ContactName</a></td>
                                <td class="num mono">@(b.OvernightGuestCount?.ToString() ?? "—")</td>
                                <td>@BookingDisplay.MealPlanLabel(b.MealPlan)</td>
                                <td>@Badge(b.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="data-cards">
                @foreach (var b in _upcoming.Take(12))
                {
                    <AdminDataCard Title="@b.ContactName" OnClick="() => GoToBooking(b.Id)">
                        <Badge>@Badge(b.Status)</Badge>
                        <Fields>
                            <div><dt>Datum</dt><dd>@b.CheckIn?.ToString("d MMM", Sv)</dd></div>
                            <div><dt>Gäster</dt><dd>@(b.OvernightGuestCount?.ToString() ?? "—")</dd></div>
                            <div><dt>Måltider</dt><dd>@BookingDisplay.MealPlanLabel(b.MealPlan)</dd></div>
                        </Fields>
                    </AdminDataCard>
                }
            </div>
        }
    </section>
}

@code {
    private static readonly CultureInfo Sv = CultureInfo.GetCultureInfo("sv-SE");

    private bool _loading = true;
    private List<Booking> _pending = [];
    private List<Booking> _awaitingCompletion = [];
    private List<Booking> _upcoming = [];

    private void GoToBooking(Guid id) => Nav.NavigateTo($"/bokningar/{id}");

    protected override async Task OnInitializedAsync()
    {
        var today = StockholmTime.Today(Clock);

        _pending = await BookingService.GetBookingsAsync(status: BookingStatus.Pending);

        _awaitingCompletion = await BookingService.GetBookingsAsync(status: BookingStatus.Approved);

        // Upcoming = confirmed/complete stays whose check-in is today or later, nearest first.
        var approved = _awaitingCompletion;
        var complete = await BookingService.GetBookingsAsync(status: BookingStatus.DetailsComplete);
        _upcoming = approved.Concat(complete)
            .Where(b => b.CheckIn is not null && b.CheckIn >= today)
            .OrderBy(b => b.CheckIn)
            .ToList();

        _loading = false;
    }

    private static string GuestSuffix(Booking b) =>
        b.OvernightGuestCount is int n ? $" · {n} gäster" : "";

    private static string DateRange(Booking b) =>
        b.CheckIn is not null && b.CheckOut is not null
            ? $"{b.CheckIn.Value.ToString("d MMM", Sv)}–{b.CheckOut.Value.ToString("d MMM", Sv)}"
            : "—";

    private static RenderFragment Badge(BookingStatus s) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", BookingDisplay.StatusBadgeClass(s));
        builder.AddContent(2, BookingDisplay.StatusLabel(s));
        builder.CloseElement();
    };

    private RenderFragment ExpiryBadge(Booking b) => builder =>
    {
        string text;
        if (b.CompletionTokenExpiry is null)
        {
            text = "Godkänd";
        }
        else
        {
            var days = (int)Math.Ceiling((b.CompletionTokenExpiry.Value - Clock.GetUtcNow().UtcDateTime).TotalDays);
            text = days <= 0 ? "Länken har gått ut"
                : days == 1 ? "Går ut inom 1 dygn"
                : $"{days} dygn kvar";
        }
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "badge badge--approved");
        builder.AddContent(2, text);
        builder.CloseElement();
    };
}
