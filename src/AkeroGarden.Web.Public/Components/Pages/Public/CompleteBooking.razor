@page "/slutfor/{token}"
@layout MainLayout
@using System.Globalization
@using AkeroGarden.Web.Core.Data.Entities
@using AkeroGarden.Web.Core.Models
@using AkeroGarden.Web.Core.Services
@inject BookingService BookingService
@inject MealOptionService MealOptionService
@inject CleaningZoneService CleaningZoneService
@inject TimeProvider Clock
@inject NavigationManager Nav

@* Token-authenticated booking completion page (§6.6, FR-54..62). Static SSR: the token in the URL
   is the sole auth, validated server-side on every request; the submit handler re-validates before
   persisting. Phase 6 restyle keeps every field name / id / data-* attribute so the SSR binding and
   completion-form.js (full-board→meals, day-guest date→meals, group defaults, live progress) work.
   Scales to large groups: a group default cascades to everyone (JS), participant rows collapse to
   name + age, and a meal with one option shows as text (no pointless dropdown). *@

<PageTitle>Slutför din bokning — Åkerögården</PageTitle>

@if (!_loaded)
{
}
else if (_access == CompletionAccess.Valid && _booking is not null && _form is not null)
{
    <section class="page-head">
        <div class="container">
            <span class="eyebrow">Slutför din bokning</span>
            <h1>Nästan klart!</h1>
            <div class="page-head__rule"></div>
            <p>
                Hej @(_booking.ContactName)! Fyll i uppgifter om deltagarna i ert sällskap. Allt görs
                på en sida — du kan fylla i i din egen takt och skicka in när du är klar.
            </p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <dl class="booking-summary">
                <div><dt>Incheckning</dt><dd>@Fmt(_booking.CheckIn)</dd></div>
                <div><dt>Utcheckning</dt><dd>@Fmt(_booking.CheckOut)</dd></div>
                <div><dt>Övernattande</dt><dd>@(_booking.OvernightGuestCount) gäster</dd></div>
            </dl>

            @* Assigned lodging (FR-103/D4) — read-only. The system does not record who sleeps in
               which room; the group divides itself among these rooms. *@
            @if (_assignedBuildings.Count > 0)
            {
                <div class="lodging-note">
                    <h2>Ert boende</h2>
                    <p class="sec-note">
                        Ni disponerar följande byggnader. Fördela gruppen mellan rummen som ni vill —
                        vi behöver inte veta vem som sover var.
                    </p>
                    <ul class="lodging-note__list">
                        @foreach (var b in _assignedBuildings)
                        {
                            <li>
                                <strong>@b.Name</strong>
                                <span class="lodging-note__sub">@b.PhysicalBuildingName</span>
                                @if (b.Rooms.Count > 0)
                                {
                                    <span class="lodging-note__rooms">
                                        @string.Join(" · ", b.Rooms.Select(r => $"{r.Name} ({r.BedCount} bäddar)"))
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (_errors.Count > 0)
            {
                <div class="alert alert--error alert--stacked" role="alert">
                    <strong>Kontrollera följande:</strong>
                    <ul class="alert__list">
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <div class="completion-progress" data-progress hidden>
                <span>Deltagare</span>
                <div class="bar"><i data-progress-bar></i></div>
                <span data-progress-text></span>
            </div>

            <EditForm Model="_form" FormName="completion" OnSubmit="HandleSubmit" method="post">
                @* ── The group's meals (§4.1, FR-105) ────────────────────────────
                   One choice per sitting for everybody. Nobody picks individually, so this sits
                   above the roster rather than inside each participant row. *@
                @if (_catered)
                {
                    <h2>Måltider för gruppen</h2>
                    <p class="sec-note">Ni väljer en rätt per måltid som gäller hela gruppen. Individuella behov anges som allergier per person och som antal portioner längre ned.</p>

                    <div class="group-default">
                        <h3>Ankomst- och avresedagen</h3>
                        <p>Välj vilka måltider ni vill ha den dag ni kommer och den dag ni åker. Ni väljer fritt — tiderna ni angett styr inte det här.</p>

                        <div class="form-group">
                            <span class="field-label">Ankomstdagen @Capitalize(_stayCheckIn.ToString("dddd d MMMM", Sv)) (ankomst @TimeText(_booking.CheckInTime, MealOccasionResolver.StandardCheckInTime))</span>
                            <div class="diet">
                                <label><input type="checkbox" name="Form.ArrivalBreakfast" value="true" checked="@_form.ArrivalBreakfast" data-edge-meal /><input type="hidden" name="Form.ArrivalBreakfast" value="false" /> Frukost</label>
                                <label><input type="checkbox" name="Form.ArrivalLunch" value="true" checked="@_form.ArrivalLunch" data-edge-meal /><input type="hidden" name="Form.ArrivalLunch" value="false" /> Lunch</label>
                                <label><input type="checkbox" name="Form.ArrivalDinner" value="true" checked="@_form.ArrivalDinner" data-edge-meal /><input type="hidden" name="Form.ArrivalDinner" value="false" /> Middag</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <span class="field-label">Avresedagen @Capitalize(_stayCheckOut.ToString("dddd d MMMM", Sv)) (avresa @TimeText(_booking.CheckOutTime, MealOccasionResolver.StandardCheckOutTime))</span>
                            <div class="diet">
                                <label><input type="checkbox" name="Form.DepartureBreakfast" value="true" checked="@_form.DepartureBreakfast" data-edge-meal /><input type="hidden" name="Form.DepartureBreakfast" value="false" /> Frukost</label>
                                <label><input type="checkbox" name="Form.DepartureLunch" value="true" checked="@_form.DepartureLunch" data-edge-meal /><input type="hidden" name="Form.DepartureLunch" value="false" /> Lunch</label>
                                <label><input type="checkbox" name="Form.DepartureDinner" value="true" checked="@_form.DepartureDinner" data-edge-meal /><input type="hidden" name="Form.DepartureDinner" value="false" /> Middag</label>
                            </div>
                        </div>
                    </div>

                    @* The full grid is always rendered and always posted; the server keeps only the
                       sittings the group takes. completion-form.js hides the rest live — without JS
                       they stay visible and any stray choice is discarded server-side. *@
                    <div class="meals" data-group-meals>
                        @foreach (var dateGroup in _sittings.GroupBy(x => x.Slot.Date))
                        {
                            var isArrival = dateGroup.Key == _stayCheckIn;
                            var isDeparture = dateGroup.Key == _stayCheckOut;
                            <div class="day">
                                <p class="day__date">@Capitalize(dateGroup.Key.ToString("dddd d MMMM", Sv))</p>
                                <div class="day__meals">
                                    @foreach (var item in dateGroup)
                                    {
                                        var sittingIndex = item.SittingIndex;
                                        var options = item.Slot.MealType == MealType.Lunch ? _lunchOptions : _dinnerOptions;
                                        var mealLabel = item.Slot.MealType == MealType.Lunch ? "Lunch" : "Middag";
                                        var chosen = _form.MealChoices.ElementAtOrDefault(sittingIndex);
                                        var edge = isArrival ? "arrival" : isDeparture ? "departure" : null;
                                        <div class="meal-cell @(_occasions.IsSelectable(sittingIndex) ? null : "meal-cell--hidden")"
                                             data-sitting="@sittingIndex" data-meal="@item.Slot.MealType"
                                             data-edge="@edge">
                                            <label for="m@(sittingIndex)">@mealLabel</label>
                                            <select class="inp" id="m@(sittingIndex)" name="Form.MealChoices[@sittingIndex]"
                                                    data-meal-select="@item.Slot.MealType">
                                                <option value="">– välj –</option>
                                                @foreach (var o in options)
                                                {
                                                    <option value="@o.Id" selected="@(chosen == o.Id.ToString())">@o.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="form-group">
                        <span class="field-label">Specialkost (antal portioner)</span>
                        <p class="sec-note">Ange hur många i gruppen som behöver vegetarisk eller vegansk mat. Vi behöver bara antalet, inte vilka.</p>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="veg-count">Vegetariskt</label>
                                <input class="inp" id="veg-count" type="number" min="0" name="Form.VegetarianCount" value="@_form.VegetarianCount" />
                            </div>
                            <div class="form-group">
                                <label for="vegan-count">Veganskt</label>
                                <input class="inp" id="vegan-count" type="number" min="0" name="Form.VeganCount" value="@_form.VeganCount" />
                            </div>
                        </div>
                    </div>
                }

                <h2>Deltagare med övernattning</h2>
                <p class="sec-note">Namn krävs för alla deltagare. Fäll ut en person bara om hen har en allergi att anmäla.</p>

                <p class="completion-rowcount">@_form.Overnight.Count deltagare</p>

                @for (var i = 0; i < _form.Overnight.Count; i++)
                {
                    var index = i;
                    var entry = _form.Overnight[index];
                    <div class="prow" role="group" aria-label="Deltagare @(index + 1)">
                        @* Collapse toggle (CSS-only, SSR-safe). Focusable so keyboard users can expand;
                           the visual label shows the focus ring. Name + age stay outside the collapse. *@
                        <input class="prow__toggle-cb" type="checkbox" id="exp-@index"
                               aria-label="Visa allergier för deltagare @(index + 1)" />
                        <div class="prow__head">
                            <span class="prow__badge">@(index + 1)</span>
                            @* No native `required`: let the server-side CompletionNormalizer + the styled
                               error banner be the single source of truth (consistent with the inquiry
                               form), rather than a native browser bubble that suppresses our message. *@
                            <input class="inp prow__name" name="Form.Overnight[@index].FullName" value="@entry.FullName"
                                   maxlength="200" placeholder="Namn" aria-label="Namn för deltagare @(index + 1)" data-progress-name />
                            <select class="inp prow__age" name="Form.Overnight[@index].AgeCategory" aria-label="Ålderskategori för deltagare @(index + 1)">
                                @foreach (var age in AgeCategories)
                                {
                                    <option value="@age" selected="@(entry.AgeCategory == age)">@AgeLabel(age)</option>
                                }
                            </select>
                            @* The closed row must say whether an allergy is recorded. Hiding a
                               safety field behind a toggle that looks identical either way is how a
                               nut allergy gets entered, collapsed, and never seen again. Rendered
                               server-side so it survives a postback; completion-form.js keeps it in
                               step as boxes are ticked. *@
                            <label class="prow__toggle" for="exp-@index" data-allergy-label="@index">
                                <span class="chev" aria-hidden="true">›</span>
                                <span data-allergy-summary="@index">@AllergyToggleText(entry)</span>
                            </label>
                        </div>
                        <div class="prow__body">
                            <div class="form-group">
                                <span class="field-label">Allergier</span>
                                <div class="diet">
                                    @foreach (var allergy in AllergyOptions)
                                    {
                                        <label>
                                            <input type="checkbox" name="Form.Overnight[@index].Allergies" value="@allergy"
                                                   checked="@entry.Allergies.Contains(allergy)" />
                                            @AllergyLabel(allergy)
                                        </label>
                                    }
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="p@(index)-notes">Allergianteckning (om "Annat" eller övrigt)</label>
                                <textarea id="p@(index)-notes" name="Form.Overnight[@index].AllergyNotes" maxlength="200">@entry.AllergyNotes</textarea>
                            </div>
                        </div>
                    </div>
                }

                @if (_dayGuestsApplicable)
                {
                    <h2 id="dagsgaster">Dagsgäster</h2>
                    <p class="sec-note">Deltar endast på måltider (ingen övernattning). Lägg till en rad per person och dag. De äter samma rätt som gruppen.</p>

                    @* Which meals day guests attend is one setting for the whole booking (§4.2) —
                       the property does not see cases where one day guest eats more than another. *@
                    <div class="form-group">
                        <span class="field-label">Vilka måltider deltar dagsgästerna på?</span>
                        <p class="sec-note">Gäller alla dagsgäster, oavsett vilken dag de kommer.</p>
                        <div class="diet">
                            <label><input type="checkbox" name="Form.DayGuestBreakfast" value="true" checked="@_form.DayGuestBreakfast" /><input type="hidden" name="Form.DayGuestBreakfast" value="false" /> Frukost</label>
                            <label><input type="checkbox" name="Form.DayGuestLunch" value="true" checked="@_form.DayGuestLunch" /><input type="hidden" name="Form.DayGuestLunch" value="false" /> Lunch</label>
                            <label><input type="checkbox" name="Form.DayGuestDinner" value="true" checked="@_form.DayGuestDinner" /><input type="hidden" name="Form.DayGuestDinner" value="false" /> Middag</label>
                        </div>
                    </div>

                    @for (var d = 0; d < _form.DayGuests.Count; d++)
                    {
                        var di = d;
                        var dg = _form.DayGuests[di];
                        <div class="pcard" role="group" aria-label="Dagsgäst @(di + 1)">
                            <div class="pcard__head">
                                <span class="pcard__badge pcard__badge--day">D@(di + 1)</span>
                                <span class="pcard__title">Dagsgäst @(di + 1)</span>
                            </div>
                            <div class="pcard__body">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="d@(di)-name">Namn</label>
                                        <input id="d@(di)-name" name="Form.DayGuests[@di].FullName" value="@dg.FullName" maxlength="200" />
                                    </div>
                                    <div class="form-group">
                                        <label for="d@(di)-age">Ålderskategori</label>
                                        <select id="d@(di)-age" name="Form.DayGuests[@di].AgeCategory">
                                            @foreach (var age in AgeCategories)
                                            {
                                                <option value="@age" selected="@(dg.AgeCategory == age)">@AgeLabel(age)</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="d@(di)-date">Dag</label>
                                    <select id="d@(di)-date" name="Form.DayGuests[@di].AttendanceDate">
                                        <option value="">– välj dag –</option>
                                        @foreach (var date in _stayDates)
                                        {
                                            var iso = date.ToString("yyyy-MM-dd");
                                            <option value="@iso" selected="@(dg.AttendanceDate == iso)">@Capitalize(date.ToString("dddd d MMMM", Sv))</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-group">
                                    <span class="field-label">Allergier</span>
                                    <div class="diet">
                                        @foreach (var allergy in AllergyOptions)
                                        {
                                            <label>
                                                <input type="checkbox" name="Form.DayGuests[@di].Allergies" value="@allergy" checked="@dg.Allergies.Contains(allergy)" />
                                                @AllergyLabel(allergy)
                                            </label>
                                        }
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="d@(di)-notes">Allergianteckning (om "Annat" eller övrigt)</label>
                                    <textarea id="d@(di)-notes" name="Form.DayGuests[@di].AllergyNotes" maxlength="200">@dg.AllergyNotes</textarea>
                                </div>
                            </div>
                            <div class="pcard__actions">
                                <button type="submit" name="Action" value="remove-dayguest:@di"
                                        formaction="@($"/slutfor/{Token}#dagsgaster")" class="btn-ghost" formnovalidate>Ta bort dagsgäst</button>
                            </div>
                        </div>
                    }

                    <button type="submit" name="Action" value="add-dayguest"
                            formaction="@($"/slutfor/{Token}#dagsgaster")" class="btn-outline" formnovalidate>+ Lägg till dagsgäst</button>
                }

                <h2>Städning</h2>
                <p class="sec-note">Standard är att ni städar själva. Kryssa i om ni i stället vill köpa städning — vi fakturerar det separat.</p>

                <div class="fbrow">
                    <input type="checkbox" id="clean-main" name="Form.MainBuildingCleaning" value="true" checked="@_form.MainBuildingCleaning" />
                    <input type="hidden" name="Form.MainBuildingCleaning" value="false" />
                    <label for="clean-main">Huvudbyggnad (matsal &amp; gemensamma ytor)</label>
                </div>

                <div class="fbrow">
                    <input type="checkbox" id="clean-sleeping" name="Form.SleepingCleaning" value="true" checked="@_form.SleepingCleaning" />
                    <input type="hidden" name="Form.SleepingCleaning" value="false" />
                    <label for="clean-sleeping">Sovbyggnad(er) ni bor i</label>
                </div>

                @if (_conferenceCleaningApplicable)
                {
                    <div class="fbrow">
                        <input type="checkbox" id="clean-conference" name="Form.ConferenceCleaning" value="true" checked="@_form.ConferenceCleaning" />
                        <input type="hidden" name="Form.ConferenceCleaning" value="false" />
                        <label for="clean-conference">Konferensbyggnad</label>
                    </div>
                }

                <h2>Faktureringsuppgifter</h2>
                <div class="fbrow">
                    <input type="checkbox" id="is-org" name="Form.IsOrganisation" value="true" checked="@_form.IsOrganisation" />
                    <input type="hidden" name="Form.IsOrganisation" value="false" />
                    <label for="is-org">Fakturera en organisation</label>
                </div>
                @* Shown only when "Fakturera en organisation" is checked (completion-form.js). Without
                   JS the panel stays visible; the server ignores these fields unless the box is
                   checked (SubmitCompletionAsync), so a no-JS submit is still correct. *@
                <div class="reveal-panel" id="org-invoice-fields">
                    <div class="form-group">
                        <label for="org-name">Organisationsnamn</label>
                        <input id="org-name" name="Form.OrgName" value="@_form.OrgName" maxlength="200" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="org-number">Organisationsnummer</label>
                            <input id="org-number" name="Form.OrgNumber" value="@_form.OrgNumber" maxlength="50" />
                        </div>
                        <div class="form-group">
                            <label for="invoice-address">Fakturaadress</label>
                            <textarea id="invoice-address" name="Form.InvoiceAddress" maxlength="500">@_form.InvoiceAddress</textarea>
                        </div>
                    </div>
                </div>

                @* Allergy consent (FR-110). Declared allergies are health data under GDPR art. 9 and
                   the privacy policy states they are processed on explicit consent — until this
                   existed, that statement was simply untrue: allergies were collected here with no
                   consent control and no link to the policy anywhere on this page.

                   Always rendered, required only when an allergy is actually declared
                   (CompletionNormalizer.ValidateAllergyConsent). It is not hidden until an allergy is
                   entered: the allergy fields are inside collapsed per-participant panels, so a
                   checkbox appearing somewhere further down the page as a side effect of expanding
                   one of them is a worse experience than one that is simply always there.

                   Server-only gate — completion-form.js validates nothing, by design. *@
                <div class="form-section">
                    <div class="form-group form-group--checkbox">
                        <label>
                            @* The hidden false companion is this page's idiom for every bool (see
                               Form.MainBuildingCleaning / Form.IsOrganisation): an unchecked box
                               posts nothing at all, so without it the binder never sees false. *@
                            <input type="checkbox" name="Form.AllergyConsent" value="true"
                                   checked="@_form.AllergyConsent" />
                            <input type="hidden" name="Form.AllergyConsent" value="false" />
                            <span>
                                Jag godkänner att Åkerögården behandlar de allergier vi angett ovan.
                                Allergier är hälsouppgifter, och vi använder dem enbart för att laga
                                säker mat under er vistelse — se vår
                                <a href="/integritetspolicy" target="_blank">integritetspolicy</a>.
                                Behövs bara om ni har angett någon allergi.
                            </span>
                        </label>
                    </div>
                </div>

                <div class="completion-submit">
                    <button type="submit" name="Action" value="complete" class="btn">Skicka in uppgifter</button>
                    <span class="hint">Du kan skicka in nu — vi hör av oss om något behöver kompletteras.</span>
                </div>
            </EditForm>
        </div>
    </section>
}
else if (_access == CompletionAccess.AlreadyCompleted)
{
    <section class="section"><div class="container">
        <div class="utility">
            <div class="utility__badge utility__badge--ok" aria-hidden="true">✓</div>
            <h1>Uppgifterna är redan inskickade</h1>
            <p>Du har redan skickat in deltagaruppgifterna för den här bokningen. Behöver du ändra något? Kontakta oss så hjälper vi dig.</p>
            <div class="utility__actions"><a class="btn" href="/kontakt">Kontakta oss</a></div>
        </div>
    </div></section>
}
else if (_access == CompletionAccess.Expired)
{
    <section class="section"><div class="container">
        <div class="utility">
            <div class="utility__badge utility__badge--warn" aria-hidden="true">!</div>
            <h1>Länken har gått ut</h1>
            <p>Länken för att slutföra din bokning har gått ut. Kontakta oss så skickar vi en ny länk.</p>
            <div class="utility__actions"><a class="btn" href="/kontakt">Kontakta oss</a></div>
        </div>
    </div></section>
}
else
{
    <section class="section"><div class="container">
        <div class="utility">
            <div class="utility__badge utility__badge--warn" aria-hidden="true">!</div>
            <h1>Länken är inte giltig</h1>
            <p>Den här länken är inte giltig. Den kan ha ersatts av en nyare länk eller inte längre vara aktuell. Kontakta oss om du behöver en ny länk.</p>
            <div class="utility__actions"><a class="btn" href="/kontakt">Kontakta oss</a></div>
        </div>
    </div></section>
}

@* Fingerprinted via @Assets — see the note on BookInquiry's script tag. *@
<script src="@Assets["js/completion-form.js"]"></script>
<script src="@Assets["js/submit-once.js"]"></script>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "completion")]
    private CompletionFormModel? Form { get; set; }

    // Which submit button was pressed: "complete", "add-dayguest", or "remove-dayguest:{index}".
    [SupplyParameterFromForm(FormName = "completion")]
    private string? Action { get; set; }

    private static readonly CultureInfo Sv = CultureInfo.GetCultureInfo("sv-SE");

    private bool _loaded;
    private CompletionAccess _access;
    private Booking? _booking;

    // Resolved from the *form's* edge-day flags, not the booking's, so the grid the guest sees
    // matches what they just ticked rather than what was stored before the postback.
    private ResolvedMealOccasions _occasions = ResolvedMealOccasions.Empty;
    private IReadOnlyList<(MealSlot Slot, int SittingIndex)> _sittings = [];
    private List<MealOption> _lunchOptions = [];
    private List<MealOption> _dinnerOptions = [];
    private bool _catered;
    private bool _dayGuestsApplicable;
    private DateOnly _stayCheckIn;
    private DateOnly _stayCheckOut;
    private IReadOnlyList<DateOnly> _stayDates = [];
    private IReadOnlyList<AssignedLodging> _assignedBuildings = [];
    private IReadOnlyList<string> _errors = [];
    private bool _conferenceCleaningApplicable;

    private static readonly AgeCategory[] AgeCategories = [AgeCategory.Adult, AgeCategory.Child, AgeCategory.Infant];
    // Allergies only. Vegetarian/vegan are portion counts on the booking now (§4.6) — a preference
    // is not a medical constraint and does not belong on a named person.
    private static readonly Allergy[] AllergyOptions =
        [Allergy.Gluten, Allergy.Lactose, Allergy.Nut, Allergy.Other];

    // _form is the model actually rendered/bound: the posted Form on a POST, else a seeded blank.
    private CompletionFormModel? _form;

    protected override async Task OnInitializedAsync()
    {
        var (access, booking) = await BookingService.EvaluateCompletionAccessAsync(Token, Clock.GetUtcNow().UtcDateTime);
        _access = access;
        _booking = access == CompletionAccess.Valid ? booking : null;

        if (_booking is { CheckIn: not null, CheckOut: not null })
        {
            _stayCheckIn = _booking.CheckIn.Value;
            _stayCheckOut = _booking.CheckOut.Value;
            _catered = _booking.MealPlan == MealPlan.FullBoardAll;

            var options = await MealOptionService.GetActiveAsync();
            _lunchOptions = options.Where(o => o.MealType == MealType.Lunch).ToList();
            _dinnerOptions = options.Where(o => o.MealType == MealType.Dinner).ToList();

            // Day guests apply only for a catered plan (§4.2); the section is hidden otherwise.
            _dayGuestsApplicable = InquiryNormalizer.DayGuestsApplicable(_booking.MealPlan);
            _stayDates = EnumerateDates(_stayCheckIn, _stayCheckOut);

            // The buildings the admin assigned before approval (FR-103), with their rooms, shown
            // read-only. Names come from the assignment snapshots (NFR-16) so a later rename of the
            // reference data does not change what the group was told.
            _assignedBuildings = await BookingService.GetAssignedLodgingAsync(_booking.Id);

            // Konferensbyggnad toggle (§5.5, FR-93) only shown when the Konferensrum facility was
            // actually requested — Huvudbyggnad/Sovbyggnader always apply since a stay request
            // always has overnight lodging.
            _conferenceCleaningApplicable = await CleaningZoneService.IsConferenceCleaningApplicableAsync(_booking.Id);

            // On POST the framework binds Form; on GET (or a post that bound no participant rows)
            // seed a blank form (one row per overnight guest). Guarding Overnight — not just Form —
            // is essential: the SSR binder can hand back a non-null Form with a null Overnight.
            _form = Form is { Overnight: not null } ? Form : BuildEmptyForm(_booking);

            // SSR model binding also leaves an un-posted checkbox group null (e.g. no allergy
            // ticked) — normalise to empty so the re-render and the submit never dereference null.
            foreach (var entry in _form.Overnight)
                entry.Allergies ??= [];
            _form.DayGuests ??= [];
            foreach (var dg in _form.DayGuests)
                dg.Allergies ??= [];

            // Resolve from the form, not the booking: on a postback the guest may have just changed
            // an edge-day meal, and the grid must reflect that choice rather than the stored one.
            _occasions = MealOccasionResolver.Resolve(new MealOccasionInput(
                _stayCheckIn, _stayCheckOut, _booking.MealPlan ?? MealPlan.SelfCateringAll,
                _form.ArrivalBreakfast, _form.ArrivalLunch, _form.ArrivalDinner,
                _form.DepartureBreakfast, _form.DepartureLunch, _form.DepartureDinner,
                _form.DayGuestBreakfast, _form.DayGuestLunch, _form.DayGuestDinner));
            _sittings = _occasions.AllSittings.Select((s, i) => (Slot: s, SittingIndex: i)).ToList();

            // The posted choices may bind back null or short; pad to the full grid so
            // ElementAtOrDefault aligns by sitting index on the re-render.
            _form.MealChoices ??= [];
            while (_form.MealChoices.Count < _occasions.AllSittings.Count)
                _form.MealChoices.Add(null);
        }

        _loaded = true;
    }

    private async Task HandleSubmit()
    {
        _errors = [];

        // Add/remove day-guest rows are server round-trips that just mutate the model and re-render
        // (no validation, no submission) — the robust SSR alternative to client-side row cloning.
        if (Action == "add-dayguest")
        {
            _form!.DayGuests.Add(new DayGuestEntry());
            return;
        }
        if (Action is { } a && a.StartsWith("remove-dayguest:", StringComparison.Ordinal)
            && int.TryParse(a["remove-dayguest:".Length..], out var removeIndex)
            && removeIndex >= 0 && removeIndex < _form!.DayGuests.Count)
        {
            _form.DayGuests.RemoveAt(removeIndex);
            return;
        }

        var result = await BookingService.SubmitCompletionAsync(Token, _form!, Clock.GetUtcNow().UtcDateTime);
        switch (result.Outcome)
        {
            case CompletionSubmitOutcome.Success:
                // Post/Redirect/Get (NFR-41) — see CompleteBookingThanks for why the thank-you is
                // not rendered as this POST's response.
                Nav.NavigateTo("/slutfor/tack");
                break;
            case CompletionSubmitOutcome.ValidationFailed:
                _errors = result.Errors;
                break;
            case CompletionSubmitOutcome.LinkNotValid:
                // The link went stale between load and submit — show the appropriate message.
                _access = result.Access;
                _booking = null;
                break;
        }
    }

    private static IReadOnlyList<DateOnly> EnumerateDates(DateOnly from, DateOnly to)
    {
        var dates = new List<DateOnly>();
        for (var d = from; d <= to; d = d.AddDays(1))
            dates.Add(d);
        return dates;
    }

    private static CompletionFormModel BuildEmptyForm(Booking booking)
    {
        var count = booking.OvernightGuestCount ?? 0;

        var form = new CompletionFormModel
        {
            // Pre-filled from the booking's stored edge-day meals — the standard schedule set at
            // inquiry (§4.1), which the guest is free to change here.
            ArrivalBreakfast = booking.ArrivalBreakfast,
            ArrivalLunch = booking.ArrivalLunch,
            ArrivalDinner = booking.ArrivalDinner,
            DepartureBreakfast = booking.DepartureBreakfast,
            DepartureLunch = booking.DepartureLunch,
            DepartureDinner = booking.DepartureDinner,
            DayGuestBreakfast = booking.DayGuestBreakfast,
            DayGuestLunch = booking.DayGuestLunch,
            DayGuestDinner = booking.DayGuestDinner,
            VegetarianCount = booking.VegetarianCount,
            VeganCount = booking.VeganCount,
            IsOrganisation = booking.IsOrganisation,
            OrgName = booking.OrgName,
            OrgNumber = booking.OrgNumber,
            InvoiceAddress = booking.InvoiceAddress,
        };
        for (var i = 0; i < count; i++)
            form.Overnight.Add(new OvernightParticipantEntry { AgeCategory = AgeCategory.Adult });
        return form;
    }

    /// <summary>The booking's stated time, or the standard if it predates the field (§2.8).</summary>
    private static string TimeText(TimeOnly? time, TimeOnly standard) =>
        BookingDisplay.TimeLabel(time, standard);

    private static string Fmt(DateOnly? date) => date?.ToString("d MMMM yyyy", Sv) ?? "—";

    private static string Capitalize(string value) =>
        string.IsNullOrEmpty(value) ? value : char.ToUpper(value[0], Sv) + value[1..];

    private static string AgeLabel(AgeCategory age) => age switch
    {
        AgeCategory.Adult => "Vuxen (13+)",
        AgeCategory.Child => "Barn (4–12)",
        AgeCategory.Infant => "Barn (0–3)",
        _ => age.ToString(),
    };

    private static string AllergyLabel(Allergy allergy) => BookingDisplay.AllergyLabel(allergy);

    /// <summary>What the collapsed participant row says about allergies: an invitation when there
    /// are none, and the actual allergies when there are.</summary>
    private static string AllergyToggleText(OvernightParticipantEntry entry)
    {
        var summary = BookingDisplay.AllergySummary(entry.Allergies ?? [], entry.AllergyNotes);
        return summary == "—" ? "Lägg till allergi" : summary;
    }
}
