@* The lockups are loaded via <img>, which renders SVG sandboxed — no page CSS, no webfonts.
   That is why both wordmarks are baked to outlines rather than set as <text>: a font-family
   in there resolves against whatever serif the viewer's OS happens to have, so the previous
   lockup silently rendered in Georgia (or worse on Linux) instead of the intended face.

   It also means the SVG's own aria-label is not exposed to assistive tech — the <img alt>
   below is the accessible name, and it carries both the property and the operator. *@
@if (Variant == LogoVariant.Stacked)
{
    <img src="/_content/AkeroGarden.Web.Core/logo/lockup-stacked.svg" alt="@Alt" class="logo" />
}
else if (Variant == LogoVariant.OnDark)
{
    <img src="/_content/AkeroGarden.Web.Core/logo/lockup-dark.svg" alt="@Alt" class="logo" />
}
else
{
    @* Transparent ground (dark strokes) so the lockup blends into the warm off-white header
       rather than showing a white box. *@
    <img src="/_content/AkeroGarden.Web.Core/logo/lockup-transparent.svg" alt="@Alt" class="logo" />
}

@code {
    private const string Alt = "Åkerögården — Kaldéiska Kursgård";

    [Parameter] public LogoVariant Variant { get; set; } = LogoVariant.OnLight;
}
