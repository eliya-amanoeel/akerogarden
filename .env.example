# Copy to .env.local and fill in real values.
# Never commit .env.local to source control.

# PostgreSQL (local dev — matches docker-compose.yml)
POSTGRES_USER=akerogarden
POSTGRES_PASSWORD=akerogarden_dev
POSTGRES_DB=akerogarden

# Connection string is set via dotnet user-secrets, not this file.
# See README or run: dotnet user-secrets set "ConnectionStrings:Postgres" "..."
