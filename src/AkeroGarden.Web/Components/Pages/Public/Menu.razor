@page "/meny"
@layout MainLayout
@using AkeroGarden.Web.Data.Entities
@inject MealOptionService MealOptionService

<PageTitle>Meny — Åkerögården</PageTitle>

<section class="section">
    <div class="container">
        <h1>Meny</h1>

        @if (options.Count == 0)
        {
            <p>Ingen meny finns för närvarande.</p>
        }
        else
        {
            <h2>Lunch</h2>
            @RenderMeals(MealType.Lunch)

            <h2>Middag</h2>
            @RenderMeals(MealType.Dinner)
        }
    </div>
</section>

@code {
    private List<MealOption> options = [];

    protected override async Task OnInitializedAsync() =>
        options = await MealOptionService.GetActiveAsync();

    private RenderFragment RenderMeals(MealType mealType) => __builder =>
    {
        var meals = options.Where(o => o.MealType == mealType).ToList();
        if (meals.Count == 0)
        {
            <p>Inga alternativ för närvarande.</p>
        }
        else
        {
            <ul class="meal-list">
                @foreach (var meal in meals)
                {
                    <li>
                        <strong>@meal.Name</strong>
                        @if (meal.IsVegetarian)
                        {
                            <span class="tag">Vegetariskt</span>
                        }
                        @if (!string.IsNullOrEmpty(meal.Description))
                        {
                            <p>@meal.Description</p>
                        }
                    </li>
                }
            </ul>
        }
    };
}
