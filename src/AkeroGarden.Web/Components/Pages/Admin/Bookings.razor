@page "/admin/bokningar"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Data.Entities
@using AkeroGarden.Web.Services
@inject BookingService BookingService
@inject NavigationManager Nav
@attribute [Authorize]

<PageTitle>Bokningar — Åkerögården Admin</PageTitle>

<h1>Bokningar</h1>

<div class="admin-toolbar">
    <a class="btn" href="/admin/bokningar/ny">Skapa bokning</a>
    <a class="btn-ghost" href="/admin/kalender">Kalendervy</a>
</div>

<div class="admin-filters">
    <div class="form-group">
        <label for="f-status">Status</label>
        <select id="f-status" @bind="_status" @bind:after="Load">
            <option value="">Alla</option>
            @foreach (var s in Enum.GetValues<BookingStatus>())
            {
                <option value="@s">@BookingDisplay.StatusLabel(s)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="f-type">Typ</label>
        <select id="f-type" @bind="_type" @bind:after="Load">
            <option value="">Alla</option>
            @foreach (var t in Enum.GetValues<BookingType>())
            {
                <option value="@t">@BookingDisplay.TypeLabel(t)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="f-from">Incheckning fr.o.m.</label>
        <input id="f-from" type="date" @bind="_from" @bind:after="Load" />
    </div>
    <div class="form-group">
        <label for="f-to">Incheckning t.o.m.</label>
        <input id="f-to" type="date" @bind="_to" @bind:after="Load" />
    </div>
</div>

@if (_bookings is null)
{
    <p>Laddar...</p>
}
else if (_bookings.Count == 0)
{
    <p>Inga bokningar matchar filtret.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Inkommen</th>
                <th>Typ</th>
                <th>Namn</th>
                <th>Datum</th>
                <th>Gäster</th>
                <th>Status</th>
                <th>Åtgärd</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in _bookings)
            {
                <tr>
                    <td>@b.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>@BookingDisplay.TypeLabel(b.BookingType)</td>
                    <td>@b.ContactName</td>
                    <td>
                        @if (b.CheckIn is not null && b.CheckOut is not null)
                        {
                            @($"{b.CheckIn:yyyy-MM-dd} – {b.CheckOut:yyyy-MM-dd}")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>@(b.OvernightGuestCount?.ToString() ?? "—")</td>
                    <td>@BookingDisplay.StatusLabel(b.Status)</td>
                    <td><a class="btn-ghost" href="/admin/bokningar/@b.Id">Öppna</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Booking>? _bookings;
    private string _status = "";
    private string _type = "";
    private DateOnly? _from;
    private DateOnly? _to;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        BookingStatus? status = Enum.TryParse<BookingStatus>(_status, out var s) ? s : null;
        BookingType? type = Enum.TryParse<BookingType>(_type, out var t) ? t : null;
        _bookings = await BookingService.GetBookingsAsync(status, type, _from, _to);
    }
}
