@page "/aterstall-losenord"
@layout AdminLoginLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.DataProtection
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IDataProtectionProvider DataProtectionProvider
@inject AdminInviteService InviteService

<PageTitle>Återställ lösenord — Åkerögården Admin</PageTitle>

<div class="login-card">
    <div class="login-card__logo">
        <Logo Variant="LogoVariant.OnLight" />
    </div>

    <h1>Återställ lösenord</h1>

    @if (_done)
    {
        <p>Lösenordet har återställts. Du kan nu logga in.</p>
        <a href="/login" class="btn">Logga in</a>
    }
    else if (_invalidLink)
    {
        <p class="form-error">Länken är ogiltig eller har gått ut. Begär en ny återställningslänk.</p>
        <a href="/glomt-losenord" class="btn-outline">Ny återställningslänk</a>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleReset" FormName="reset-password" method="post">
            <DataAnnotationsValidator />

            <input type="hidden" name="_model.Token" value="@_model!.Token" />
            <input type="hidden" name="_model.Email" value="@_model!.Email" />

            <div class="form-group">
                <label for="password">Nytt lösenord</label>
                <InputText id="password" @bind-Value="_model.Password" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="form-group">
                <label for="confirm">Bekräfta lösenord</label>
                <InputText id="confirm" @bind-Value="_model.ConfirmPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _model.ConfirmPassword" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            <button type="submit" class="btn">Spara nytt lösenord</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    private string? CodeParam { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordModel? _model { get; set; }

    private bool _done;
    private bool _invalidLink;
    private string? _error;

    protected override void OnInitialized()
    {
        _model ??= new();

        if (string.IsNullOrEmpty(CodeParam))
        {
            _invalidLink = true;
            return;
        }

        try
        {
            var protector = DataProtectionProvider.CreateProtector("PasswordReset");
            var payload = protector.Unprotect(CodeParam);
            var sep = payload.IndexOf('|');
            if (sep < 0) { _invalidLink = true; return; }
            _model.Email = payload[..sep];
            _model.Token = payload[(sep + 1)..];
        }
        catch
        {
            _invalidLink = true;
        }
    }

    private async Task HandleReset()
    {
        var user = await UserManager.FindByEmailAsync(_model!.Email);
        if (user is null)
        {
            _done = true; // don't reveal that user doesn't exist
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, _model!.Token, _model.Password);
        if (result.Succeeded)
        {
            await InviteService.StampSetupCompletedAsync(user);
            _done = true;
            return;
        }

        _error = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class ResetPasswordModel
    {
        public string Token { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Lösenord krävs.")]
        [System.ComponentModel.DataAnnotations.MinLength(12, ErrorMessage = "Lösenordet måste vara minst 12 tecken.")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Lösenorden matchar inte.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
