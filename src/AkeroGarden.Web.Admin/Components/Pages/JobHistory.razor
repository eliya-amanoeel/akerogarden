@* Job history (FR-114): one row per night, newest first — the jobs that ran that night, their
   combined outcome and what they did — and, in the side panel, each of that night's jobs with what
   it did, which is the audit entries it wrote (AuditLog.JobRunId). It listed one row per job run
   until 2026-10: four rows a night, ~730 over the six months kept, all loaded at once, and a failed
   job sat among three "Inget att göra" rows from the same night. Ten nights a page (AdminPager).

   Built from the parts the other admin lists use: .admin-filters and .admin-table as on /bokningar,
   AdminDataCard on narrow screens, the booking status badges for the outcome, AdminPanel for a row's
   detail as on /blockeringar, and a .card with a .card__head per job inside it, as the booking
   detail's action rail stacks its cards. *@
@page "/jobbhistorik"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Core.Data.Entities
@using AkeroGarden.Web.Core.Services
@inject JobHistoryService JobHistoryService
@inject Microsoft.Extensions.Options.IOptions<JobOptions> RunOptions
@attribute [Authorize(Roles = AdminRoles.Administrator)]

<PageTitle>Jobbhistorik — Åkerögården Admin</PageTitle>

<AdminHeader Title="Jobbhistorik" />

@* The hour is the runner's own setting (Jobs:DailyRunHourLocal, Swedish time), so the page cannot
   state a time the jobs no longer run at. *@
<p class="form-hint">De schemalagda jobben körs varje natt kl. @($"{RunOptions.Value.DailyRunHourLocal:00}:00"). Varje natt är en rad — klicka på den för att se vad varje jobb gjorde. Sök på referensnummer för att se om en viss bokning har fått sitt mejl.</p>

<div class="admin-filters">
    <div class="form-group">
        <label for="f-job">Jobb</label>
        <select id="f-job" @bind="_jobName" @bind:after="Load">
            <option value="">Alla</option>
            @foreach (var name in _jobNames)
            {
                <option value="@name">@name</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="f-result">Resultat</label>
        @* Bound to a string holding the enum's name and parsed on load, as /bokningar does its
           status — not to a bool: Blazor converts a bound bool only from a checkbox, so a select
           bound to one silently never filtered (caught by the E2E test, 2026-10-14). *@
        <select id="f-result" @bind="_result" @bind:after="Load">
            <option value="">Alla</option>
            @foreach (var r in Enum.GetValues<JobRunResult>())
            {
                <option value="@r">@BookingDisplay.JobRunResultLabel(r)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="f-date">Datum</label>
        <input id="f-date" type="date" @bind="_date" @bind:after="Load" />
    </div>
    <div class="form-group">
        <label for="f-ref">Referensnummer</label>
        <input id="f-ref" type="search" placeholder="t.ex. AG-2026-0042" @bind="_reference" @bind:after="Load" />
    </div>
    @* The browser's date field has no clear button, so a chosen date could only be removed by
       deleting it part by part. Shown only while a filter is active (same on /bokningar). *@
    @if (HasFilters)
    {
        <button type="button" class="btn-ghost btn-sm" @onclick="ClearFilters">Återställ filter</button>
    }
</div>

@if (_nights is null)
{
    <p class="admin-empty">Laddar…</p>
}
else if (_nights.Count == 0)
{
    <p class="admin-empty">Inga körningar matchar filtret.</p>
}
else
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Natt</th>
                    <th>Jobb</th>
                    <th>Resultat</th>
                    <th>Gjorde</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var night in _nights)
                {
                    <tr @onclick="() => OpenNight(night)">
                        <td class="mono">@Date(night)</td>
                        <td>@JobCount(night)</td>
                        <td><span class="@BookingDisplay.JobRunOutcomeBadgeClass(night.Outcome)">@BookingDisplay.JobRunOutcomeLabel(night.Outcome)</span></td>
                        <td>@Did(night)</td>
                        <td class="rowactions">
                            <button class="btn-ghost" @onclick="() => OpenNight(night)" @onclick:stopPropagation="true">Visa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="data-cards">
        @foreach (var night in _nights)
        {
            <AdminDataCard Title="@Date(night)" OnClick="() => OpenNight(night)">
                <Badge><span class="@BookingDisplay.JobRunOutcomeBadgeClass(night.Outcome)">@BookingDisplay.JobRunOutcomeLabel(night.Outcome)</span></Badge>
                <Sub>@JobCount(night)</Sub>
                <Fields>
                    <div><dt>Gjorde</dt><dd>@Did(night)</dd></div>
                </Fields>
            </AdminDataCard>
        }
    </div>
    <AdminPager Page="_page" TotalPages="_totalPages" OnPageChanged="GoToPage" />
}

@* A panel title is a name, never a date: it is set in the heading font, whose old-style figures
   make a date read unevenly (design.md; the Blockeringar panel was fixed for exactly this). The
   night's date goes in the kicker above it. *@
<AdminPanel Visible="_selected is not null" Title="Nattens jobb" OnClose="CloseNight">
    <Kicker>@(_selected is { } n ? Date(n) : null)</Kicker>
    <ChildContent>
        @if (_selected is { } night)
        {
            @foreach (var item in night.Runs)
            {
                <div class="card">
                    <div class="card__head">
                        <h2>@item.Run.JobName</h2>
                        <span class="@BookingDisplay.JobRunOutcomeBadgeClass(item.Run.Outcome)">@BookingDisplay.JobRunOutcomeLabel(item.Run.Outcome)</span>
                    </div>
                    <dl class="kv">
                        <dt>Startad</dt><dd>@Started(item.Run)</dd>
                        @if (item.Run.FailureReason is { } reason)
                        {
                            <dt>Orsak</dt><dd>@reason</dd>
                        }
                    </dl>

                    @if (_entries is null)
                    {
                        <p class="admin-empty">Laddar…</p>
                    }
                    else if (EntriesOf(item.Run) is { Count: 0 })
                    {
                        <p class="admin-empty">@(item.Run.Outcome == JobRunOutcome.Succeeded ? "Inget att göra den här natten." : "Inga händelser registrerades.")</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var entry in EntriesOf(item.Run))
                            {
                                <li>
                                    @* A deleted booking keeps its reference but has no page to link to —
                                       its entry is written without BookingId for exactly that reason. *@
                                    @if (entry.BookingId is { } bookingId)
                                    {
                                        <a href="/bokningar/@bookingId">@entry.BookingReferenceSnapshot</a>
                                    }
                                    else
                                    {
                                        <span class="mono">@entry.BookingReferenceSnapshot</span>
                                    }
                                    — @entry.Summary
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        }
    </ChildContent>
</AdminPanel>

@code {
    private List<JobNight>? _nights;
    private int _page = 1;
    private int _totalPages = 1;
    private List<string> _jobNames = [];
    private string _jobName = "";
    private string _result = "";
    private DateOnly? _date;
    private string _reference = "";
    private JobNight? _selected;
    private List<AuditLog>? _entries;

    protected override async Task OnInitializedAsync()
    {
        _jobNames = await JobHistoryService.GetJobNamesAsync();
        await Load();
    }

    // A changed filter starts again from the first page; the service keeps any page inside the
    // pages that exist.
    private Task Load() => GoToPage(1);

    private bool HasFilters =>
        _jobName != "" || _result != "" || _date is not null || !string.IsNullOrWhiteSpace(_reference);

    private Task ClearFilters()
    {
        _jobName = "";
        _result = "";
        _date = null;
        _reference = "";
        return Load();
    }

    private async Task GoToPage(int page)
    {
        JobRunResult? result = Enum.TryParse<JobRunResult>(_result, out var r) ? r : null;
        var nights = await JobHistoryService.GetNightsAsync(_jobName, _reference, result, _date, page);
        _nights = [.. nights.Nights];
        _page = nights.Page;
        _totalPages = nights.TotalPages;
    }

    private async Task OpenNight(JobNight night)
    {
        _selected = night;
        _entries = null;
        _entries = await JobHistoryService.GetEntriesAsync([.. night.Runs.Select(r => r.Run.Id)]);
    }

    private void CloseNight()
    {
        _selected = null;
        _entries = null;
    }

    private List<AuditLog> EntriesOf(JobRun run) =>
        _entries?.Where(e => e.JobRunId == run.Id).ToList() ?? [];

    private static string Date(JobNight night) => night.Date.ToString("yyyy-MM-dd");

    private static string Started(JobRun run) =>
        StockholmTime.ToLocal(run.StartedAt).ToString("yyyy-MM-dd HH:mm");

    private static string JobCount(JobNight night) => $"{night.Runs.Count} jobb";

    // "Inget att göra" only for a night whose jobs all finished cleanly — a run that stopped before
    // doing anything did not have nothing to do. A night with failures says how many, first.
    private static string Did(JobNight night)
    {
        var did = night.EntryCount switch
        {
            0 when night.Outcome == JobRunOutcome.Succeeded => "Inget att göra",
            0 => "—",
            1 => "1 händelse",
            var n => $"{n} händelser",
        };

        return night.NotSucceededCount == 0
            ? did
            : $"{night.NotSucceededCount} av {night.Runs.Count} misslyckades · {did}";
    }
}
