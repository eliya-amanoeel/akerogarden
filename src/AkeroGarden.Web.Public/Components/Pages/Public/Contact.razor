@page "/kontakt"
@layout MainLayout

<PageTitle>Kontakt — Åkerögården</PageTitle>
<SeoMeta Title="Kontakt och vägbeskrivning"
         Description="Kontaktuppgifter till Åkerögården samt vägbeskrivning med bil och kollektivtrafik till Åkerövägen 81 utanför Norrtälje."
         Path="/kontakt" />

<section class="page-head">
    <div class="container">
        <span class="eyebrow">Kontakt</span>
        <h1>Hör av dig</h1>
        <div class="page-head__rule"></div>
        <p class="page-head__intro">
            Har du frågor om en vistelse eller tillgänglighet? Hör av dig, så återkommer vi så
            snart vi kan.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        @* One column per question — "how do I reach you" beside "how do I get there" — rather than
           both stacked in one column with a decorative photo filling the other. The source order is
           also the mobile order: contact details first, then the photo, then the directions. A phone
           visitor on a contact page wants the phone number, and it used to sit below a full-width
           photo they had to scroll past. *@
        <div class="contact-grid">
            <div>
                <div class="contact-group">
                    <div class="contact-group__head"><h2>Kontakta oss</h2></div>
                    <dl class="contact-dl">
                        <dt>E-post</dt>
                        <dd><a href="mailto:info@akerogarden.se">info@akerogarden.se</a></dd>

                        @* tel: uses the full international form so the link works from abroad; the
                           visible text keeps the Swedish grouping a domestic visitor expects. *@
                        <dt>Telefon</dt>
                        <dd><a href="tel:+46760602035">076-060 20 35</a></dd>

                        <dt>Svarstid</dt>
                        <dd>Vi svarar oftast inom några dagar.</dd>
                    </dl>
                </div>

                @* 4:5 portrait on desktop (the client-approved crop), a wide band below it. The desktop
                   `sizes` is the width the photo is *drawn* at, not the frame's: a 3:2 photo covering a
                   4:5 frame is scaled by height, so it renders 1.875× the column width and would look soft
                   if the browser picked a file for the column alone (493px column at the 1200px container
                   → 924px drawn). *@
                <div class="contact-photo">
                    <img src="@Assets["images/kontakt-intro-1400.webp"]"
                         srcset="@Assets["images/kontakt-intro-800.webp"] 800w, @Assets["images/kontakt-intro-1400.webp"] 1400w, @Assets["images/kontakt-intro-2000.webp"] 2000w"
                         sizes="(min-width: 75em) 924px, (min-width: 64em) 76vw, 100vw"
                         width="1400" height="933"
                         loading="lazy"
                         alt="Grusvägen upp till huvudbyggnaden, med grässlänt och trappa" />
                </div>
            </div>

            <div>
                <div class="contact-group">
                    <div class="contact-group__head"><h2>Hitta hit</h2></div>

                    <FindMap MapsUrl="@MapsUrl" />

                    <dl class="contact-dl">
                        <dt>Adress</dt>
                        <dd>
                            @* Plain text, not a link: the map above is the way to a route, so a
                               second link to the same place was one target too many. What the
                               address is for here is reading and copying. *@
                            Åkerögården<br />Åkerövägen 81<br />761 94 Norrtälje
                        </dd>

                        <dt>Med bil</dt>
                        <dd>
                            @* "cirka 20 km" is the road distance from Norrtälje (19.3 km, measured over
                               the OSM road network); the straight line is only 14 km, so don't "correct"
                               it downwards. The sentence used to end "...väg 1031, som förbinder E18 med
                               Rådmanby", which is not true: 1031 ends at Rådmansövägen (AB 1032), 1.8 km
                               short of Rådmanby. Naming a destination the road never reaches helps nobody
                               — the turn-off and the direction are what a guest actually needs, and both
                               are drawn on the map above. *@
                            Åkerögården ligger mitt på Rådmansölandet, cirka 20 km öster om Norrtälje.
                            Infarten sker från väg 1031 (Åkerövägen), som går norrut från E18. Parkering
                            finns i anslutning till infarten.
                        </dd>

                        <dt>Med buss</dt>
                        <dd>
                            SL:s linje 631 trafikerar sträckan E18–Rådmanby. Hållplats
                            <em>Åkerögården</em> ligger alldeles intill gården. Se
                            <a href="https://sl.se" rel="noopener">sl.se</a> för aktuella tider.
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="cta-card">
            <h2>Vill du boka?</h2>
            <p>
                Skicka en bokningsförfrågan med ert sällskap och era datum. En förfrågan är
                inte bindande — vi bekräftar tillgänglighet.
            </p>
            <a href="/boka" class="btn">Skicka förfrågan</a>
        </div>
    </div>
</section>

@code {
    // Universal Google Maps search URL — no API key needed, works cross-platform (opens the
    // app on mobile, maps.google.com on desktop).
    private static readonly string MapsUrl =
        $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString("Åkerögården, Åkerövägen 81, 761 94 Norrtälje")}";
}
