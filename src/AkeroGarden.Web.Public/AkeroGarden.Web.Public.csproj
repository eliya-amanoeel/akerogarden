<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Publish a framework-dependent app that requests the baseline 10.0 patch and rolls
         *forward* to whatever runtime the App Service platform (DOTNETCORE|10.0) has installed,
         rather than baking in the build SDK's latest patch (which can't roll backward if the
         platform is behind). Locks the runtime-drift guard explicitly instead of relying on the
         framework-dependent default. See infra/operations.md. -->
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>akerogarden-web-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- App-host telemetry wiring lives with the host (Program.cs UseAzureMonitor), not Core.
         All data/service/EF/Identity/Redis/Blob/mail packages moved to AkeroGarden.Web.Core
         (Phase 10b Slice 1) and flow transitively through the project reference below. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkeroGarden.Web.Core\AkeroGarden.Web.Core.csproj" />
  </ItemGroup>

</Project>
