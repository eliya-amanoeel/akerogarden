@page "/matalternativ"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Core.Data.Entities
@inject MealOptionService MealOptionService
@attribute [Authorize(Roles = AdminRoles.Administrator)]

<PageTitle>Matalternativ — Åkerögården Admin</PageTitle>

<AdminHeader Title="Matalternativ" />

<p class="form-hint">Matalternativ som gäster kan välja i sitt bokningsformulär. Inaktivera i stället för att ta bort alternativ som används av bokningar.</p>

<Toast @bind-Message="_message" />

@if (_mealOptions is null)
{
    <p class="admin-empty">Laddar…</p>
}
else
{
    <div class="admin-toolbar">
        <button type="button" class="btn" @onclick="OpenCreate">+ Lägg till matalternativ</button>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="num">Ordning</th>
                    <th>Namn</th>
                    <th>Kost</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _mealOptions)
                {
                    <tr @onclick="() => OpenEdit(m)">
                        <td class="num mono">@m.DisplayOrder</td>
                        <td><span class="rowlink">@m.Name</span></td>
                        <td>@DietCell(m.Diet)</td>
                        <td>
                            @if (m.IsActive)
                            {
                                <span class="badge badge--approved">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge--neutral">Inaktiv</span>
                            }
                        </td>
                        <td class="rowactions">
                            <button class="btn-ghost" @onclick="() => OpenEdit(m)" @onclick:stopPropagation="true">Redigera</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-cards">
        @foreach (var m in _mealOptions)
        {
            <AdminDataCard Title="@m.Name" OnClick="() => OpenEdit(m)">
                <Badge>
                    @if (m.IsActive)
                    {
                        <span class="badge badge--approved">Aktiv</span>
                    }
                    else
                    {
                        <span class="badge badge--neutral">Inaktiv</span>
                    }
                </Badge>
                <Fields>
                    <div><dt>Ordning</dt><dd>@m.DisplayOrder</dd></div>
                    <div><dt>Kost</dt><dd>@DietCell(m.Diet)</dd></div>
                </Fields>
            </AdminDataCard>
        }
    </div>
}

<EditForm Model="_form" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <AdminPanel Visible="_panelOpen" Title="@(_isCreating ? "Nytt matalternativ" : (string.IsNullOrEmpty(_form.Name) ? "Namnlös" : _form.Name))" OnClose="ClosePanel">
        <ChildContent>
            <Toast @bind-Message="_panelError" />
            <div class="form-group">
                <label for="m-name">Namn</label>
                <InputText id="m-name" @bind-Value="_form.Name" />
                <ValidationMessage For="() => _form.Name" />
            </div>

            <div class="form-group">
                <label for="m-description">Beskrivning</label>
                <InputTextArea id="m-description" @bind-Value="_form.Description" />
                <ValidationMessage For="() => _form.Description" />
            </div>

            <div class="form-group">
                <label for="m-diet">Kost</label>
                <InputSelect id="m-diet" @bind-Value="_form.Diet">
                    @foreach (var diet in Enum.GetValues<DishDiet>())
                    {
                        <option value="@diet">@BookingDisplay.DishDietLabel(diet)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _form.Diet" />
            </div>

            <div class="form-group">
                <label for="m-order">Visningsordning</label>
                <InputNumber id="m-order" min="0" @bind-Value="_form.DisplayOrder" />
                <ValidationMessage For="() => _form.DisplayOrder" />
            </div>
        </ChildContent>
        <Footer>
            <button type="submit" class="btn">Spara</button>
            @if (!_isCreating)
            {
                <button type="button" class="btn-outline" @onclick="ToggleActive">@(CurrentIsActive ? "Inaktivera" : "Aktivera")</button>
                <button type="button" class="btn-outline btn-danger" @onclick="RequestDeleteCurrent">Ta bort</button>
            }
        </Footer>
    </AdminPanel>
</EditForm>

<ConfirmDialog Visible="_pendingDelete is not null"
               Title="Ta bort matalternativ"
               Message="@($"Vill du ta bort matalternativet \"{_pendingDelete?.Name}\"? Detta går inte att ångra.")"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

@code {
    private List<MealOption>? _mealOptions;
    private MealOption _form = new();
    private Guid? _editingId;
    private bool _isCreating;
    private bool _panelOpen;
    private ToastMessage? _message;
    private ToastMessage? _panelError;

    private bool CurrentIsActive => _editingId is not null && (_mealOptions?.FirstOrDefault(m => m.Id == _editingId)?.IsActive ?? false);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _mealOptions = await MealOptionService.GetAllAsync();

    // A dish with no diet shows a dash, so the column only draws the eye where there is a label.
    private static string DietCell(DishDiet diet) =>
        diet == DishDiet.None ? "–" : BookingDisplay.DishDietLabel(diet);

    private void OpenCreate()
    {
        _panelOpen = true;
        _isCreating = true;
        _editingId = null;
        _panelError = null;
        _form = new();
    }

    private void OpenEdit(MealOption m)
    {
        _panelOpen = true;
        _isCreating = false;
        _editingId = m.Id;
        _panelError = null;
        _form = new MealOption
        {
            Id = m.Id,
            Name = m.Name,
            Description = m.Description,
            Diet = m.Diet,
            DisplayOrder = m.DisplayOrder
        };
    }

    private void ClosePanel()
    {
        _panelOpen = false;
        _isCreating = false;
        _editingId = null;
        _panelError = null;
    }

    private async Task Save()
    {
        if (_isCreating)
        {
            await MealOptionService.CreateAsync(_form);
            _message = ToastMessage.Ok($"Matalternativet \"{_form.Name}\" har lagts till.");
        }
        else
        {
            await MealOptionService.UpdateAsync(_form);
            _message = ToastMessage.Ok($"Matalternativet \"{_form.Name}\" har uppdaterats.");
        }

        ClosePanel();
        await Load();
    }

    private async Task ToggleActive()
    {
        if (_editingId is null) return;
        var m = _mealOptions!.First(x => x.Id == _editingId);
        var next = !m.IsActive;
        await MealOptionService.SetActiveAsync(m.Id, next);
        _message = ToastMessage.Ok(next
            ? $"Matalternativet \"{m.Name}\" har aktiverats."
            : $"Matalternativet \"{m.Name}\" har inaktiverats.");
        ClosePanel();
        await Load();
    }

    private MealOption? _pendingDelete;

    private void RequestDeleteCurrent()
    {
        if (_editingId is not null)
            _pendingDelete = _mealOptions!.First(x => x.Id == _editingId);
    }

    private void CancelDelete() => _pendingDelete = null;

    private async Task ConfirmDelete()
    {
        if (_pendingDelete is null)
            return;

        var m = _pendingDelete;
        _pendingDelete = null;

        var result = await MealOptionService.TryHardDeleteAsync(m.Id);
        _message = result switch
        {
            HardDeleteResult.Deleted => ToastMessage.Ok($"Matalternativet \"{m.Name}\" har tagits bort."),
            HardDeleteResult.Blocked => ToastMessage.Error($"Matalternativet \"{m.Name}\" kan inte tas bort eftersom det används av en bokning. Inaktivera det i stället."),
            _ => ToastMessage.Error($"Matalternativet \"{m.Name}\" kunde inte hittas.")
        };
        ClosePanel();
        await Load();
    }
}
