{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Åkerögården (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AkeroGarden.Web/bin/Debug/net10.0/AkeroGarden.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/AkeroGarden.Web",
      "launchSettingsProfile": "https",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
