# Åkerögården — codifies existing conventions (4-space, file-scoped namespaces,
# Allman braces). Formatting + core only — no var/naming/expression-body opinions.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,bicep,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # trailing double-space = hard line break; must not be stripped

# EF Core-generated migrations — generated code, never formatted or linted (keeps the
# formatter from stripping EF's BOM / fighting future `dotnet ef migrations add` output).
[**/Migrations/*.cs]
generated_code = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
dotnet_diagnostic.IDE0055.severity = error   # "fix formatting" → build error (catches the DemoDataSeeder drift)
