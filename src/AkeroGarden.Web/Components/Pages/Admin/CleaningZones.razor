@page "/admin/stadszoner"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Data.Entities
@inject CleaningZoneService CleaningZoneService
@inject PhysicalBuildingService PhysicalBuildingService
@attribute [Authorize]

<PageTitle>Städzoner — Åkerögården Admin</PageTitle>

<AdminHeader Title="Städzoner" />

@if (!string.IsNullOrEmpty(_message))
{
    <p role="status" class="form-status">@_message</p>
}

@if (_zones is null)
{
    <p class="admin-empty">Laddar…</p>
}
else
{
    @* No total incl. VAT column — the system stores and computes no monetary totals (C8). *@
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="num">Ordning</th>
                    <th>Namn</th>
                    <th class="num">Belopp exkl. moms</th>
                    <th class="num">Momssats</th>
                    <th>Kategori</th>
                    <th>Fysisk byggnad</th>
                    <th>Typ</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var z in _zones)
                {
                    <tr>
                        <td class="num mono">@z.DisplayOrder</td>
                        <td><span class="rowlink">@z.Name</span></td>
                        <td class="num mono">@z.AmountExVat.ToString("0.00") kr</td>
                        <td class="num mono">@z.VatRate.ToString("0.##%")</td>
                        <td>@KindLabel(z.Kind)</td>
                        <td>@(z.PhysicalBuildingId is null ? "—" : PhysicalBuildingName(z.PhysicalBuildingId.Value))</td>
                        <td>@BundleText(z)</td>
                        <td>
                            @if (z.IsActive)
                            {
                                <span class="badge badge--approved">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge--neutral">Inaktiv</span>
                            }
                        </td>
                        <td class="rowactions">
                            <button class="btn-ghost" @onclick="() => Edit(z)">Redigera</button>
                            @if (z.IsActive)
                            {
                                <button class="btn-ghost" @onclick="() => SetActive(z, false)">Inaktivera</button>
                            }
                            else
                            {
                                <button class="btn-ghost" @onclick="() => SetActive(z, true)">Aktivera</button>
                            }
                            <button class="btn-ghost" @onclick="() => Delete(z)">Ta bort</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <section class="card admin-editcard">
    <h2>@(_editingId is null ? "Lägg till städzon" : "Redigera städzon")</h2>

    <EditForm Model="_form" OnValidSubmit="Save" FormName="cleaningZone">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="z-name">Namn</label>
            <InputText id="z-name" @bind-Value="_form.Name" />
            <ValidationMessage For="() => _form.Name" />
        </div>

        <div class="form-group">
            <label for="z-description">Beskrivning</label>
            <InputTextArea id="z-description" @bind-Value="_form.Description" />
            <ValidationMessage For="() => _form.Description" />
        </div>

        <div class="form-group">
            <label for="z-amount">Belopp exkl. moms (kr)</label>
            <InputNumber id="z-amount" min="0" @bind-Value="_form.AmountExVat" />
            <ValidationMessage For="() => _form.AmountExVat" />
        </div>

        <div class="form-group">
            <label for="z-vat">Momssats (andel, t.ex. 0.12 för 12 %)</label>
            <InputNumber id="z-vat" min="0" @bind-Value="_form.VatRate" step="0.01" />
            <ValidationMessage For="() => _form.VatRate" />
        </div>

        <div class="form-group">
            <label for="z-order">Visningsordning</label>
            <InputNumber id="z-order" min="0" @bind-Value="_form.DisplayOrder" />
            <ValidationMessage For="() => _form.DisplayOrder" />
        </div>

        <div class="form-group">
            <label for="z-kind">Kategori</label>
            <InputSelect id="z-kind" @bind-Value="_form.Kind">
                @foreach (var kind in Enum.GetValues<CleaningZoneKind>())
                {
                    <option value="@kind">@KindLabel(kind)</option>
                }
            </InputSelect>
            <p class="form-hint">Styr när zonen erbjuds på slutförandeformuläret och vilken städknapp den hör till (§8.11).</p>
        </div>

        @if (_form.Kind != CleaningZoneKind.Everything)
        {
            <div class="form-group">
                <label for="z-physical">Fysisk byggnad</label>
                <InputSelect id="z-physical" @bind-Value="_form.PhysicalBuildingId">
                    <option value="">Välj fysisk byggnad…</option>
                    @foreach (var pb in _physicalBuildings.Where(p => p.IsActive))
                    {
                        <option value="@pb.Id">@pb.Name</option>
                    }
                </InputSelect>
            </div>
        }

        <fieldset class="form-group">
            <legend>Bunt — inkluderade zoner (valfritt)</legend>
            <p>Kryssa i de zoner som denna zon paketerar (t.ex. Hela lägret). Lämna tomt för en vanlig zon.</p>
            @if (_bundleCandidates.Count == 0)
            {
                <p>Inga tillgängliga zoner att inkludera.</p>
            }
            else
            {
                @foreach (var candidate in _bundleCandidates)
                {
                    <label>
                        <input type="checkbox"
                               checked="@_form.IncludesZoneIds.Contains(candidate.Id)"
                               @onchange="e => ToggleInclude(candidate.Id, (bool)e.Value!)" />
                        @candidate.Name
                    </label>
                    <br />
                }
            }
        </fieldset>

        <button type="submit" class="btn">Spara</button>
        @if (_editingId is not null)
        {
            <button type="button" class="btn-ghost" @onclick="New">Avbryt</button>
        }
    </EditForm>
    </section>
}

@code {
    private List<CleaningZone>? _zones;
    private List<PhysicalBuilding> _physicalBuildings = [];
    private CleaningZone _form = new();
    private Guid? _editingId;
    private string? _message;

    // Zones eligible to be included in a bundle: active, not the zone being edited,
    // and not themselves bundles (no nested bundles).
    private List<CleaningZone> _bundleCandidates = [];

    protected override async Task OnInitializedAsync()
    {
        _physicalBuildings = await PhysicalBuildingService.GetAllAsync();
        await Load();
    }

    private async Task Load()
    {
        _zones = await CleaningZoneService.GetAllAsync();
        RefreshCandidates();
    }

    private string PhysicalBuildingName(Guid physicalBuildingId) =>
        _physicalBuildings.FirstOrDefault(p => p.Id == physicalBuildingId)?.Name ?? "—";

    private static string KindLabel(CleaningZoneKind kind) => kind switch
    {
        CleaningZoneKind.MainBuilding => "Huvudbyggnad",
        CleaningZoneKind.SleepingBuilding => "Sovbyggnad",
        CleaningZoneKind.Conference => "Konferens",
        CleaningZoneKind.Everything => "Hela lägret (bunt)",
        _ => kind.ToString()
    };

    private void RefreshCandidates()
    {
        _bundleCandidates = (_zones ?? [])
            .Where(z => z.IsActive
                        && z.Id != _editingId
                        && z.IncludesZoneIds.Count == 0)
            .OrderBy(z => z.DisplayOrder)
            .ThenBy(z => z.Name)
            .ToList();
    }

    private static string BundleText(CleaningZone z) =>
        z.IncludesZoneIds.Count > 0 ? $"Bunt ({z.IncludesZoneIds.Count} zoner)" : "Enskild";

    private void ToggleInclude(Guid id, bool selected)
    {
        if (selected)
        {
            if (!_form.IncludesZoneIds.Contains(id)) _form.IncludesZoneIds.Add(id);
        }
        else
        {
            _form.IncludesZoneIds.Remove(id);
        }
    }

    private void New()
    {
        _editingId = null;
        _form = new();
        RefreshCandidates();
    }

    private void Edit(CleaningZone z)
    {
        _editingId = z.Id;
        _form = new CleaningZone
        {
            Id = z.Id,
            Name = z.Name,
            Description = z.Description,
            AmountExVat = z.AmountExVat,
            VatRate = z.VatRate,
            Kind = z.Kind,
            PhysicalBuildingId = z.PhysicalBuildingId,
            IncludesZoneIds = [.. z.IncludesZoneIds],
            DisplayOrder = z.DisplayOrder
        };
        RefreshCandidates();
    }

    private async Task Save()
    {
        var result = _editingId is null
            ? await CleaningZoneService.TryCreateAsync(_form)
            : await CleaningZoneService.TryUpdateAsync(_form);

        if (!result.Succeeded)
        {
            _message = result.Error;
            return;
        }

        _message = _editingId is null
            ? $"Städzonen \"{_form.Name}\" har lagts till."
            : $"Städzonen \"{_form.Name}\" har uppdaterats.";

        New();
        await Load();
    }

    private async Task SetActive(CleaningZone z, bool isActive)
    {
        await CleaningZoneService.SetActiveAsync(z.Id, isActive);
        _message = isActive
            ? $"Städzonen \"{z.Name}\" har aktiverats."
            : $"Städzonen \"{z.Name}\" har inaktiverats.";
        await Load();
    }

    private async Task Delete(CleaningZone z)
    {
        var result = await CleaningZoneService.TryHardDeleteAsync(z.Id);
        _message = result switch
        {
            HardDeleteResult.Deleted => $"Städzonen \"{z.Name}\" har tagits bort.",
            HardDeleteResult.Blocked => $"Städzonen \"{z.Name}\" kan inte tas bort eftersom den används av en bokning. Inaktivera den i stället.",
            _ => $"Städzonen \"{z.Name}\" kunde inte hittas."
        };
        await Load();
    }
}
