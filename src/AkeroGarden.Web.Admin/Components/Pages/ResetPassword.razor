@page "/aterstall-losenord"
@layout AdminLoginLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.DataProtection
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IDataProtectionProvider DataProtectionProvider
@inject AdminInviteService InviteService

<PageTitle>Återställ lösenord — Åkerögården Admin</PageTitle>

<div class="login-card">
    <div class="login-card__logo">
        <Logo Variant="LogoVariant.OnLight" />
    </div>

    <h1>@(_collectProfile ? "Aktivera ditt konto" : "Återställ lösenord")</h1>

    @if (_done)
    {
        <p>@(_collectProfile ? "Ditt konto är aktiverat." : "Lösenordet har återställts.") Du kan nu logga in.</p>
        <a href="/login" class="btn">Logga in</a>
    }
    else if (_invalidLink)
    {
        <p class="form-error">Länken är ogiltig eller har gått ut. Begär en ny återställningslänk.</p>
        <a href="/glomt-losenord" class="btn-outline">Ny återställningslänk</a>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleReset" FormName="reset-password" method="post">
            <DataAnnotationsValidator />

            <input type="hidden" name="_model.Token" value="@_model!.Token" />
            <input type="hidden" name="_model.Email" value="@_model!.Email" />

            @if (_collectProfile)
            {
                <div class="form-group">
                    <label for="firstName">Förnamn</label>
                    <InputText id="firstName" @bind-Value="_model.FirstName" autocomplete="given-name" />
                    <ValidationMessage For="() => _model.FirstName" />
                </div>

                <div class="form-group">
                    <label for="lastName">Efternamn</label>
                    <InputText id="lastName" @bind-Value="_model.LastName" autocomplete="family-name" />
                    <ValidationMessage For="() => _model.LastName" />
                </div>

                <div class="form-group">
                    <label for="phone">Telefonnummer</label>
                    <InputText id="phone" @bind-Value="_model.Phone" type="tel" autocomplete="tel" />
                    <ValidationMessage For="() => _model.Phone" />
                </div>
            }

            <div class="form-group">
                <label for="password">Nytt lösenord</label>
                <InputText id="password" @bind-Value="_model.Password" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="form-group">
                <label for="confirm">Bekräfta lösenord</label>
                <InputText id="confirm" @bind-Value="_model.ConfirmPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _model.ConfirmPassword" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            <button type="submit" class="btn">@(_collectProfile ? "Aktivera konto" : "Spara nytt lösenord")</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    private string? CodeParam { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordModel? _model { get; set; }

    private bool _done;
    private bool _invalidLink;
    private string? _error;
    // True for a never-activated invite (SetupCompletedAt == null) — the invitee sets their own
    // name + phone here (FR-74, §6.4). A normal password reset by an activated admin skips these.
    private bool _collectProfile;

    protected override async Task OnInitializedAsync()
    {
        _model ??= new();

        if (string.IsNullOrEmpty(CodeParam))
        {
            _invalidLink = true;
            return;
        }

        try
        {
            var protector = DataProtectionProvider.CreateProtector("PasswordReset");
            var payload = protector.Unprotect(CodeParam);
            var sep = payload.IndexOf('|');
            if (sep < 0) { _invalidLink = true; return; }
            _model.Email = payload[..sep];
            _model.Token = payload[(sep + 1)..];
        }
        catch
        {
            _invalidLink = true;
            return;
        }

        // Show the profile fields only for a pending invite's first-time activation.
        var user = await UserManager.FindByEmailAsync(_model.Email);
        _collectProfile = user is { SetupCompletedAt: null };
    }

    private async Task HandleReset()
    {
        var user = await UserManager.FindByEmailAsync(_model!.Email);
        if (user is null)
        {
            _done = true; // don't reveal that user doesn't exist
            return;
        }

        // Profile fields are required for first-time activation (all three — §6.4). Validated here
        // rather than via attributes because they must not block a normal password reset.
        var collectProfile = user.SetupCompletedAt is null;
        if (collectProfile &&
            (string.IsNullOrWhiteSpace(_model.FirstName)
             || string.IsNullOrWhiteSpace(_model.LastName)
             || string.IsNullOrWhiteSpace(_model.Phone)))
        {
            _collectProfile = true;
            _error = "Förnamn, efternamn och telefonnummer krävs.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, _model!.Token, _model.Password);
        if (result.Succeeded)
        {
            if (collectProfile)
                await InviteService.CompleteActivationAsync(user, _model.FirstName!, _model.LastName!, _model.Phone!);
            else
                await InviteService.StampSetupCompletedAsync(user);
            _collectProfile = collectProfile;
            _done = true;
            return;
        }

        _collectProfile = collectProfile;
        _error = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class ResetPasswordModel
    {
        public string Token { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;

        // Nullable + no [Required]: required only for first-time activation, enforced in HandleReset
        // so a normal password reset is not blocked by empty profile fields.
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Phone { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Lösenord krävs.")]
        [System.ComponentModel.DataAnnotations.MinLength(12, ErrorMessage = "Lösenordet måste vara minst 12 tecken.")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Lösenorden matchar inte.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
