@inherits LayoutComponentBase

@* Public pages are Static SSR with plain progressive-enhancement JS and full-page form posts.
   Blazor's enhanced navigation (in-place page swaps) would prevent those inline scripts from
   running and interfere with post-submit re-renders, so it's disabled for the whole public
   subtree — every public navigation is a normal full page load. (Admin uses AdminLayout and is
   unaffected.) *@
<div data-enhance-nav="false">
    <Header />

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__grid">
                <div>
                    <p class="site-footer__brand">Åkerögården</p>
                    <p>Retreatcenter på landsbygden i Norrtälje kommun, Sverige.</p>
                    <p><a href="mailto:info@akerogarden.se">info@akerogarden.se</a></p>
                </div>
                <nav aria-label="Utforska">
                    <h2>Utforska</h2>
                    <ul>
                        <li><a href="/om-oss">Om oss</a></li>
                        <li><a href="/faciliteter">Faciliteter</a></li>
                        <li><a href="/meny">Meny</a></li>
                        <li><a href="/priser">Priser</a></li>
                    </ul>
                </nav>
                <nav aria-label="Boka">
                    <h2>Boka</h2>
                    <ul>
                        <li><a href="/kalender">Tillgänglighet</a></li>
                        <li><a href="/boka">Skicka förfrågan</a></li>
                        <li><a href="/kontakt">Kontakt</a></li>
                    </ul>
                </nav>
                <nav aria-label="Om sidan">
                    <h2>Om sidan</h2>
                    <ul>
                        <li><a href="/integritetspolicy">Integritetspolicy</a></li>
                    </ul>
                </nav>
            </div>
            <div class="site-footer__bar">
                <span>&copy; @DateTime.Now.Year Åkerögården</span>
                <span>Retreat &amp; konferens sedan 1978</span>
            </div>
        </div>
    </footer>
</div>
