@* Reusable admin save/action toast (the .form-status pattern used across every reference-data
   page). Two-way bound so a page only changes <p role="status" class="form-status">@_message</p>
   to <Toast @bind-Message="_message" /> — no other code changes needed. Auto-dismisses after 5s:
   previously the toast had no way to disappear on its own and could linger from a stale action,
   sitting on top of later UI (this is what caused the Byggnader panel/toast z-index bug). *@
@implements IDisposable

@if (Message is { } toast && !string.IsNullOrEmpty(toast.Text))
{
    @* role="alert" for a failure so a screen reader announces it immediately rather than waiting
       for a pause — matching the urgency the colour now carries visually. *@
    <p role="@(toast.IsError ? "alert" : "status")"
       class="form-status@(toast.IsError ? " form-status--error" : "")">
        @toast.Text
        @if (toast.IsError)
        {
            @* An error does not auto-dismiss, so it needs a way out. Without one this fixed
               bottom-right box would sit over the page indefinitely — the same lingering-toast
               problem the 5s timeout was introduced to solve (the Byggnader panel z-index bug). *@
            <button type="button" class="form-status__close" @onclick="Dismiss"
                    aria-label="Stäng meddelandet">×</button>
        }
    </p>
}

@code {
    private static readonly TimeSpan Duration = TimeSpan.FromSeconds(5);

    [Parameter] public ToastMessage? Message { get; set; }
    [Parameter] public EventCallback<ToastMessage?> MessageChanged { get; set; }

    private ToastMessage? _shownMessage;
    private CancellationTokenSource? _cts;

    protected override async Task OnParametersSetAsync()
    {
        if (Message == _shownMessage)
            return;

        _shownMessage = Message;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;

        if (Message is null || string.IsNullOrEmpty(Message.Text))
            return;

        // An error stays until the next action replaces it. A failed action leaves nothing else
        // behind on the page, so a toast that clears itself after five seconds can leave the admin
        // believing the action went through (reported 2026-08-10). Successes still auto-dismiss —
        // there the page itself already shows the result.
        if (Message.IsError)
            return;

        var cts = new CancellationTokenSource();
        _cts = cts;

        try
        {
            await Task.Delay(Duration, cts.Token);
            _shownMessage = null;
            await MessageChanged.InvokeAsync(null);
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer message (or the component was torn down) before the timeout elapsed.
        }
    }

    private async Task Dismiss()
    {
        _shownMessage = null;
        await MessageChanged.InvokeAsync(null);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
