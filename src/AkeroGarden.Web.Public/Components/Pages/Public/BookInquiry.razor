@page "/boka"
@layout MainLayout
@using AkeroGarden.Web.Core.Data.Entities
@using AkeroGarden.Web.Core.Models
@using AkeroGarden.Web.Core.Services
@inject BookingService BookingService
@inject FacilityService FacilityService
@inject AvailabilityService Availability
@inject TimeProvider Clock
@inject IInquiryRateLimiter RateLimiter
@inject ILogger<BookInquiry> Logger

<PageTitle>Skicka förfrågan — Åkerögården</PageTitle>
<SeoMeta Title="Skicka bokningsförfrågan"
         Description="Skicka en förfrågan med era datum och ert sällskap. Förfrågan är inte bindande — vi återkommer med besked om tillgänglighet."
         Path="/boka" />

@if (_submitted)
{
    <section class="section">
        <div class="container">
            <div class="tack">
                <div class="tack__badge" aria-hidden="true">✓</div>
                <h1>Tack!</h1>
                <p>@_confirmation</p>
                <div class="submit-row submit-row--center">
                    <a class="btn" href="/">Till startsidan</a>
                    <a class="btn-ghost" href="/faciliteter">Se faciliteter</a>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="page-head">
        <div class="container">
            <span class="eyebrow">Boka eller kontakta oss</span>
            <h1>Skicka en förfrågan</h1>
            <div class="page-head__rule"></div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            @if (_rateLimited)
            {
                <p class="form-error" role="alert">Du har skickat för många förfrågningar. Försök igen om en stund.</p>
            }

            <div class="alert alert--info reassure">
                <span class="alert__ic" aria-hidden="true">i</span>
                <div><b>En förfrågan är inte bindande.</b> Den blir en bokning först när vi har bekräftat den — du förbinder dig inte till något genom att skicka den.</div>
            </div>

            @* CSS-only two-track toggle (Static SSR-safe). After a failed post the server re-checks
               the track whose form was submitted, so validation errors stay visible. *@
            <input class="track-radio" type="radio" name="__track" id="track-stay" checked="@(!_generalActive)" />
            <input class="track-radio" type="radio" name="__track" id="track-general" checked="@_generalActive" />

            @* Radio-driven segmented toggle: the hidden radios above carry the semantics/keyboard
               behaviour, so no explicit tablist role is needed (and role=tablist would require
               role=tab children). *@
            <div class="segmented">
                <label class="segmented__btn" for="track-stay">Boka en vistelse</label>
                <label class="segmented__btn" for="track-general">Ställ en fråga</label>
            </div>

            <!-- ── Stay request ─────────────────────────────────────────── -->
            <div class="track track--stay">
                <EditForm Model="StayModel" OnValidSubmit="HandleStayRequest" FormName="stayrequest" method="post">
                    <DataAnnotationsValidator />

                    <div class="form-section">
                        <h2>Kontaktuppgifter</h2>
                        <div class="form-group">
                            <label for="s-name">Namn</label>
                            <InputText id="s-name" @bind-Value="StayModel!.ContactName" />
                            <ValidationMessage For="() => StayModel!.ContactName" />
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="s-email">E-postadress</label>
                                @* type=text + inputmode=email: keeps the mobile e-mail keyboard but lets our
                                   server-side [EmailAddress] message be the single source of truth (native
                                   type=email would block the post and suppress our styled message). *@
                                <InputText id="s-email" type="text" inputmode="email" @bind-Value="StayModel!.ContactEmail" />
                                <ValidationMessage For="() => StayModel!.ContactEmail" />
                            </div>
                            <div class="form-group">
                                @* Confirm-email safeguard (Phase 7): guards a mistyped-but-well-formed address
                                   that would otherwise bounce silently. Paste is not blocked — the server
                                   re-checks the match regardless. *@
                                <label for="s-email-confirm">Bekräfta e-postadress</label>
                                <InputText id="s-email-confirm" type="text" inputmode="email" @bind-Value="StayModel!.ConfirmEmail" />
                                <ValidationMessage For="() => StayModel!.ConfirmEmail" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="s-phone">Telefon <span class="field-opt">(valfritt)</span></label>
                            <InputText id="s-phone" @bind-Value="StayModel!.ContactPhone" />
                            <ValidationMessage For="() => StayModel!.ContactPhone" />
                        </div>
                    </div>

                    <div class="form-section">
                        <h2>Er vistelse</h2>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="s-checkin">Incheckning@(_checkInPrefilled ? (MarkupString)"<span class=\"prefill\">Från kalender</span>" : default)</label>
                                @* min: the native picker's only lever over which dates it offers — it
                                   cannot grey out individual days, so occupied dates are caught by the
                                   server on post instead (HandleStayRequest) and echoed below. *@
                                <InputDate id="s-checkin" min="@_earliestSelectable" @bind-Value="StayModel!.CheckIn" />
                                <ValidationMessage For="() => StayModel!.CheckIn" />
                            </div>
                            <div class="form-group">
                                <label for="s-checkout">Utcheckning@(_checkOutPrefilled ? (MarkupString)"<span class=\"prefill\">Från kalender</span>" : default)</label>
                                <InputDate id="s-checkout" min="@_earliestSelectable" @bind-Value="StayModel!.CheckOut" />
                                <ValidationMessage For="() => StayModel!.CheckOut" />
                            </div>
                        </div>

                        @if (_dateError is not null)
                        {
                            <p class="form-error" role="alert">
                                @_dateError
                                <a href="/kalender">Se lediga datum i kalendern</a>
                            </p>
                        }

                        @* Stated arrival/departure times (FR-100, §2.8). A fixed dropdown, not a free
                           text or a native time field: the point of collecting these was to stop
                           getting "någon gång på eftermiddagen", so the control must not accept a
                           value we cannot use. Pre-filled with the standard times, so the ordinary
                           case is left alone. *@
                        <div class="form-row">
                            <div class="form-group">
                                <label for="s-checkin-time">Ungefärlig ankomsttid</label>
                                <InputSelect id="s-checkin-time" @bind-Value="StayModel!.CheckInTime">
                                    @foreach (var t in StatedTimePolicy.Options())
                                    {
                                        <option value="@StatedTimePolicy.Display(t)">@StatedTimePolicy.Display(t)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="form-group">
                                <label for="s-checkout-time">Ungefärlig avresetid</label>
                                <InputSelect id="s-checkout-time" @bind-Value="StayModel!.CheckOutTime">
                                    @foreach (var t in StatedTimePolicy.Options())
                                    {
                                        <option value="@StatedTimePolicy.Display(t)">@StatedTimePolicy.Display(t)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <p class="form-hint">Standard är incheckning @StatedTimePolicy.Display(MealOccasionResolver.StandardCheckInTime) och utcheckning @StatedTimePolicy.Display(MealOccasionResolver.StandardCheckOutTime). Behöver ni komma tidigare eller åka senare anger ni det här — vi hör av oss om det går att ordna.</p>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="s-guests">Antal gäster (övernattning)</label>
                                <InputNumber id="s-guests" min="1" @bind-Value="StayModel!.OvernightGuestCount" />
                                <ValidationMessage For="() => StayModel!.OvernightGuestCount" />
                            </div>
                            <div class="form-group">
                                <label for="mealplan">Måltidsplan</label>
                                <InputSelect id="mealplan" @bind-Value="StayModel!.MealPlan">
                                    <option value="">Välj…</option>
                                    <option value="@MealPlan.FullBoardAll">Helpension för alla</option>
                                    <option value="@MealPlan.SelfCateringAll">Självhushåll för alla</option>
                                </InputSelect>
                                <ValidationMessage For="() => StayModel!.MealPlan" />
                            </div>
                        </div>
                        @* Day guests don't apply to self-catering (§4.2); hidden by JS, dropped server-side. *@
                        <div class="form-group" id="dayguests-group">
                            <label for="s-dayguests">Antal dagsgäster <span class="field-opt">(valfritt)</span></label>
                            <InputNumber id="s-dayguests" min="0" @bind-Value="StayModel!.DayGuestCount" />
                            <ValidationMessage For="() => StayModel!.DayGuestCount" />
                            <p class="form-hint">Dagsgäster gäller bara vid helpension.</p>
                        </div>
                    </div>

                    @if (_facilities.Count > 0)
                    {
                        <div class="form-section">
                            <h2>Tillval <span class="field-opt field-opt--heading">(valfritt)</span></h2>
                            <p class="sec-note">Kan väljas nu eller bekräftas senare.</p>

                            <fieldset class="form-group">
                                <legend>Faciliteter</legend>
                                @foreach (var f in _facilities)
                                {
                                    <label class="checkbox-row">
                                        <input type="checkbox" name="StayModel.SelectedFacilityIds" value="@f.Id"
                                               checked="@(StayModel!.SelectedFacilityIds?.Contains(f.Id) ?? false)" />
                                        @f.Name
                                    </label>
                                }
                            </fieldset>
                        </div>
                    }

                    <div class="form-section">
                        <h2>Organisation <span class="field-opt field-opt--heading">(valfritt)</span></h2>
                        <div class="form-group form-group--checkbox">
                            <label>
                                <InputCheckbox id="s-isorg" @bind-Value="StayModel!.IsOrganisation" />
                                Bokningen görs för en organisation
                            </label>
                        </div>
                        <div class="reveal-panel" id="org-fields">
                            <div class="form-group">
                                <label for="s-orgname">Organisationsnamn</label>
                                <InputText id="s-orgname" @bind-Value="StayModel!.OrgName" />
                                <ValidationMessage For="() => StayModel!.OrgName" />
                            </div>
                            <div class="form-group">
                                <label for="s-orgnumber">Organisationsnummer <span class="field-opt">(valfritt)</span></label>
                                <InputText id="s-orgnumber" @bind-Value="StayModel!.OrgNumber" />
                            </div>
                            <div class="form-group">
                                <label for="s-invoice">Fakturaadress <span class="field-opt">(valfritt)</span></label>
                                <InputTextArea id="s-invoice" @bind-Value="StayModel!.InvoiceAddress" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h2>Meddelande <span class="field-opt field-opt--heading">(valfritt)</span></h2>
                        <div class="form-group">
                            <label for="s-message">Berätta gärna mer om ert sällskap</label>
                            <InputTextArea id="s-message" @bind-Value="StayModel!.Message" />
                            <ValidationMessage For="() => StayModel!.Message" />
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-group form-group--checkbox">
                            @* One combined acknowledgement rather than a second checkbox (C1,
                               decided 2026-08-17). The booking terms carry the 20% deposit and the
                               two-month cancellation rule, so they have to be accepted before the
                               booking becomes binding — but a second control is friction on the
                               funnel, and one box covering both documents costs nothing versus what
                               was here before. The general-inquiry track below keeps its
                               privacy-only box: a question is not a booking. *@
                            @* The text is one <span>, not bare nodes: .form-group--checkbox label is
                               display:flex, so every text node and <a> would otherwise become its own
                               flex item on a non-wrapping row. With one link that squeezed; with two
                               it broke outright. One span = two flex items (box + text), and the
                               sentence wraps inside the span as prose, aligned to the first line. *@
                            <label>
                                <InputCheckbox @bind-Value="StayModel!.AcceptTerms" />
                                <span>
                                    Jag godkänner <a href="/integritetspolicy" target="_blank">integritetspolicyn</a>
                                    och <a href="/bokningsvillkor" target="_blank">bokningsvillkoren</a>
                                </span>
                            </label>
                            <ValidationMessage For="() => StayModel!.AcceptTerms" />
                        </div>
                    </div>

                    <div class="submit-row">
                        <button type="submit" class="btn">Skicka bokningsförfrågan</button>
                        <span class="form-hint form-hint--flush">Vi svarar oftast inom några dagar.</span>
                    </div>
                </EditForm>
            </div>

            <!-- ── General inquiry ──────────────────────────────────────── -->
            <div class="track track--general">
                <EditForm Model="GeneralModel" OnValidSubmit="HandleGeneralInquiry" FormName="generalinquiry" method="post">
                    <DataAnnotationsValidator />

                    <div class="form-section">
                        <p class="sec-note">Har du en fråga? Skicka ett meddelande så återkommer vi.</p>
                        <div class="form-group">
                            <label for="g-name">Namn</label>
                            <InputText id="g-name" @bind-Value="GeneralModel!.ContactName" />
                            <ValidationMessage For="() => GeneralModel!.ContactName" />
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="g-email">E-postadress</label>
                                <InputText id="g-email" type="text" inputmode="email" @bind-Value="GeneralModel!.ContactEmail" />
                                <ValidationMessage For="() => GeneralModel!.ContactEmail" />
                            </div>
                            <div class="form-group">
                                @* Confirm-email safeguard (Phase 7) — see the stay-request form above. *@
                                <label for="g-email-confirm">Bekräfta e-postadress</label>
                                <InputText id="g-email-confirm" type="text" inputmode="email" @bind-Value="GeneralModel!.ConfirmEmail" />
                                <ValidationMessage For="() => GeneralModel!.ConfirmEmail" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="g-phone">Telefon <span class="field-opt">(valfritt)</span></label>
                            <InputText id="g-phone" @bind-Value="GeneralModel!.ContactPhone" />
                            <ValidationMessage For="() => GeneralModel!.ContactPhone" />
                        </div>
                        <div class="form-group">
                            <label for="g-message">Meddelande</label>
                            <InputTextArea id="g-message" @bind-Value="GeneralModel!.Message" />
                            <ValidationMessage For="() => GeneralModel!.Message" />
                        </div>
                        <div class="form-group form-group--checkbox">
                            <label>
                                <InputCheckbox @bind-Value="GeneralModel!.AcceptPrivacyPolicy" />
                                @* Same single-span structure as the stay track above — this label has
                                   only one link, so it merely squeezed rather than broke, but the
                                   trap is identical and it should not be left waiting for the next
                                   person to add a second link. *@
                                <span>Jag godkänner <a href="/integritetspolicy" target="_blank">integritetspolicyn</a></span>
                            </label>
                            <ValidationMessage For="() => GeneralModel!.AcceptPrivacyPolicy" />
                        </div>
                    </div>

                    <div class="submit-row">
                        <button type="submit" class="btn">Skicka meddelande</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </section>
}

@* Progressive enhancement only — the server re-applies both rules regardless (InquiryNormalizer). *@
@* Fingerprinted via @Assets, like site.css and blazor.web.js — not a raw /js path. A raw path is
   cached by the browser, so a returning guest can run an older copy of this file after a deploy.
   For a validation script that means a stale gate that silently stops matching a renamed field
   while still looking like it works. *@
<script src="@Assets["js/inquiry-form.js"]"></script>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "stayrequest")]
    private StayRequestInput? StayModel { get; set; }

    [SupplyParameterFromForm(FormName = "generalinquiry")]
    private GeneralInquiryInput? GeneralModel { get; set; }

    [SupplyParameterFromQuery(Name = "incheckning")]
    private string? CheckInParam { get; set; }

    [SupplyParameterFromQuery(Name = "utcheckning")]
    private string? CheckOutParam { get; set; }

    private List<Facility> _facilities = [];

    private bool _submitted;
    private string? _confirmation;
    private bool _rateLimited;
    private string? _dateError;

    // Floor for the native date pickers. `min` is the only control the browser gives us over which
    // dates a native picker offers — individual days cannot be disabled — so it keeps the obvious
    // mistake (a date in the past) out of the picker, while the server re-checks both the past date
    // and occupancy on post: `min` is a convenience, never the rule (FR-113).
    private DateOnly _today => StockholmTime.Today(Clock);

    private string _earliestSelectable => _today.ToString("yyyy-MM-dd");

    // Which track to show. Derived from which form actually posted: on a general-inquiry post the
    // general model is bound (non-null) and the stay model is not, so the general tab stays open
    // (and its validation errors visible) on the re-render. Defaults to the stay request.
    private bool _generalActive;
    private bool _checkInPrefilled;
    private bool _checkOutPrefilled;

    protected override async Task OnInitializedAsync()
    {
        _generalActive = GeneralModel is not null && StayModel is null;

        // Re-new any model the current post did not bind, so both forms always render
        // (avoids the BL0008 null-overwrite trap on a failed-validation re-render).
        StayModel ??= new();
        GeneralModel ??= new();

        // Pre-select the standard times (§2.8) so the ordinary case is one fewer decision. Only when
        // nothing was posted — a re-render after failed validation must keep what the guest chose.
        StayModel.CheckInTime ??= StatedTimePolicy.Display(MealOccasionResolver.StandardCheckInTime);
        StayModel.CheckOutTime ??= StatedTimePolicy.Display(MealOccasionResolver.StandardCheckOutTime);

        _facilities = await FacilityService.GetActiveAsync();

        // Pre-fill dates from a calendar date-range selection (FR-11). Dates are not personal
        // data, so passing them in the query string is fine (NFR-05).
        if (DateOnly.TryParse(CheckInParam, out var checkIn))
        {
            StayModel.CheckIn ??= checkIn;
            _checkInPrefilled = true;
        }
        if (DateOnly.TryParse(CheckOutParam, out var checkOut))
        {
            StayModel.CheckOut ??= checkOut;
            _checkOutPrefilled = true;
        }
    }

    private async Task HandleStayRequest()
    {
        if (!await AllowedByRateLimitAsync()) return;

        // Availability is re-checked server-side on every post, never trusted from the calendar the
        // guest came from: the page may be hours old, the dates may have been typed straight into
        // the fields, and a post can arrive without ever having rendered the calendar at all
        // (FR-113). The calendar is a display; this is the gate.
        if (StayModel!.CheckIn is { } checkIn && StayModel.CheckOut is { } checkOut)
        {
            // A date in the past is refused before occupancy is consulted: nothing holds it, so the
            // availability check would call it free and wave it through.
            if (AvailabilityService.DescribePastDate(checkIn, _today) is { } pastDate)
            {
                _dateError = pastDate;
                return;
            }

            var availability = await Availability.EvaluateStayAsync(checkIn, checkOut);
            if (!availability.IsAvailable)
            {
                _dateError = AvailabilityService.Describe(availability);
                return;
            }
        }

        await BookingService.CreateStayRequestAsync(StayModel!);
        _submitted = true;
        _confirmation = "Vi har tagit emot din bokningsförfrågan och skickat en bekräftelse till din e-post. "
            + "Vi återkommer med besked så snart vi kan — vanligtvis inom några dagar.";
    }

    private async Task HandleGeneralInquiry()
    {
        if (!await AllowedByRateLimitAsync()) return;
        await BookingService.CreateGeneralInquiryAsync(GeneralModel!);
        _submitted = true;
        _confirmation = "Vi har tagit emot ditt meddelande och skickat en bekräftelse till din e-post. "
            + "Vi återkommer så snart vi kan.";
    }

    // NFR-04: rate-limit per client IP. Fails open (allows) if Redis is unreachable, so an
    // infrastructure hiccup never blocks a legitimate booking — the outage is logged instead.
    private async Task<bool> AllowedByRateLimitAsync()
    {
        var clientId = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";
        try
        {
            if (await RateLimiter.TryAcquireAsync(clientId))
                return true;
            _rateLimited = true;
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Rate limiter unavailable; allowing inquiry submission (fail-open)");
            return true;
        }
    }
}
