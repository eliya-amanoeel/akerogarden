@page "/glomt-losenord"
@layout AdminLoginLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.DataProtection
@inject UserManager<ApplicationUser> UserManager
@inject IEmailService EmailService
@inject NavigationManager Nav
@inject IDataProtectionProvider DataProtectionProvider

<PageTitle>Glömt lösenord — Åkerögården Admin</PageTitle>

<div class="login-card">
    <div class="login-card__logo">
        <Logo Variant="LogoVariant.Stacked" />
    </div>

    <h1>Glömt lösenordet?</h1>

    @if (_sent)
    {
        <p>Om e-postadressen finns i systemet har ett återställningsmail skickats.</p>
        <a href="/login" class="btn">Tillbaka till inloggning</a>
    }
    else
    {
        <p>Ange din e-postadress så skickar vi en länk för att återställa lösenordet.</p>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="forgot-password" method="post">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">E-postadress</label>
                <InputText id="email" @bind-Value="_model!.Email" type="email" autocomplete="email" />
                <ValidationMessage For="() => _model!.Email" />
            </div>

            <button type="submit" class="btn">Skicka återställningslänk</button>
            <a href="/login" class="btn-ghost">Avbryt</a>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordModel? _model { get; set; }

    private bool _sent;

    protected override void OnInitialized() => _model ??= new();

    private async Task HandleSubmit()
    {
        var user = await UserManager.FindByEmailAsync(_model!.Email);

        // Always show success to avoid user enumeration (NFR-05 spirit).
        _sent = true;

        if (user is null || !user.IsActive)
            return;

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var protector = DataProtectionProvider.CreateProtector("PasswordReset");
        var code = Uri.EscapeDataString(protector.Protect($"{user.Email}|{token}"));
        var resetUrl = Nav.ToAbsoluteUri($"/aterstall-losenord?code={code}");

        await EmailService.SendAsync(
            user.Email!,
            user.UserName ?? user.Email!,
            "Återställ ditt lösenord — Åkerögården",
            $"<p>Klicka på länken nedan för att återställa ditt lösenord. Länken är giltig i 1 timme.</p>" +
            // Descriptive text rather than the raw URL: the token makes it ~400 characters of
            // gibberish. Same convention as the invite email and every booking email.
            $"<p><a href=\"{System.Net.WebUtility.HtmlEncode(resetUrl.ToString())}\">Återställ ditt lösenord</a></p>");
    }

    private sealed class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-postadress krävs.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Ange en giltig e-postadress.")]
        public string Email { get; set; } = string.Empty;
    }
}
