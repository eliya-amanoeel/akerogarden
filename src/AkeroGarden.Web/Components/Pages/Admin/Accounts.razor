@page "/admin/konton"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject AdminInviteService InviteService
@attribute [Authorize]

<PageTitle>Administratörskonton — Åkerögården Admin</PageTitle>

<AdminHeader Title="Administratörskonton" />

@if (_users is null)
{
    <p class="admin-empty">Laddar…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <p role="status" class="form-status">@_message</p>
    }

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>E-postadress</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr>
                        <td><span class="rowlink">@user.Email</span>@if (user.Id == _currentUserId) {<span class="chip" style="margin-left:0.5rem">Du</span>}</td>
                        <td>
                            @if (user.SetupCompletedAt is null)
                            {
                                <span class="badge badge--pending">Väntar på aktivering</span>
                            }
                            else if (user.IsActive)
                            {
                                <span class="badge badge--approved">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge--neutral">Inaktiv</span>
                            }
                        </td>
                        <td class="rowactions">
                            @if (user.SetupCompletedAt is null)
                            {
                                <button class="btn-ghost" @onclick="() => ResendInvite(user)">Skicka ny inbjudan</button>
                                <button class="btn-ghost" @onclick="() => RequestRemoveInvite(user)">Ta bort</button>
                            }
                            else if (user.Id != _currentUserId)
                            {
                                @if (user.IsActive)
                                {
                                    <button class="btn-ghost" @onclick="() => Deactivate(user)">Inaktivera</button>
                                }
                                else
                                {
                                    <button class="btn-ghost" @onclick="() => Activate(user)">Aktivera</button>
                                }
                            }
                            else
                            {
                                <span class="admin-empty">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <section class="card admin-editcard">
    <h2>Bjud in ny administratör</h2>

    <EditForm Model="_invite" OnValidSubmit="SendInvite" FormName="invite">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="invite-email">E-postadress</label>
            <InputText id="invite-email" @bind-Value="_invite.Email" type="email" />
            <ValidationMessage For="() => _invite.Email" />
        </div>

        <button type="submit" class="btn">Skicka inbjudan</button>
    </EditForm>
    </section>
}

<ConfirmDialog Visible="_pendingRemove is not null"
               Title="Ta bort inbjudan"
               Message="@($"Vill du ta bort inbjudan för {_pendingRemove?.Email}? Detta går inte att ångra.")"
               OnConfirm="ConfirmRemoveInvite"
               OnCancel="CancelRemoveInvite" />

@code {
    private List<ApplicationUser>? _users;
    private string? _currentUserId;
    private string? _message;
    private InviteModel _invite = new();

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _currentUserId = UserManager.GetUserId(auth.User);
        _users = UserManager.Users.OrderBy(u => u.Email).ToList();
    }

    private async Task Deactivate(ApplicationUser user)
    {
        user.IsActive = false;
        await UserManager.UpdateAsync(user);
        _message = $"{user.Email} har inaktiverats.";
    }

    private async Task Activate(ApplicationUser user)
    {
        user.IsActive = true;
        await UserManager.UpdateAsync(user);
        _message = $"{user.Email} har aktiverats.";
    }

    private async Task SendInvite()
    {
        var result = await InviteService.InviteAsync(_invite.Email);

        _message = result.Outcome switch
        {
            InviteOutcome.BlockedActivated => "Det finns redan ett konto med den e-postadressen.",
            InviteOutcome.CreateFailed => result.Error,
            _ => $"Inbjudan skickad till {_invite.Email}."
        };

        if (result.Outcome != InviteOutcome.CreateFailed)
        {
            _invite = new();
            _users = UserManager.Users.OrderBy(u => u.Email).ToList();
        }
    }

    private async Task ResendInvite(ApplicationUser user)
    {
        await InviteService.ResendInviteAsync(user);
        _message = $"Ny inbjudan skickad till {user.Email}.";
    }

    private ApplicationUser? _pendingRemove;

    private void RequestRemoveInvite(ApplicationUser user) => _pendingRemove = user;

    private void CancelRemoveInvite() => _pendingRemove = null;

    private async Task ConfirmRemoveInvite()
    {
        if (_pendingRemove is null)
            return;

        var user = _pendingRemove;
        _pendingRemove = null;

        var result = await InviteService.RemoveInviteAsync(user.Id);

        _message = result switch
        {
            HardDeleteResult.Deleted => $"Inbjudan för {user.Email} har tagits bort.",
            HardDeleteResult.Blocked => "Inbjudan kunde inte tas bort — kontot har redan aktiverats.",
            _ => "Inbjudan kunde inte tas bort — kontot hittades inte."
        };

        _users = UserManager.Users.OrderBy(u => u.Email).ToList();
    }

    private sealed class InviteModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-postadress krävs.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Ange en giltig e-postadress.")]
        public string Email { get; set; } = string.Empty;
    }
}
