@inherits LayoutComponentBase
@inject NavigationManager Nav

@* Public pages are Static SSR with plain progressive-enhancement JS and full-page form posts.
   Blazor's enhanced navigation (in-place page swaps) would prevent those inline scripts from
   running and interfere with post-submit re-renders, so it's disabled for the whole public
   subtree — every public navigation is a normal full page load. (Admin uses AdminLayout and is
   unaffected.) *@
<div data-enhance-nav="false" class="@(ShowMobileCta ? "has-mobile-cta" : null)">
    <Header />

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__grid">
                <div>
                    <p class="site-footer__brand">Åkerögården</p>
                    <p>Retreatcenter på landsbygden i Norrtälje kommun, Sverige.</p>
                    <p><a href="mailto:info@akerogarden.se">info@akerogarden.se</a></p>
                </div>
                <nav aria-label="Utforska">
                    <h2>Utforska</h2>
                    <ul>
                        <li><a href="/om-oss">Om oss</a></li>
                        <li><a href="/faciliteter">Faciliteter</a></li>
                        <li><a href="/mat-och-priser">Mat &amp; priser</a></li>
                    </ul>
                </nav>
                <nav aria-label="Boka">
                    <h2>Boka</h2>
                    <ul>
                        <li><a href="/kalender">Tillgänglighet</a></li>
                        <li><a href="/boka">Skicka förfrågan</a></li>
                        <li><a href="/kontakt">Kontakt</a></li>
                    </ul>
                </nav>
                <nav aria-label="Om sidan">
                    <h2>Om sidan</h2>
                    <ul>
                        <li><a href="/integritetspolicy">Integritetspolicy</a></li>
                    </ul>
                </nav>
            </div>
            <div class="site-footer__bar">
                <span>&copy; @DateTime.Now.Year Åkerögården</span>
                <span>Retreat &amp; konferens sedan 1978</span>
            </div>
        </div>
    </footer>

    @* Phone-only docked call to action. On a phone the header CTA is hidden inside the
       hamburger panel and the hero CTA sits below the fold, so a visitor could see a screen
       with no way to book at all. Last in the DOM so it never disturbs reading order. *@
    @if (ShowMobileCta)
    {
        <div class="mobile-cta">
            <a href="/boka" class="btn">Skicka förfrågan</a>
        </div>
    }
</div>

@code {
    // Suppressed where a docked CTA would be wrong: on the form itself, on the calendar (which
    // docks its own selection bar and would collide), on the guest completion flow (an approved
    // booking, not a new inquiry), and on the error page.
    private static readonly string[] SuppressedPrefixes =
    [
        "/boka",
        "/kalender",
        "/slutfor",
        "/error",
    ];

    private bool ShowMobileCta
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return !SuppressedPrefixes.Any(p =>
                path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
        }
    }
}
