@page "/admin/priser"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Data.Entities
@inject PriceRuleService PriceRuleService
@attribute [Authorize]

<PageTitle>Priser — Åkerögården Admin</PageTitle>

<AdminHeader Title="Priser" />

<p class="form-hint">Prisregler med referenspris (exkl. moms) per pristyp. Referensdata — inga totalsummor beräknas eller lagras.</p>

<Toast @bind-Message="_message" />

@if (_priceRules is null)
{
    <p class="admin-empty">Laddar…</p>
}
else
{
    <div class="admin-toolbar">
        <button type="button" class="btn" @onclick="OpenCreate">+ Lägg till pris</button>
    </div>

    @* No total incl. VAT column — the system stores and computes no monetary totals (C8). *@
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Etikett</th>
                    <th class="num">Belopp exkl. moms</th>
                    <th class="num">Momssats</th>
                    <th>Enhet</th>
                    <th>Säsong</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _priceRules)
                {
                    <tr @onclick="() => OpenEdit(p)">
                        <td><span class="rowlink">@p.Label</span></td>
                        <td class="num mono">@p.AmountExVat.ToString("0.00") kr</td>
                        <td class="num mono">@p.VatRate.ToString("0.##%")</td>
                        <td>@p.Unit</td>
                        <td>@SeasonText(p)</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge badge--approved">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge--neutral">Inaktiv</span>
                            }
                        </td>
                        <td class="rowactions">
                            <button class="btn-ghost" @onclick="() => OpenEdit(p)" @onclick:stopPropagation="true">Redigera</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-cards">
        @foreach (var p in _priceRules)
        {
            <AdminDataCard Title="@p.Label" OnClick="() => OpenEdit(p)">
                <Badge>
                    @if (p.IsActive)
                    {
                        <span class="badge badge--approved">Aktiv</span>
                    }
                    else
                    {
                        <span class="badge badge--neutral">Inaktiv</span>
                    }
                </Badge>
                <Fields>
                    <div><dt>Belopp exkl. moms</dt><dd>@p.AmountExVat.ToString("0.00") kr</dd></div>
                    <div><dt>Momssats</dt><dd>@p.VatRate.ToString("0.##%")</dd></div>
                    <div><dt>Enhet</dt><dd>@p.Unit</dd></div>
                    <div><dt>Säsong</dt><dd>@SeasonText(p)</dd></div>
                </Fields>
            </AdminDataCard>
        }
    </div>
}

<EditForm Model="_form" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <AdminPanel Visible="_panelOpen" Title="@(_isCreating ? "Nytt pris" : (string.IsNullOrEmpty(_form.Label) ? "Namnlös" : _form.Label))" OnClose="ClosePanel">
        <ChildContent>
            <Toast @bind-Message="_panelError" />
            <div class="form-group">
                <label for="p-label">Etikett</label>
                <InputText id="p-label" @bind-Value="_form.Label" />
                <ValidationMessage For="() => _form.Label" />
            </div>

            <div class="form-group">
                <label for="p-amount">Belopp exkl. moms (kr)</label>
                <InputNumber id="p-amount" min="0" @bind-Value="_form.AmountExVat" />
                <ValidationMessage For="() => _form.AmountExVat" />
            </div>

            <div class="form-group">
                <label for="p-vat">Momssats (andel, t.ex. 0.12 för 12 %)</label>
                <InputNumber id="p-vat" min="0" @bind-Value="_form.VatRate" step="0.01" />
                <ValidationMessage For="() => _form.VatRate" />
            </div>

            <div class="form-group">
                <label for="p-unit">Enhet</label>
                <InputText id="p-unit" @bind-Value="_form.Unit" placeholder="t.ex. per person och natt" />
                <ValidationMessage For="() => _form.Unit" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="p-season-start">Säsong från (valfritt)</label>
                    <InputDate id="p-season-start" @bind-Value="_form.SeasonStart" />
                    <ValidationMessage For="() => _form.SeasonStart" />
                </div>

                <div class="form-group">
                    <label for="p-season-end">Säsong till (valfritt)</label>
                    <InputDate id="p-season-end" @bind-Value="_form.SeasonEnd" />
                    <ValidationMessage For="() => _form.SeasonEnd" />
                </div>
            </div>

            <div class="form-group">
                <label for="p-notes">Anteckningar</label>
                <InputTextArea id="p-notes" @bind-Value="_form.Notes" />
                <ValidationMessage For="() => _form.Notes" />
            </div>
        </ChildContent>
        <Footer>
            <button type="submit" class="btn">Spara</button>
            @if (!_isCreating)
            {
                <button type="button" class="btn-outline" @onclick="ToggleActive">@(CurrentIsActive ? "Inaktivera" : "Aktivera")</button>
                <button type="button" class="btn-outline btn-danger" @onclick="RequestDeleteCurrent">Ta bort</button>
            }
        </Footer>
    </AdminPanel>
</EditForm>

<ConfirmDialog Visible="_pendingDelete is not null"
               Title="Ta bort pris"
               Message="@($"Vill du ta bort priset \"{_pendingDelete?.Label}\"? Detta går inte att ångra.")"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

@code {
    private List<PriceRule>? _priceRules;
    private PriceRule _form = new();
    private Guid? _editingId;
    private bool _isCreating;
    private bool _panelOpen;
    private string? _message;
    private string? _panelError;

    private bool CurrentIsActive => _editingId is not null && (_priceRules?.FirstOrDefault(p => p.Id == _editingId)?.IsActive ?? false);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _priceRules = await PriceRuleService.GetAllAsync();

    private static string SeasonText(PriceRule p)
    {
        if (p.SeasonStart is null && p.SeasonEnd is null) return "Hela året";
        return $"{p.SeasonStart?.ToString("yyyy-MM-dd") ?? "—"} – {p.SeasonEnd?.ToString("yyyy-MM-dd") ?? "—"}";
    }

    private void OpenCreate()
    {
        _panelOpen = true;
        _isCreating = true;
        _editingId = null;
        _panelError = null;
        _form = new();
    }

    private void OpenEdit(PriceRule p)
    {
        _panelOpen = true;
        _isCreating = false;
        _editingId = p.Id;
        _panelError = null;
        _form = new PriceRule
        {
            Id = p.Id,
            Label = p.Label,
            AmountExVat = p.AmountExVat,
            VatRate = p.VatRate,
            Unit = p.Unit,
            SeasonStart = p.SeasonStart,
            SeasonEnd = p.SeasonEnd,
            Notes = p.Notes
        };
    }

    private void ClosePanel()
    {
        _panelOpen = false;
        _isCreating = false;
        _editingId = null;
        _panelError = null;
    }

    private async Task Save()
    {
        if (_isCreating)
        {
            await PriceRuleService.CreateAsync(_form);
            _message = $"Priset \"{_form.Label}\" har lagts till.";
        }
        else
        {
            await PriceRuleService.UpdateAsync(_form);
            _message = $"Priset \"{_form.Label}\" har uppdaterats.";
        }

        ClosePanel();
        await Load();
    }

    private async Task ToggleActive()
    {
        if (_editingId is null) return;
        var p = _priceRules!.First(x => x.Id == _editingId);
        var next = !p.IsActive;
        await PriceRuleService.SetActiveAsync(p.Id, next);
        _message = next
            ? $"Priset \"{p.Label}\" har aktiverats."
            : $"Priset \"{p.Label}\" har inaktiverats.";
        ClosePanel();
        await Load();
    }

    private PriceRule? _pendingDelete;

    private void RequestDeleteCurrent()
    {
        if (_editingId is not null)
            _pendingDelete = _priceRules!.First(x => x.Id == _editingId);
    }

    private void CancelDelete() => _pendingDelete = null;

    private async Task ConfirmDelete()
    {
        if (_pendingDelete is null)
            return;

        var p = _pendingDelete;
        _pendingDelete = null;

        await PriceRuleService.DeleteAsync(p.Id);
        _message = $"Priset \"{p.Label}\" har tagits bort.";
        ClosePanel();
        await Load();
    }
}
