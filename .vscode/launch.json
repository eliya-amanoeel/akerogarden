{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Admin (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AkeroGarden.Web.Admin/bin/Debug/net10.0/AkeroGarden.Web.Admin.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/AkeroGarden.Web.Admin",
      "launchSettingsProfile": "https",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Public (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AkeroGarden.Web.Public/bin/Debug/net10.0/AkeroGarden.Web.Public.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/AkeroGarden.Web.Public",
      "launchSettingsProfile": "https",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Both apps (Admin + Public)",
      "configurations": ["Admin (Development)", "Public (Development)"]
    }
  ]
}
