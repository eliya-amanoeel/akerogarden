@page "/bokningar/ny"
@layout AdminLayout
@rendermode InteractiveServer
@using AkeroGarden.Web.Core.Data.Entities
@using AkeroGarden.Web.Core.Models
@using AkeroGarden.Web.Core.Services
@inject BookingService BookingService
@inject FacilityService FacilityService
@inject NavigationManager Nav
@inject IAuditActorAccessor ActorAccessor
@inject Microsoft.Extensions.Options.IOptions<BookingEmailOptions> EmailOptions
@attribute [Authorize(Roles = AdminRoles.Administrator)]

<PageTitle>Skapa bokning — Åkerögården Admin</PageTitle>

<AdminHeader>
    <TitleContent><span class="crumb"><a href="/bokningar">Bokningar</a> / Skapa bokning</span></TitleContent>
</AdminHeader>

<div class="admin-detail-head"><h1>Skapa bokning</h1></div>
<p class="form-hint">Skapas för gästens räkning. Inga automatiska e-postmeddelanden skickas.</p>

@* FR-111's residue, closed as a process control rather than in code (Phase 11 completion gate,
   2026-09-09). A booking entered here sends the guest nothing until it is approved, so the terms and
   the privacy policy reach them later than they would from the public form. The case is prevented by
   the admin asking first — but a control that lives only in the handover manual is not present at the
   moment it is needed, which is while the admin is on the telephone looking at THIS page. *@
<div class="alert alert--info alert--stacked">
    <div><b>Fråga gästen först:</b> har de en e-postadress som de läser, och skulle de kunna öppna ett
    bekräftelsemejl och fylla i ett formulär?</div>
    <div><b>Ja</b> — be dem hellre fylla i <a href="@PublicBookingUrl" target="_blank" rel="noopener">formuläret på webbplatsen</a>.
    Då får de bokningsvillkoren och integritetspolicyn direkt, innan bokningen görs.</div>
    <div><b>Nej</b> — fortsätt här, kryssa i rutan om gästen saknar e-post, och gå igenom
    bokningsvillkoren i telefon.</div>
</div>

<section class="card admin-editcard">
<div class="form-group">
    <label for="type">Typ</label>
    <select id="type" @bind="_type">
        <option value="@BookingType.StayRequest">Bokningsförfrågan</option>
        <option value="@BookingType.GeneralInquiry">Allmän förfrågan</option>
    </select>
</div>

@if (_type == BookingType.StayRequest)
{
    <EditForm Model="_stay" OnValidSubmit="CreateStay">
        <DataAnnotationsValidator />

        <div class="form-group"><label for="mb-name">Namn</label><InputText id="mb-name" @bind-Value="_stay.ContactName" /><ValidationMessage For="() => _stay.ContactName" /></div>
        @* Admin transcribes on the guest's behalf, so there is no double-entry confirm field here
           (that safeguard is guest-facing). Mirror ContactEmail → ConfirmEmail so the shared model's
           confirm-match rule is satisfied without burdening the admin. *@
        <div class="form-group"><label for="mb-email">E-post</label><InputText id="mb-email" @bind-Value="_stay.ContactEmail" @bind-Value:after="() => _stay.ConfirmEmail = _stay.ContactEmail" /><ValidationMessage For="() => _stay.ContactEmail" /></div>

        @* On-behalf-of (FR-112). Some groups book entirely by telephone and have no email at all —
           the form cannot be submitted without one, so without this the admin would invent an address.
           Ticking this fills in the admin's own, records who is handling it, and records that the
           terms were gone through verbally. *@
        <div class="form-group form-group--checkbox">
            <label>
                <InputCheckbox @bind-Value="_onBehalfOf" @bind-Value:after="ApplyOnBehalfOf" />
                Gästen har ingen e-post — jag sköter bokningen åt dem
            </label>
        </div>
        @if (_onBehalfOf)
        {
            <div class="note">
                <p>
                    Bekräftelsen och länken för att fylla i deltagare skickas till <b>@_adminEmail</b>,
                    och länken visas även på bokningens sida. Namn, telefon och eventuell organisation
                    ovan ska vara <b>gästens</b> — bara e-postadressen är din.
                </p>
                <p>
                    Genom att kryssa i rutan intygar du att du gått igenom
                    <b>bokningsvillkoren</b> med gästen per telefon.
                </p>
            </div>
        }
        <div class="form-group"><label for="mb-phone">Telefon</label><InputText id="mb-phone" @bind-Value="_stay.ContactPhone" /><ValidationMessage For="() => _stay.ContactPhone" /></div>

        <div class="form-row">
            <div class="form-group"><label for="mb-checkin">Incheckning</label><InputDate id="mb-checkin" @bind-Value="_stay.CheckIn" /><ValidationMessage For="() => _stay.CheckIn" /></div>
            <div class="form-group"><label for="mb-checkout">Utcheckning</label><InputDate id="mb-checkout" @bind-Value="_stay.CheckOut" /><ValidationMessage For="() => _stay.CheckOut" /></div>
        </div>

        @* Stated arrival/departure times (FR-100, §2.8) — a request the admin may adjust later,
           never priced or approved by the system. Same fixed choices as the public form. *@
        <div class="form-row">
            <div class="form-group">
                <label for="mb-checkin-time">Ankomsttid</label>
                <InputSelect id="mb-checkin-time" @bind-Value="_stay.CheckInTime">
                    @foreach (var t in StatedTimePolicy.Options())
                    {
                        <option value="@StatedTimePolicy.Display(t)">@StatedTimePolicy.Display(t)</option>
                    }
                </InputSelect>
            </div>
            <div class="form-group">
                <label for="mb-checkout-time">Avresetid</label>
                <InputSelect id="mb-checkout-time" @bind-Value="_stay.CheckOutTime">
                    @foreach (var t in StatedTimePolicy.Options())
                    {
                        <option value="@StatedTimePolicy.Display(t)">@StatedTimePolicy.Display(t)</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-group"><label for="mb-guests">Antal gäster (övernattning)</label><InputNumber id="mb-guests" min="1" @bind-Value="_stay.OvernightGuestCount" /><ValidationMessage For="() => _stay.OvernightGuestCount" /></div>

        <div class="form-group">
            <label for="mb-mealplan">Måltidsplan</label>
            <InputSelect id="mb-mealplan" @bind-Value="_stay.MealPlan">
                <option value="">Välj...</option>
                <option value="@MealPlan.FullBoardAll">Helpension för alla</option>
                <option value="@MealPlan.SelfCateringAll">Självhushåll för alla</option>
            </InputSelect>
            <ValidationMessage For="() => _stay.MealPlan" />
        </div>

        @if (InquiryNormalizer.DayGuestsApplicable(_stay.MealPlan))
        {
            <div class="form-group"><label for="mb-dayguests">Antal dagsgäster</label><InputNumber id="mb-dayguests" min="0" @bind-Value="_stay.DayGuestCount" /></div>
        }

        @if (_facilities.Count > 0)
        {
            <fieldset class="form-group">
                <legend>Faciliteter</legend>
                @foreach (var f in _facilities)
                {
                    <label class="checkbox-row">
                        <input type="checkbox" checked="@_selectedFacilities.Contains(f.Id)"
                               @onchange="e => Toggle(_selectedFacilities, f.Id, e)" />
                        @f.Name
                    </label>
                }
            </fieldset>
        }

        <div class="form-group"><label><InputCheckbox @bind-Value="_stay.IsOrganisation" /> Organisation</label></div>
        <div class="form-group"><label for="mb-orgname">Organisationsnamn</label><InputText id="mb-orgname" @bind-Value="_stay.OrgName" /></div>
        <div class="form-group"><label for="mb-orgnumber">Organisationsnummer</label><InputText id="mb-orgnumber" @bind-Value="_stay.OrgNumber" /></div>
        <div class="form-group"><label for="mb-invoice">Fakturaadress</label><InputTextArea id="mb-invoice" @bind-Value="_stay.InvoiceAddress" /></div>
        <div class="form-group"><label for="mb-message">Meddelande</label><InputTextArea id="mb-message" @bind-Value="_stay.Message" /></div>

        <button type="submit" class="btn">Skapa bokning</button>
    </EditForm>
}
else
{
    <EditForm Model="_general" OnValidSubmit="CreateGeneral">
        <DataAnnotationsValidator />
        <div class="form-group"><label for="mg-name">Namn</label><InputText id="mg-name" @bind-Value="_general.ContactName" /><ValidationMessage For="() => _general.ContactName" /></div>
        <div class="form-group"><label for="mg-email">E-post</label><InputText id="mg-email" @bind-Value="_general.ContactEmail" @bind-Value:after="() => _general.ConfirmEmail = _general.ContactEmail" /><ValidationMessage For="() => _general.ContactEmail" /></div>
        <div class="form-group"><label for="mg-phone">Telefon</label><InputText id="mg-phone" @bind-Value="_general.ContactPhone" /><ValidationMessage For="() => _general.ContactPhone" /></div>
        <div class="form-group"><label for="mg-message">Meddelande</label><InputTextArea id="mg-message" @bind-Value="_general.Message" /><ValidationMessage For="() => _general.Message" /></div>
        <button type="submit" class="btn">Skapa förfrågan</button>
    </EditForm>
}
</section>

@code {
    private BookingType _type = BookingType.StayRequest;
    // Admin creates on the guest's behalf (FR-47) — the guest privacy-consent gate does not apply
    // and there is no consent checkbox on this form, so pre-satisfy it or validation would block
    // the submit with no visible error.
    private StayRequestInput _stay = new() { AcceptTerms = true };
    private GeneralInquiryInput _general = new() { AcceptPrivacyPolicy = true };
    private readonly HashSet<Guid> _selectedFacilities = [];
    private List<Facility> _facilities = [];

    // On-behalf-of (FR-112): the signed-in admin, resolved once. Reuses the audit actor accessor
    // rather than re-reading the auth state — it already resolves the admin's id, email and name from
    // the circuit, and this needs exactly the same three things.
    private bool _onBehalfOf;
    private Guid? _adminId;
    private string? _adminEmail;
    /// <summary>The public booking form, per environment — hardcoding the production URL here
    /// would have pointed staging's admin at the live site.</summary>
    private string PublicBookingUrl =>
        $"{EmailOptions.Value.PublicBaseUrl.TrimEnd('/')}/boka";

    private string? _guestEmailBeforeOnBehalfOf;

    protected override async Task OnInitializedAsync()
    {
        _facilities = await FacilityService.GetActiveAsync();

        var actor = await ActorAccessor.GetCurrentAsync();
        _adminId = actor.UserId;
        _adminEmail = actor.Email;
    }

    /// <summary>
    /// Swaps the contact email to the admin's when the box is ticked, and puts back whatever was
    /// typed when it is unticked — so a mis-click does not silently discard a guest address the admin
    /// had already entered.
    /// </summary>
    private void ApplyOnBehalfOf()
    {
        if (_onBehalfOf)
        {
            _guestEmailBeforeOnBehalfOf = _stay.ContactEmail;
            _stay.ContactEmail = _adminEmail ?? string.Empty;
        }
        else
        {
            _stay.ContactEmail = _guestEmailBeforeOnBehalfOf ?? string.Empty;
        }

        // The shared input model cross-checks the confirmation field; keep it consistent.
        _stay.ConfirmEmail = _stay.ContactEmail;
    }

    private static void Toggle(HashSet<Guid> set, Guid id, ChangeEventArgs e)
    {
        if (e.Value is true) set.Add(id); else set.Remove(id);
    }

    private async Task CreateStay()
    {
        _stay.SelectedFacilityIds = _selectedFacilities.ToList();
        var booking = await BookingService.CreateStayRequestAsync(
            _stay, createdByAdmin: true, onBehalfOfAdminId: _onBehalfOf ? _adminId : null);
        Nav.NavigateTo($"/bokningar/{booking.Id}");
    }

    private async Task CreateGeneral()
    {
        var booking = await BookingService.CreateGeneralInquiryAsync(_general, createdByAdmin: true);
        Nav.NavigateTo($"/bokningar/{booking.Id}");
    }
}
