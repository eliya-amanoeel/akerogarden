@inherits LayoutComponentBase
@attribute [Authorize]

<div class="admin-shell">
    <nav class="admin-nav">
        <div class="admin-nav__logo">
            <Logo Variant="LogoVariant.OnDark" />
        </div>
        <ul>
            <li><a href="/admin">Översikt</a></li>
            <li><a href="/admin/bokningar">Bokningar</a></li>
            <li><a href="/admin/byggnader">Byggnader &amp; rum</a></li>
            <li><a href="/admin/matalternativ">Matalternativ</a></li>
            <li><a href="/admin/faciliteter">Faciliteter</a></li>
            <li><a href="/admin/priser">Priser</a></li>
            <li><a href="/admin/stadszoner">Städzoner</a></li>
            <li><a href="/admin/konton">Administratörskonton</a></li>
        </ul>
        <div class="admin-nav__footer">
            @* Real form POST to the /logout endpoint — signing out from the interactive
               circuit cannot clear the auth cookie (response already sent). *@
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button class="btn-ghost" type="submit">Logga ut</button>
            </form>
        </div>
    </nav>

    <div class="admin-content">
        <main>
            @Body
        </main>
    </div>
</div>
